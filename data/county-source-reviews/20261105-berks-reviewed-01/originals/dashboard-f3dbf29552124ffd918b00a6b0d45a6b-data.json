{"version":"5.1.0","authoringApp":"ArcGIS Dashboards","authoringAppVersion":"5.1.0+259753e880","maxPaginationRecords":50000,"maxChartRecords":10000,"timeZone":"system","theme":{"id":"user","type":"resource"},"numberPrefixOverrides":[{"key":"yotta","symbol":"Y","enabled":true},{"key":"zeta","symbol":"Z","enabled":true},{"key":"exa","symbol":"E","enabled":true},{"key":"peta","symbol":"P","enabled":true},{"key":"tera","symbol":"T","enabled":true},{"key":"giga","symbol":"G","enabled":false},{"key":"mega","symbol":"M","enabled":true},{"key":"kilo","symbol":"k","enabled":true},{"key":"base","symbol":"","enabled":true},{"key":"deci","symbol":"d","enabled":false},{"key":"centi","symbol":"c","enabled":false},{"key":"milli","symbol":"m","enabled":false},{"key":"micro","symbol":"µ","enabled":false},{"key":"nano","symbol":"n","enabled":false}],"desktopView":{"layout":{"type":"dockingLayout","rootElement":{"width":1.0000000000000009,"height":1,"type":"itemLayoutElement","id":"45cc4706-1003-41f2-8c52-339d61d5dad3"}},"type":"desktop","widgets":[{"id":"45cc4706-1003-41f2-8c52-339d61d5dad3","dashboardItemType":"widget","name":"Rich text (2)","noDataState":{},"noFilterState":{},"focusModeEnabled":false,"datasets":[],"type":"richTextWidget","text":"<h4 style=\"text-align:center;\"><span style=\"font-size:18px;\"><strong>How to Use Berks County Election Results Dashboard</strong></span></h4><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Full Screen Mode:</strong></span><span style=\"font-size:12px;\">&nbsp;To enter or exit Full Screen Mode, press F11</span></p><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Tabs:</strong></span><span style=\"font-size:12px;\"> Users may chose various result options:</span></p><p><span style=\"font-size:12px;\"><i>&nbsp; &nbsp;&nbsp;<strong><u>Races of Interest</u></strong></i> - These are the High Interest Contests</span></p><p><span style=\"font-size:12px;\"><i>&nbsp; &nbsp;&nbsp;<strong><u>Individual Race Results</u></strong></i> - These are fo All Contests</span></p><p><span style=\"font-size:12px;\"><i>&nbsp; &nbsp;&nbsp;<strong><u>Individual Precinct Results</u></strong></i> - Results to the Precinct Level</span></p><p><span style=\"font-size:12px;\"><i>&nbsp; &nbsp;&nbsp;<strong><u>Precincts Reporting In Details</u></strong> - What Precinct Have Results Reported In</i></span></p><p><span style=\"font-size:12px;\"><i>&nbsp; &nbsp;&nbsp;<strong><u>Voter Turnout Details</u></strong></i></span></p><p><span style=\"font-size:12px;\"><i>&nbsp; &nbsp;&nbsp;<strong><u>Ballot Question Results</u></strong></i> (if applicable).&nbsp;</span></p><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Important Note:</strong></span><span style=\"font-size:12px;\"> Selections on the Filter Panel&nbsp;will filter the various maps, other filters,&nbsp;and interactive widgets in the Election Results Dashboard. You may choose reset to clear the dashboard to explore more results.</span></p><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Maps:</strong> </span><span style=\"font-size:12px;\">The maps will display precincts, symbolized by the party color of the vote&nbsp;leader for the selected precinct. Clicking the precincts allows the user to see the leaders and full precinct results&nbsp;in a pop-up window.</span></p><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Results Charts:&nbsp;</strong></span><span style=\"font-size:12px;\"> The results information in the pop-up window is also represented on the results chart above the maps.</span></p><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Registered Voters</strong>:&nbsp;</span><span style=\"font-size:12px;\">Updates to the number of registered voters in the selected municipality/precinct in the Filter Panel. Defaults to the countywide total when 'All' are selected.</span></p><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Ballots Cast:</strong>&nbsp;</span><span style=\"font-size:12px;\">Shows the sum of ballots cast according to the criteria in the Filter Panel.</span></p><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Precinct Reporting:</strong></span><span style=\"font-size:12px;\">&nbsp;This shows details about what precincts have or have not reported in results for this election. &nbsp;</span></p><p>&nbsp;</p><p><span style=\"font-size:14px;\"><strong>Voter Turnout:</strong></span><span style=\"font-size:12px;\"><strong>&nbsp;</strong>Allows users to see how many mail-in and election day ballots have been cast. It allows the user to see how many registered voters there are and overall voter turnout percentage by county or at the precinct level.</span></p>","valueType":"none","showFeatureMenu":false}],"settings":{"allowElementResizing":false,"allowReset":true}},"mobileView":{"layout":{"type":"dockingLayout","rootElement":{"width":1,"height":0.9999999999999988,"type":"itemLayoutElement","id":"c90b0667-6e58-4b56-811f-4db5ad07c8c2"}},"type":"mobile","widgets":[{"id":"c90b0667-6e58-4b56-811f-4db5ad07c8c2","dashboardItemType":"widget","name":"Rich text (2)","noDataState":{},"noFilterState":{},"focusModeEnabled":false,"datasets":[],"type":"richTextWidget","text":"<h4 style=\"background-color:rgb(248, 244, 239);box-sizing:border-box;color:rgb(57, 67, 56);font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif;font-size:14px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin:0px;orphans:2;overflow-wrap:anywhere;text-align:center;text-decoration-color:initial;text-decoration-style:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;\"><span style=\"font-size:18px;\"><span style=\"box-sizing:border-box;overflow-wrap:anywhere;\"><strong>How to Use the Election Results Dashboard</strong></span></span></h4><p style=\"background-color:rgb(248, 244, 239);box-sizing:border-box;color:rgb(57, 67, 56);font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica N