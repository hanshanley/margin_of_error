---
import BaseLayout from './BaseLayout.astro';
import { platforms, platformCover, platformRepository } from '../lib/platform-analysis';
import '../styles/platform-analysis.css';

interface Props {
	title: string;
	description: string;
	active: 'issues' | 'sources';
}
const { title, description, active } = Astro.props;
const [titleLead, ...titleRest] = title.split(': ');
---

<BaseLayout title={title} description={description} image={platformCover.src}>
	<div class:list={['platform-page', { 'platform-issues': active === 'issues' }]}>
		{platforms.preview_only && <p class="qualification" role="status">Local development preview,
			not a verified publication. Do not publish this build.</p>}
		<header class="analysis-heading">
			<div>
				{active === 'sources' && <p class="kicker">National documents, 2000–2026</p>}
				<h1>{active === 'issues' ? 'DSA, in context' : <>{titleLead}{titleRest.length > 0 && <>: {titleRest.join(': ')}</>}</>}</h1>
				<p class="analysis-deck">{active === 'issues' ? 'What party documents emphasize, and how DSA caucuses differ.' : description}</p>
			</div>
		</header>
		{active === 'sources' && <p><a href="/party-platforms/">&larr; Back to the comparison</a></p>}
		<slot />
		{active === 'issues' && <details class="project-scope"><summary>About this project</summary><p>{title}</p><p>Party documents and caucus statements</p><p>{description}</p></details>}
		<p class="repository-link"><a id="platform-repository" href={platformRepository}>
			Code, data and methods on GitHub &rarr;</a></p>
	</div>
</BaseLayout>
