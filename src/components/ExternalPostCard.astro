---
import { formatFrenchRepublicanDate } from '../lib/french-republican-calendar';

interface ExternalArticle {
	slug: string;
	title: string;
	authors: string;
	outlet: string;
	publishedAt: string;
	description: string;
}

interface Props {
	article: ExternalArticle;
	index: number;
}

const { article, index } = Astro.props;
const path = `/fieldwork/${article.slug}/`;
const publishedAt = new Date(`${article.publishedAt}T12:00:00Z`);
---

<article class="post-row">
	<p class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
	<a class="post-thumb fieldwork-thumb" href={path} tabindex="-1" aria-hidden="true">
		<span>DFR</span>
		<strong>{publishedAt.getUTCFullYear().toString().slice(-2)}</strong>
	</a>
	<div class="post-summary">
		<p class="post-meta">
			{publishedAt.toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
				timeZone: 'UTC',
			})}
			<span class="republican-date"> · {formatFrenchRepublicanDate(publishedAt)}</span>
			<span> · Published elsewhere</span>
		</p>
		<h2><a href={path}>{article.title}</a></h2>
		<p>{article.description}</p>
	</div>
	<div class="post-tags" aria-label="Publication">
		<span>DFRLab</span>
		<span>Fieldwork</span>
	</div>
</article>
