---
import type { CollectionEntry } from 'astro:content';
import Exploration from './explorations/Exploration.astro';

interface Props {
	post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { artifacts } = post.data;
const hasMaterials = Boolean(
	artifacts?.code || artifacts?.data?.length || artifacts?.outputs?.length,
);
---

<div class="post-workspace">
	{
		hasMaterials && (
			<aside class="post-materials" aria-label="Article materials">
				<ul>
					{artifacts?.code && (
						<li>
							<span>Code</span>
							<a href={artifacts.code.repository}>{artifacts.code.title ?? 'Analysis repository'} ↗</a>
						</li>
					)}
					{artifacts?.data?.map((item) => (
						<li>
							<span>{item.label ?? 'Data'}</span>
							<a href={item.url}>{item.title} ↗</a>
						</li>
					))}
					{artifacts?.outputs?.map((item) => (
						<li>
							<span>Output</span>
							<a href={item.url}>{item.title} ↗</a>
						</li>
					))}
				</ul>
			</aside>
		)
	}

	<section class="article-panel">
		<h2 class="visually-hidden">Article</h2>
		<div class="prose"><slot /></div>
	</section>

	{
		artifacts?.explore && (
			<section class="post-exploration" aria-labelledby="exploration-heading">
				<h2 id="exploration-heading">{artifacts.explore.title}</h2>
				<p>{artifacts.explore.description}</p>
				{artifacts.explore.kind === 'local' ? (
					<>
						<Exploration module={artifacts.explore.module} />
						<noscript><p class="fallback-note">{artifacts.explore.fallback}</p></noscript>
					</>
				) : (
					<p><a href={artifacts.explore.url}>Open the external exploration ↗</a></p>
				)}
			</section>
		)
	}
</div>
