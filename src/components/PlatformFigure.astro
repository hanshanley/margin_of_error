---
import { platforms, type PlatformFigure } from '../lib/platform-analysis';

interface Props {
	figure: PlatformFigure;
	caption: string;
}
const { figure, caption } = Astro.props;
const path = `/party-platforms/${figure.path}?source=${platforms.source_revision}`;
const displayPath = `/party-platforms/${figure.display_path ?? figure.path}?source=${platforms.source_revision}`;
---

<figure class="platform-figure">
	<a href={path} data-original-chart aria-label={`Open full-size chart: ${caption}`}>
		<img src={displayPath} alt={caption} width={figure.width} height={figure.height}
			loading="lazy" decoding="async" />
	</a>
	<figcaption>
		{caption}
	</figcaption>
</figure>

<style>
	.platform-figure { margin: 1.8rem 0 2.5rem; }
	img { width: 100%; }
	figcaption { margin-top: 0.6rem; color: var(--muted); font-size: 0.88rem; }
</style>
