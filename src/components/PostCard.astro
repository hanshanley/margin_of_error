---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'posts'>;
	index: number;
}

const { post, index } = Astro.props;
const path = post.data.legacyPath ?? `/${post.id}`;
const thumbnail = post.data.thumbnail ?? post.data.hero;
const thumbnailWidth = post.data.thumbnail?.width;
const thumbnailHeight = post.data.thumbnail?.height;
---

<article class="post-row">
	<p class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
	<a class="post-thumb" href={path} tabindex="-1" aria-hidden="true">
		{
			thumbnail ? (
				<img
					src={thumbnail.src}
					alt=""
					width={thumbnailWidth}
					height={thumbnailHeight}
					loading={index === 0 ? 'eager' : 'lazy'}
					decoding="async"
				/>
			) : (
				<span aria-hidden="true">±</span>
			)
		}
	</a>
	<div class="post-summary">
		<p class="post-meta">
			{post.data.publishedAt ? post.data.publishedAt.toLocaleDateString('en-US', { dateStyle: 'long' }) : 'From the archive'}
		</p>
		<h2><a href={path}>{post.data.title}</a></h2>
		<p>{post.data.description}</p>
	</div>
	<div class="post-tags" aria-label="Topics">
		{post.data.tags.map((tag) => <span>{tag}</span>)}
	</div>
</article>
