---
import { readFileSync } from 'node:fs';
import SectionLink from './SectionLink.astro';
import { caucusLabel } from '../lib/platform-display.mjs';

interface Example { claim_id: string; claim_text: string; evidence: string; source_url: string; title: string; locator: string }
interface Caucus { id: string; name: string; share: number; claims: number; baseline: number; ratio: number | null; examples: Example[] }
interface Topic { id: string; title: string; summary: string; groups: Caucus[] }
const data: { source_revision: string; eligible_claims: number; topics: Topic[] } =
	JSON.parse(readFileSync('public/party-platforms/caucuses/analysis.json', 'utf8'));
const percent = (value: number) => `${(100 * value).toFixed(1)}%`;
const ratio = (value: number | null) => value === null ? '\u2014' : `${value.toFixed(1)}\u00d7`;
const displayClaim = (text: string) => text.replace(/^Commitment to /, 'Commits to ')
	.replace(/^Support for /, 'Supports ').replace(/^Opposition to /, 'Opposes ');
const positionId = (topic: string, group: string) => `caucus-position-${topic}-${group}`;
---

<section id="caucuses" class="reader-section" data-platform-panel="caucuses" aria-labelledby="caucuses-title">
	<h2 id="caucuses-title" class="reader-section-title">DSA caucuses</h2>
	<div class="caucus-toolbar" hidden><label for="caucus-topic-select">Issue
		<select id="caucus-topic-select">{data.topics.map(topic => <option value={topic.id}>{caucusLabel(topic.id)}</option>)}</select>
	</label></div>
	<p class="caucus-intro">Thirteen caucuses and networks, through one sampled statement each.
		Attention is not membership or agreement; zero attention does not mean opposition.</p>
	{data.topics.map((topic, index) => {
		const groups = [...topic.groups].sort((a, b) => b.share - a.share || a.name.localeCompare(b.name));
		const ceiling = Math.max(0.1, Math.ceil(Math.max(...groups.map(group => group.share)) * 10) / 10);
		return <details id={`caucus-${topic.id}`} class="caucus-issue" open={index === 0} data-caucus-topic={topic.id}>
			<summary>{topic.title}</summary>
			<h3 class="caucus-theme-title">{caucusLabel(topic.id)}</h3>
			<p class="caucus-chart-caption">Share of attention in each statement. Select a caucus to read its statement.</p>
			<div class="caucus-chart">
				<div class="caucus-chart-heading" aria-hidden="true"><span>Caucus</span>
					<span class="caucus-axis"><span>0%</span><span>{Math.round(ceiling * 100)}%</span></span><span>Share</span><span></span>
				</div>
				{groups.map(group => <details class="caucus-position" id={positionId(topic.id, group.id)}
					data-caucus-position={group.id} name={`caucus-selection-${topic.id}`}>
					<summary class="caucus-row" data-caucus={group.id} data-share={group.share} data-ratio={group.ratio}>
						<span class="caucus-name">{group.name}</span>
						<span class="caucus-track" aria-hidden="true"><span style={`width:${group.share / ceiling * 100}%`}></span></span>
						<span class="caucus-percent">{percent(group.share)}</span><span class="caucus-toggle" aria-hidden="true"></span>
					</summary>
					<div class="caucus-position-body">
						<h4 class="caucus-position-name">{group.name} <SectionLink href={`#${positionId(topic.id, group.id)}`} label={`${group.name} on ${topic.title}`} /></h4>
						{group.examples.length ? <>
							<p class="caucus-position-label">From its statement</p>
							<p class="caucus-statement">{displayClaim(group.examples[0].claim_text)}</p>
							<details class="caucus-evidence"><summary>Read the source evidence</summary>
								<SectionLink id={`caucus-evidence-${topic.id}-${group.id}`} href={`#caucus-evidence-${topic.id}-${group.id}`} label={`the source evidence for ${group.name} on ${topic.title}`} />
								{group.examples.map(example => <div data-claim={example.claim_id}>
									<p class="caucus-original">{example.claim_text}</p><blockquote>{example.evidence}</blockquote>
									<p class="caucus-citation"><a href={example.source_url}>{example.title}</a></p><p class="locator">{example.locator}</p>
								</div>)}
							</details>
						</> : <p class="caucus-empty">No eligible claims assigned to this theme in the sampled statement. This does not mean opposition.</p>}
						<p class="relative-attention">Relative attention: <span class="caucus-ratio">{ratio(group.ratio)}</span>
							{group.ratio === null ? ' · not defined because the other statements have zero average share.' : ' the equally weighted average of the other twelve statements.'}</p>
					</div>
				</details>)}
			</div>
			<details class="caucus-values"><summary>All values and sources</summary>
				<p>Original research title: {topic.title} <SectionLink href={`#caucus-${topic.id}`} label={`the caucus comparison on ${topic.title}`} /></p>
				<p class="caucus-theme-summary">{topic.summary}</p>
				<div class="table-wrap"><table><caption>All thirteen statements · shares and relative attention</caption>
					<thead><tr><th>Caucus</th><th>Share</th><th>vs others</th></tr></thead><tbody>
						{groups.map(group => <tr data-caucus-value={group.id}><th scope="row">{group.name}</th><td>{percent(group.share)}</td><td>{ratio(group.ratio)}</td></tr>)}
					</tbody></table></div>
			</details>
		</details>;
	})}
	<div class="caucus-footer"><p>One statement per group. Themes overlap; attention is not membership or agreement.</p>
		<details class="caucus-methods"><summary>How these comparisons work</summary>
			<p>Compare the priorities of thirteen caucuses and networks, through the issues emphasized in their own statements.</p>
			<p>The twelve themes use {data.eligible_claims.toLocaleString('en-US')} normalized claims.
				Shares use all eligible claims in each group's statement. Bars share one scale within each issue;
				compare the percentages across issues. “vs others” divides a group's share by the equally weighted
					average of the other twelve, using unrounded shares and no smoothing. A zero baseline is undefined.
					Zero attention does not mean opposition.</p>
			<p>These are snapshots, not timelines. Some themes reflect shared wording or ideological identity rather
				than distinct policy issues. They were learned separately from the national-party subjects.
				Selected statements are examples, not exhaustive position summaries. Original extracted wording
				and exact excerpts are retained in the source evidence.</p>
			<a href={`https://github.com/hanshanley/dsa/tree/${data.source_revision}/data/analysis/dsa_caucuses`}>Complete caucus analysis, claims and sources</a>
		</details>
	</div>
</section>

<style>
	.caucus-toolbar { max-width: 46rem; margin-bottom: 1.25rem; }
	.caucus-toolbar label { font: .8rem/1.5 var(--sans); color: var(--muted); }
	.caucus-intro, .caucus-chart-caption { color: var(--muted); font: .85rem/1.6 var(--sans); max-width: 64ch; }
	.caucus-chart-caption { margin: 1.5rem 0 1rem; }
	.caucus-chart-heading, .caucus-row { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,1.4fr) 4rem 1.25rem; gap: 1rem; align-items: center; }
	.caucus-chart-heading { padding: .5rem 0 .75rem; border-bottom: 1px solid var(--rule); font: .75rem/1.5 var(--sans); color: var(--muted); }
	.caucus-chart-heading > :nth-child(3) { text-align: right; }
	.caucus-axis { display: flex; justify-content: space-between; }
	.caucus-chart .caucus-position { margin: 0; border-bottom: 1px solid var(--rule); }
	.caucus-position > .caucus-row { min-height: 52px; padding: .75rem 0; font: .9rem/1.45 var(--sans); list-style: none; }
	.caucus-row::-webkit-details-marker { display: none; }
	.caucus-toggle::after { content: '+'; color: var(--muted); }
	.caucus-position[open] > summary .caucus-toggle::after { content: '−'; }
	.caucus-position[open] > summary { font-weight: 600; }
	.caucus-track { display: block; height: .5rem; }
	.caucus-track > span { display: block; height: 100%; background: #c39a36; }
	.caucus-percent { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.caucus-position-body { max-width: 62ch; padding: .5rem 0 1rem; }
	.caucus-position-name { margin: .25rem 0 1rem; font: 400 1.35rem/1.3 var(--serif); }
	.caucus-position-label { color: var(--muted); font: .75rem var(--sans); }
	.caucus-statement { font: 1.1rem/1.6 var(--serif); }
	.caucus-empty, .relative-attention, .caucus-theme-summary { font: .85rem/1.6 var(--sans); color: var(--muted); }
	.caucus-evidence > summary { font: .8rem/1.5 var(--sans); color: var(--muted); padding-block: .5rem; }
	.caucus-evidence > div + div { border-top: 1px solid var(--rule); padding-top: 1rem; margin-top: 1rem; }
	.caucus-original, .caucus-citation { font: .9rem/1.6 var(--sans); }
	.caucus-footer { margin-top: 1.75rem; color: var(--muted); font: .8rem/1.6 var(--sans); }
	.caucus-values { margin-top: 1.5rem; }
	:global(.js) .caucus-issue > summary, :global(.js) .caucus-theme-title { display: none; }
	@media (max-width: 700px) {
		.caucus-chart-heading, .caucus-row { grid-template-columns: minmax(0,1.4fr) minmax(0,1fr) 3.2rem .8rem; gap: .6rem; }
		.caucus-position > .caucus-row { font-size: .85rem; }
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('#caucuses')!;
	const panels = [...section.querySelectorAll<HTMLDetailsElement>('.caucus-issue')];
	const select = section.querySelector<HTMLSelectElement>('#caucus-topic-select')!;
	const showIssue = (index: number) => {
		panels.forEach((panel, position) => { panel.hidden = position !== index; if (!panel.hidden) panel.open = true; });
		select.value = panels[index].dataset.caucusTopic!;
	};
	select.addEventListener('change', () => {
		showIssue(panels.findIndex(panel => panel.dataset.caucusTopic === select.value));
		history.replaceState(null, '', `#caucus-${select.value}`);
	});
	for (const position of section.querySelectorAll<HTMLDetailsElement>('.caucus-position')) {
		position.addEventListener('toggle', () => { if (position.open) history.replaceState(null, '', `#${position.id}`); });
	}
	const reveal = () => {
		const target = document.getElementById(location.hash.slice(1));
		if (!target || !section.contains(target)) return;
		const panel = target.closest<HTMLDetailsElement>('.caucus-issue');
		if (panel) {
			showIssue(panels.indexOf(panel));
			for (let element: HTMLElement | null = target; element && element !== panel; element = element.parentElement)
				if (element instanceof HTMLDetailsElement) element.open = true;
		}
		requestAnimationFrame(() => target.scrollIntoView({ behavior: 'instant', block: 'start' }));
	};
	section.querySelector<HTMLElement>('.caucus-toolbar')!.hidden = false;
	showIssue(0);
	window.addEventListener('hashchange', reveal);
	window.addEventListener('popstate', reveal);
	window.addEventListener('load', reveal, { once: true });
	document.fonts.ready.then(reveal);
	reveal();
</script>
