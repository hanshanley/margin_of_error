---
import { readFileSync } from 'node:fs';
import { roundedContributions, switchingConstraintBounds } from '../../public/scripts/participation-calibrated-swing.js';
import { roundedNorcContributions } from '../../public/scripts/participation-norc-house.js';
const { names } = Astro.props as { names: Record<string, string> };
type DriverRow = { id: string; state_code: string; office: string; components_pp: Record<string, number>;
	reported_comparison: { baseline_year?: number; reported_change_pp: number | null;
		other_and_unallocated_pp: number | null; baseline_alignment_pp: number | null } };
const data = JSON.parse(readFileSync('data/participation-return-attribution/20261110-02/viewer-data.json', 'utf8'));
const calibration = JSON.parse(readFileSync('data/participation-return-attribution/20261111-03/return-constrained-viewer.json', 'utf8'));
const norcSource = JSON.parse(readFileSync('data/participation-return-attribution/20261112-06/norc-receipt.json', 'utf8'));
const families = JSON.parse(readFileSync('data/participation-return-attribution/20261112-06/family-summary.json', 'utf8'));
const association = JSON.parse(readFileSync('data/participation-return-attribution/20261112-06/copula-receipt.json', 'utf8'));
const norcPoints = JSON.parse(readFileSync('data/participation-return-attribution/20261112-06/norc-point-summary.json', 'utf8'));
type CalibratedRow = { id: string; state_code: string; office: string;
	point: { reported_change_pp: number; components_pp: Record<string, number> } | null };
const receipt = JSON.parse(readFileSync('data/participation-return-attribution/20261110-02/download.json', 'utf8'));
const houseHolds = Object.fromEntries(norcPoints.rows.filter((row: any) => !row.source_comparison_available)
	.map((row: any) => [row.state_code, row.reported_comparison.reason]));
const heldHouse = (row: { office: string; state_code: string }) => row.office === 'house' && Boolean(houseHolds[row.state_code]);
const payload = JSON.stringify({ data, calibration, names, norc_source: norcSource, house_comparison_holds: houseHolds,
	norc_association_sources: association }).replaceAll('<', '\\u003c');
const pp = (value: number | null) => value === null ? 'Unavailable' : `${value > 0 ? '+' : ''}${value.toFixed(2)}`;
const validation = norcPoints.validation;
const tests = [
	['2024 House baseline bridge', validation.house_2024_bridge_without_demographics, validation.house_2024_bridge],
	['2026 House response holdout', validation.current_2026_response_without_demographics, validation.current_2026_response],
	['2022 → 2024 transfer · now used in family selection', validation.historical_transfer.without_demographics, validation.historical_transfer.with_demographics],
];
---
<section id="participation-return-drivers" class="participation-current" aria-labelledby="return-drivers-title">
	<header class="section-intro">
		<p class="kicker">2026 · NORC House vote-flow model</p>
		<h2 id="return-drivers-title">Why House margins changed</h2>
		<p>Model retained voters, switching, entry/return and nonparticipation using NORC responses.
			Choose a state and demographic group to see how its estimated flows contribute to the House shift.</p>
	</header>
	<p class="caption">Reported change compares held <strong>same-office candidate counts</strong>, not measured voter preference.
		Known-D/R margin = 100 × (D − R) / (D + R). Gray is unavailable.
		Changed major-party candidate coverage, missing native counts and unqualified election stages cannot constrain a behavioral explanation.
		NORC source models are trained separately from the reported results; qualified comparisons constrain the reconstruction.
		Estimates, model checks and assumptions appear below the map.</p>
	<div class="driver-controls">
		<label>2026 office<select data-driver-office disabled><option value="house">House · states</option>
			<option value="senate">Senate</option><option value="governor">Governor · frames</option></select></label>
		<label>Map view<select data-driver-view disabled>
			<option value="reported_total">Qualified reported House change</option>
			<option value="switching">Switching · fitted</option>
			<option value="modeled_nonparticipation">No contest vote · fitted</option>
			<option value="entry">Entry / return · fitted</option>
			<option value="other_choice">Other-party choice · fitted</option>
			<optgroup label="Original survey-frame demographic scenarios · not return-fitted">
				<option value="scenario_retaining">Keep party choice · scenario</option>
				<option value="scenario_switching">Switch party choice · scenario</option>
				<option value="scenario_nonparticipation">Nonparticipation · scenario</option>
			</optgroup>
		</select></label>
		<label data-driver-group-control hidden>Source group<select data-driver-group disabled>
			<option value="">Overall source frame</option>
		</select></label>
		<label class="driver-state-control">State<select data-driver-state disabled><option value="">Loading state context…</option></select></label>
		<label>House model<select data-driver-family disabled>
			<option value="accepted_ridge_multinomial">Multinomial ridge · accepted baseline</option>
		</select></label>
		<label>Temporal association<select data-driver-association disabled>
			<option value="original">Original association</option>
			<option value="attenuated">Historical association · attenuated stress</option>
			<option value="full">Historical association · stronger stress</option>
		</select></label>
		<label>Change units<select data-driver-units disabled>
			<option value="margin">D−R margin points</option>
			<option value="democratic_two_party_share">Democratic two-party-share points</option>
		</select></label>
	</div>
	<p data-driver-status class="caption" role="status">Loading NORC House estimates; every saved state summary and complete download remains below.</p>
	<p data-driver-association-note class="caption" hidden></p>
	<div class="driver-maps">
		<section class="driver-map-card" aria-labelledby="driver-map-title">
			<h3 id="driver-map-title" data-driver-map-title>Qualified reported House change</h3>
			<p class="caption" data-driver-map-caption>Held source margin changes passing candidate-coverage checks; not population turnout or a measured preference swing.</p>
			<div class="driver-map" data-driver-map="reported_total"></div>
		</section>
	</div>
	<div class="driver-map-key" aria-label="Shared signed margin-point scale">
		<div><div class="driver-map-ramp"></div><div class="driver-map-ticks">
			<span data-driver-scale-min></span><span>0</span><span data-driver-scale-max></span>
		</div><div class="driver-map-directions"><span>Republican direction</span><span>Democratic direction</span></div></div>
		<span class="driver-no-model"><i></i>No qualified comparison / model</span>
	</div>
	<p class="caption driver-map-note">Colour shows <strong>signed percentage-point changes or contributions to the margin</strong>,
		not party vote shares or turnout rates. House model change =
		switching + net participation + Other-party choice + unresolved responses.
		The common accounting-frame size and transitions are modeled, not measured people.
		No state estimate is spread onto counties or precincts.</p>
	<div data-driver-summary class="driver-summary" hidden aria-live="polite"></div>
	<details class="explorer-notes"><summary>Selected state: demographic breakdown, retained voters and model checks</summary>
		<div data-driver-detail class="driver-detail" hidden></div>
	</details>
	<details class="explorer-notes"><summary>How to read these estimates and their uncertainty</summary>
	<p class="caption">The House model learns from <strong>113,020 NORC CHEP 2026 responses</strong> and
		<strong>136,435 AP/NORC 2024 responses with positive state weights</strong>.
		It learns prior-choice and demographic associations jointly, rather than assigning each group the same party transitions.
		CHEP recalls 2024 President, not House: the AP2024 President/House association and recalled 2022 House choice supply an explicit baseline bridge.</p>
	<p class="caption">Source training does not use 2026 partisan return totals. Held-out NORC response tests,
		a 2022-to-2024 source-transfer test and the before-conditioning state prediction remain separate from endpoint reconstruction.
		A match after conditioning on results is not independent validation.</p>
	<p class="caption">Compare three fixed model families on the same respondents, holdouts, endpoints,
		demographic disclosure masks, assumption grid and simulation seeds.
		The preregistered source-only selection rule retains <strong>multinomial ridge</strong>.
		Boosting slightly improves current-response prediction, but historical transfer worsens.
		The lower return error does not override that rule. The historical test is now selection validation,
		not an independent post-selection test. Model-family spread is not a confidence interval.</p>
	<p class="caption">The temporal-association control changes dependence, not the fitted source margins.
		Two optional <strong>historical association stresses</strong> use nested CES 2022-to-2024 calibration,
		attenuated or stronger, then preserve state and demographic-group year-specific source margins.
		This postaggregation transport is not validated for the different 2026 predictors or election direction.
		Source-only feasibility checks can reduce its strength; selected-state details report the applied multiplier.
		The multiplier weights D–D and R–R cells before fixed-margin projection; it is not a retention percentage.
		The original association remains the default. Neither historical alternative measures staying home or first-ever voting.</p>
	<div class="table-wrap">
		<table data-norc-copula-validation><caption>Historical retained-panel House-pair test · fixed predicted year margins, not 2026 population validation</caption>
			<thead><tr><th>2020 predictors</th><th>Original log loss</th><th>Nested dependence log loss</th>
				<th>Original Brier</th><th>Nested dependence Brier</th></tr></thead>
			<tbody>{association.source_validation.map((row: any) => <tr>
				<th scope="row">{row.label}</th>
				{[row.baseline_logloss, row.calibrated_logloss, row.baseline_Brier, row.calibrated_Brier]
					.map(value => <td class="numeric">{Number(value).toFixed(4)}</td>)}</tr>)}</tbody>
		</table>
	</div>
	<p class="caption">Historical calibration improved the retained-panel test.
		Current before-conditioning errors now use {norcPoints.summary.return_anchored} compatible state comparisons, not the superseded 48-state set.
		A change in the comparison set is not a model improvement. Association profiles remain sensitivity views, not independently validated forecasts or replacements for the default.</p>
	<p class="caption">Calibration excludes each outer test fold, including from every inner marginal fit.
		Unknown and nonvote response categories remain separate. Earlier source-weight frames and fold stresses
		are diagnostics, not design confidence intervals. These paired-response scores have different targets
		from the marginal-source tests below and must not be ranked against them.
		<a href={association.complete_science_url}>Corrected association-profile queries, simulations, permitted inputs and code · ZIP</a> ·
		<a href={association.historical_science_url}>Archived complete historical dependence calibration · ZIP</a></p>
	<div class="table-wrap">
		<table data-norc-family-validation><caption>Original association · three model families · before conditioning on current party totals</caption>
			<thead><tr><th>Family</th><th>Current-response log loss</th><th>Historical log loss</th>
				<th>Historical Brier</th><th>State margin MAE (pp)</th><th>Democratic two-party-share MAE (pp)</th></tr></thead>
			<tbody>{families.summary.families.map((family: string) => {
				const current = families.source_validation.find((r: any) => r.family === family && r.role === 'house26_response');
				const historical = families.source_validation.find((r: any) => r.family === family && r.role === 'historical_transfer');
				return <tr data-norc-validation-family={family}><th scope="row">{families.family_labels[family]}</th>
					{[current.source_weighted_log_loss, historical.source_weighted_log_loss,
						historical.source_weighted_multiclass_brier, families.summary.margin_MAE_pp[family],
						families.summary.Democratic_two_party_share_MAE_pp[family]]
						.map(value => <td class="numeric">{value.toFixed(4)}</td>)}</tr>;
			})}</tbody>
		</table>
	</div>
	<p class="caption">A move from R+4 to D+12 is +16 margin points but +8 Democratic
		<strong>two-party-share</strong> points. The change-unit control scales signed contributions,
		assumption ranges and prediction errors consistently. Gross retention/switching percentages
		keep their own denominator and are never halved. Map scales are shared across families and association profiles.
		The family table retains original-association prediction errors; the selected-state details show the active profile's error.</p>
	<p class="caption">The 2024 baseline now uses the official House Clerk candidate totals across all 435 districts,
		including explicit same-nominee party lines but excluding blank, overvote and ranked-choice accounting.
		The 2026 counts remain the November 7 source snapshot, not newly updated or certified final totals.
		Pennsylvania now uses all 17 native district totals: its unmatched county-validation rows were not missing native votes.
		Provider district totals omit known county-source write-ins; those are kept separate, not added to Other.
		Every district is now audited for named major-party coverage, missing native counts and multiple same-party nominees.
		There are {norcPoints.summary.return_anchored} conditional comparisons; incompatible or unresolved cases remain unavailable in every current view.
		In Massachusetts, Republican candidates appear in 2 of 9 districts in 2024 but 5 of 9 in the held 2026 snapshot.
		The old aggregate change therefore was not a like-for-like statewide preference swing. A common-district subtotal is not a statewide correction, and matching IDs do not certify unchanged geography.
		Maine's unresolved ranked-choice-round hold remains independent. Unreported counts are never filled with zero.</p>
	<p class="caption">Three accounting-frame sizes and half/double latent-choice affinity give
		<strong>assumption sensitivity, not confidence intervals</strong>.
		Denominator effects are assigned inside each transition mechanism using exact symmetric accounting.
		Entry/return and modeled absence together make the net participation effect.
		Current demographic dimensions overlap; each dimension separately adds to its state, not to the other dimensions.</p>
	<p class="caption">Source likely-voter classes are not administratively confirmed staying home.
		Prior-contest nonvote is not proven first-ever voting or new eligibility.
		Unknown answers remain separate from nonparticipation. Age, residence, source-weight targets,
		changing candidate availability and reporting scope remain assumptions or qualifications.
		No state estimates are allocated to counties or precincts.</p>
	<p class="caption">The archived party-choice scenarios simulate gross shares within recalled major-party
		choices, not contributions to the electoral swing. Their half/double persistence envelopes are
		assumption sensitivity, not confidence intervals. Gross-switching state-held-out error is 1.39 pp;
		House-model transport to Senate/governor and demographic party associations remain unvalidated.
		Historical voting marginals do not identify individual staying-home or switching histories.</p>
	<p class="caption">Aggregate returns do not uniquely identify behavior. The archived constraint-only
		analysis permits zero D↔R switching in all 89 earlier central frames.
		NORC-informed estimates add learned associations and assumptions, not identified causes.</p>
	<div class="table-wrap">
		<table data-norc-validation><caption>Accepted ridge: demographic versus simpler source fits · lower scores are better</caption>
			<thead><tr><th>Test</th><th>Log loss: prior/state only</th><th>With demographics</th>
				<th>Brier: prior/state only</th><th>With demographics</th></tr></thead>
			<tbody>{tests.map(([label, baseline, model]) => <tr><th scope="row">{label}</th>
				{[baseline.source_weighted_log_loss, model.source_weighted_log_loss,
					baseline.source_weighted_multiclass_brier ?? baseline.source_weighted_brier,
					model.source_weighted_multiclass_brier ?? model.source_weighted_brier]
					.map(value => <td class="numeric">{value.toFixed(4)}</td>)}</tr>)}</tbody>
		</table>
	</div>
	<p class="caption">The baseline bridge's Brier score is slightly worse with demographics; the historical
		transfer improvement is modest. These predict source responses, not independently verified voter histories.
		Before conditioning on current party totals, the {norcPoints.summary.return_anchored}-state margin mean absolute error is {norcPoints.preconditioning_margin_MAE_pp.toFixed(2)} pp.
		Selected-state details retain each prediction gap as model error.</p>
	</details>
	<details class="explorer-notes"><summary>Every saved NORC House-state estimate</summary>
		<div class="table-wrap" tabindex="0" role="region" aria-label="All 50 NORC House state models">
			<table><caption>Conditional estimates for compatible held comparisons, not identified histories. Incompatible source-only scenarios are available in the complete download, not substituted here.</caption>
				<thead><tr><th scope="col">State</th><th scope="col">Qualified reported change</th>
					<th scope="col">Model shift</th><th scope="col">Switching</th>
					<th scope="col">Net participation</th><th scope="col">Other / unresolved</th><th scope="col">Qualification</th></tr></thead>
				<tbody>{norcPoints.rows.map((row: any) => {
					const rounded = roundedNorcContributions(row.point);
					return <tr data-saved-norc={row.state_code}><th scope="row">{names[row.state_code]}</th>
						<td class="numeric">{pp(row.source_comparison_available ? row.reported_comparison.reported_change_pp : null)}</td>
						<td class="numeric">{pp(row.source_comparison_available ? row.point.total_change_pp : null)}</td>
						<td class="numeric">{pp(row.source_comparison_available ? rounded.switching : null)}</td>
						<td class="numeric">{pp(row.source_comparison_available ? rounded.entry + rounded.exit : null)}</td>
						<td class="numeric">{pp(row.source_comparison_available ? rounded.other_choice + rounded.unresolved : null)}</td>
						<td>{row.source_comparison_available ? 'Held snapshot; candidate-coverage checks passed' : row.reported_comparison.reason}</td></tr>;
				})}</tbody>
			</table>
		</div>
	</details>
	<details class="explorer-notes"><summary>Archived earlier return-constrained scenarios</summary>
		<div class="table-wrap" tabindex="0" role="region" aria-label="All 113 return-constrained decisions">
			<table><caption>Superseded central scenarios, not current voter-history estimates. Newly held House comparisons are suppressed here; original files remain archived. The final column is a compatible gross-switching percentage of previous D/R votes, not margin points or a confidence interval. Unavailable is not zero.</caption>
				<thead><tr><th scope="col">State / office</th><th scope="col">Reported swing</th>
					<th scope="col">Switching</th><th scope="col">No contest vote</th>
					<th scope="col">Entry / return</th><th scope="col">Other-party choice</th>
					<th scope="col">Compatible gross switching</th></tr></thead>
				<tbody>{calibration.rows.map((row: CalibratedRow) => {
					const rounded = row.point && !heldHouse(row) ? roundedContributions(row.point) : null;
					const compatible = heldHouse(row) ? null : switchingConstraintBounds(row);
					return <tr data-saved-calibrated={row.id}><th scope="row">{names[row.state_code]} · {row.office}</th>
						<td class="numeric">{pp(heldHouse(row) ? null : row.point?.reported_change_pp ?? null)}</td>
						{['switching', 'nonparticipation', 'entry', 'other_choice'].map(key =>
							<td class="numeric">{pp(rounded?.[key] ?? null)}</td>)}
						<td class="numeric" data-saved-switching-bounds={row.id}>{compatible
							? `${compatible.minimumPercent.toFixed(1)}% to ${compatible.maximumPercent.toFixed(1)}%`
							: 'Unavailable'}</td></tr>;
				})}</tbody>
			</table>
		</div>
	</details>
	<details class="explorer-notes"><summary>Archived original survey-frame estimates · not the fitted swing scenarios</summary>
		<div class="table-wrap" tabindex="0" role="region" aria-label="All 113 saved modeled effect estimates">
			<table><caption>Archived unfitted survey-frame terms, not a decomposition of the reported same-office swing. Unavailable is not zero.</caption>
				<thead><tr><th scope="col">State / office</th><th scope="col">Switching</th><th scope="col">Nonparticipation</th>
					<th scope="col">Entry</th><th scope="col">Other</th><th scope="col">Unknown</th>
					<th scope="col">Denominator</th><th scope="col">Current-frame gap</th>
					<th scope="col">Prior-office year</th><th scope="col">Reported swing</th>
					<th scope="col">Other / unallocated total</th><th scope="col">Baseline alignment</th></tr></thead>
				<tbody>{data.rows.map((row: DriverRow) =>
					<tr data-saved-driver={row.id}><th scope="row">{names[row.state_code]} · {row.office}</th>
						{['switching', 'modeled_nonparticipation', 'no_prior_contest_vote_entry',
							'other_choice', 'unresolved', 'denominator', 'return_frame_gap'].map(key =>
							<td class="numeric">{pp(row.components_pp[key])}</td>)}
						<td>{row.reported_comparison.baseline_year ?? 'Unavailable'}</td>
						{['reported_change_pp', 'other_and_unallocated_pp', 'baseline_alignment_pp'].map(key =>
							<td class="numeric">{pp(heldHouse(row) ? null : row.reported_comparison[key as 'reported_change_pp'])}</td>)}</tr>)}</tbody>
			</table>
		</div>
	</details>
	<div class="download-links"><a href={receipt.url}>Archived historical returns, inputs and superseded scenarios, code and checksums · ZIP</a></div>
	<div class="download-links"><a href={norcSource.complete_download_url}>Complete NORC demographic House model: permitted fitted inputs, every state/group/seed/assumption query, code and tests · ZIP</a></div>
	<div class="download-links"><a href={norcSource.complete_download_url.replace('complete-analysis.zip', 'complete-profile-family-state-comparisons.csv')}>All 450 corrected profile/family/state decisions in both change units · CSV</a> · <a href={norcSource.complete_download_url}>All 900 profile/family/mechanism-spread decisions and source scores · complete ZIP</a></div>
	<div class="download-links"><a href="https://github.com/hanshanley/margin_of_error/releases/download/participation-house-model-families-20261112-01/complete-source-validation.csv">Unchanged frozen source-only validation comparisons · CSV</a></div>
	<div class="download-links"><a href="https://github.com/hanshanley/margin_of_error/releases/download/participation-pa-house-native-controls-20261112-01/complete-analysis.zip">Superseded 48-comparison archive and every query · ZIP</a></div>
	<div class="download-links"><a href="https://github.com/hanshanley/margin_of_error/releases/download/participation-norc-house-demographic-20261111-01/complete-analysis.zip">Superseded original NORC archive and complete queries · ZIP</a> · <a href="https://github.com/hanshanley/margin_of_error/releases/download/participation-house-clerk-norc-endpoints-20261112-01/complete-analysis.zip">Superseded 47-comparison archive · ZIP</a></div>
	<div class="download-links"><a href="https://github.com/hanshanley/margin_of_error/releases/download/participation-return-constrained-20261111-01/complete-analysis.zip">Archived return-constrained model, all 801 scenarios and transition cells, inputs, code and checksums · ZIP</a></div>
	<div class="download-links"><a href="https://github.com/hanshanley/margin_of_error/releases/download/participation-flow-identification-20261111-01/complete-analysis.zip">Archived compatible-flow bounds, all 3,824 extremal tables, original inputs, code and checksums · ZIP</a></div>
	<div class="download-links"><a href="https://github.com/hanshanley/margin_of_error/releases/download/participation-transition-simulation-20261111-01/complete-analysis.zip">Archived conditional transition simulations, every input/query/seed, code and checksums · ZIP</a></div>
	<script type="application/json" is:inline data-driver-data set:html={payload}></script>
</section>
<script>
	import { initializeReturnDrivers } from '../../public/scripts/participation-return-drivers.js';
	initializeReturnDrivers();
</script>
<style>
	#participation-return-drivers { min-width: 0; margin-block: 1.5rem 2rem; }
	.driver-controls { display: grid; grid-template-columns: repeat(3,minmax(0,1fr));
		gap: .75rem; margin-block: 1.25rem .75rem; max-width: 55rem; }
	.driver-controls label { display: grid; min-width: 0; gap: .3rem; font: .73rem var(--sans); }
	.driver-controls label[hidden] { display: none; }
	.driver-controls[data-scenarios="true"] { grid-template-columns: repeat(4,minmax(0,1fr)); max-width: 65rem; }
	.driver-controls :is(select,input) { width: 100%; min-width: 0; padding: .5rem; border: 1px solid var(--rule);
		background: var(--paper); color: var(--ink); font: inherit; }
	.driver-maps { display: grid; grid-template-columns: minmax(0,1fr); margin-top: 1.5rem; }
	.driver-map-card { min-width: 0; }
	.driver-map-card h3 { margin: 0 0 .35rem; font: 400 1.3rem var(--serif); }
	.driver-map-card > p { margin: 0 0 .5rem; }
	.driver-map { min-height: 120px; }
	.driver-map :global(svg) { display: block; width: 100%; max-width: 62.5rem; height: auto; margin-inline: auto; }
	.driver-map :global(.driver-state) { stroke: #8d958e; stroke-width: .85; stroke-linejoin: round; vector-effect: non-scaling-stroke; cursor: pointer; }
	.driver-map :global(.driver-state:hover) { stroke: #355b61; stroke-width: 1.35; }
	.driver-map :global(.driver-state.selected) { stroke: #173d48; stroke-width: 2.2; }
	.driver-map :global(.driver-inset-label) { fill: var(--muted); font: 15px var(--sans); }
	.driver-map-key { display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
		gap: .5rem .75rem; font: .66rem/1.4 var(--sans); color: var(--muted); margin-block: .75rem; }
	.driver-map-key > div { width: min(100%, 20rem); }
	.driver-map-ramp { height: .5rem; background: linear-gradient(to right,#a47045,#f1eee6,#2c6c75); }
	.driver-map-ticks { display: flex; justify-content: space-between; margin-top: .25rem; font-variant-numeric: tabular-nums; }
	.driver-map-directions { display: flex; justify-content: space-between; margin-top: .25rem; }
	.driver-no-model { display: inline-flex; align-items: center; gap: .35rem; margin-left: .5rem; }
	.driver-no-model i { width: .65rem; height: .65rem; background: #d6d3cb; }
