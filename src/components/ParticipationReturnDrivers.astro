---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { roundedContributions, switchingConstraintBounds } from '../../public/scripts/participation-calibrated-swing.js';
import { roundedNorcContributions, norcRecordedComparison } from '../../public/scripts/participation-norc-house.js';
import { validateHouseTransitions } from '../../public/scripts/participation-house-transitions.js';
const { names } = Astro.props as { names: Record<string, string> };
type DriverRow = { id: string; state_code: string; office: string; components_pp: Record<string, number>;
	reported_comparison: { baseline_year?: number; reported_change_pp: number | null;
		other_and_unallocated_pp: number | null; baseline_alignment_pp: number | null } };
const data = JSON.parse(readFileSync('data/participation-return-attribution/20261110-02/viewer-data.json', 'utf8'));
const calibration = JSON.parse(readFileSync('data/participation-return-attribution/20261111-03/return-constrained-viewer.json', 'utf8'));
const norcSource = JSON.parse(readFileSync('data/participation-return-attribution/20261113-01/norc-receipt.json', 'utf8'));
const families = JSON.parse(readFileSync('data/participation-return-attribution/20261113-01/family-summary.json', 'utf8'));
const association = JSON.parse(readFileSync('data/participation-return-attribution/20261113-01/copula-receipt.json', 'utf8'));
const sensitivity = JSON.parse(readFileSync('data/participation-return-attribution/20261113-01/sensitivity-receipt.json', 'utf8'));
const districtGeometry = JSON.parse(readFileSync('data/participation-house-districts/20261118-02/receipt.json', 'utf8'));
const norcPoints = JSON.parse(readFileSync('data/participation-return-attribution/20261113-01/norc-point-summary.json', 'utf8'));
const statewideSource = JSON.parse(readFileSync('data/participation-statewide-source/20261124-01/receipt.json', 'utf8'));
const transitionSource = JSON.parse(readFileSync('data/participation-house-transition-model/20261127-01/receipt.json', 'utf8'));
const transitionMethodsUrl = transitionSource.url.replace('raw.githubusercontent.com', 'github.com')
	.replace('/voter-participation/', '/voter-participation/tree/').replace(/viewer-data\.json\.gz$/, '');
const transitionModel = validateHouseTransitions(JSON.parse(readFileSync('data/participation-house-transition-model/20261127-01/viewer-data.json', 'utf8')));
const transitionBytes = readFileSync('data/participation-house-transition-model/20261127-01/viewer-data.json');
if (transitionBytes.length !== transitionSource.decoded_bytes ||
	createHash('sha256').update(transitionBytes).digest('hex') !== transitionSource.decoded_sha256 ||
	transitionModel.version !== transitionSource.version)
	throw new Error('Saved statewide House transitions differ from their immutable receipt');
const statewideBytes = readFileSync('data/participation-statewide-source/20261124-01/display-summary.json');
const statewideSummary = JSON.parse(statewideBytes.toString('utf8'));
if (statewideBytes.length !== statewideSource.display_summary.bytes ||
	createHash('sha256').update(statewideBytes).digest('hex') !== statewideSource.display_summary.sha256 ||
	statewideSummary.metadata.version !== statewideSource.version || statewideSummary.rows.length !== 50 ||
	new Set(statewideSummary.rows.map((row: any) => row.state_code)).size !== 50 ||
	statewideSummary.rows.some((row: any) => !names[row.state_code] || row.state_code === 'DC'))
	throw new Error('Saved all-state source model does not match its verified display receipt');
type CalibratedRow = { id: string; state_code: string; office: string;
	point: { reported_change_pp: number; components_pp: Record<string, number> } | null };
const receipt = JSON.parse(readFileSync('data/participation-return-attribution/20261110-02/download.json', 'utf8'));
const houseHolds = Object.fromEntries(norcPoints.rows.filter((row: any) => !row.source_comparison_available)
	.map((row: any) => [row.state_code, row.reported_comparison.reason]));
const heldHouse = (row: { office: string; state_code: string }) => row.office === 'house' && Boolean(houseHolds[row.state_code]);
const recordedHouse = norcPoints.rows.map((row: any) => ({
	state_code: row.state_code, source_comparison_available: row.source_comparison_available,
	reported_comparison: { reason: row.reported_comparison.reason,
		current_snapshot: row.reported_comparison.current_snapshot },
	contest_comparability: Object.fromEntries(['previous_counts', 'current_counts', 'districts',
		'previous_named_R_districts', 'current_named_R_districts']
		.map(key => [key, row.contest_comparability[key]])),
}));
const payload = JSON.stringify({ data, calibration, names, norc_source: norcSource, house_comparison_holds: houseHolds,
	recorded_house_counts: recordedHouse, norc_association_sources: association, norc_sensitivity: sensitivity,
	district_geometry: districtGeometry, statewide_source_model: statewideSource, statewide_house_transitions: transitionSource }).replaceAll('<', '\\u003c');
const pp = (value: number | null) => value === null ? 'Unavailable' : `${value > 0 ? '+' : ''}${value.toFixed(2)}`;
const validation = norcPoints.validation;
const reading = {
	title: 'Modeled contribution to Democratic share of D+R change',
	meaning: 'Switching and prior House voters casting no counted ballot are estimated together from whole-state House counts and turnout benchmarks. Missing House choices and eligibility changes remain separate.',
	example: 'Positive points move the reported result toward Democrats; negative points toward Republicans. These conditional estimates are not observed voter histories.',
};
const outcomeAudit = JSON.parse(readFileSync('data/participation-estimate-validation/20261127-01/summary.json', 'utf8'));
const outcomeStates = JSON.parse(readFileSync('data/participation-estimate-validation/20261127-01/state-checks.json', 'utf8'));
const tests = [
	['2024 House baseline bridge', validation.house_2024_bridge_without_demographics, validation.house_2024_bridge],
	['2026 House response holdout', validation.current_2026_response_without_demographics, validation.current_2026_response],
	['2022 → 2024 transfer · now used in family selection', validation.historical_transfer.without_demographics, validation.historical_transfer.with_demographics],
];
---
<section id="participation-return-drivers" class="participation-current" aria-labelledby="return-drivers-title">
	<header class="section-intro">
		<h2 id="return-drivers-title">Switching and staying home · House</h2>
		<p data-driver-intro>2024 → 2026 · Modeled statewide comparisons for all 50 states, using whole-state House and turnout totals.</p>
	</header>
	<div id="desktop-swing-controls"></div>
	<div class="driver-controls">
		<label>2026 office<select data-driver-office disabled><option value="house">House</option>
			<option value="senate">Senate</option><option value="governor">Governor · frames</option></select></label>
		<label>Geography<select data-driver-geography disabled>
			<option value="state">States</option>
			<option value="district">House districts</option>
		</select></label>
		<label data-driver-secondary>Map view<select data-driver-view disabled>
			<option value="house_transition_home" selected>Modeled staying-home contribution · all 50 states</option>
			<option value="house_transition_switching">Modeled D↔R switching contribution · all 50 states</option>
			<option value="source_total">Modeled House change · all 50 states</option>
			<option value="source_switching">Modeled switching contribution · source frame</option>
			<option value="source_participation">Modeled net participation contribution · source frame</option>
			<option value="source_entry">Modeled no House choice → D/R · source frame</option>
			<option value="source_exit">Modeled D/R → no House choice · source frame</option>
			<option value="source_other">Other / unassigned choice · source frame</option>
			<option value="source_unresolved">Unresolved responses · source frame</option>
			<option value="source_retaining">Kept party · source-model share</option>
			<option value="reported_counts">Comparable reported House change</option>
			<option value="reported_total">Like-for-like House comparisons only</option>
			<option value="switching">Switching · fitted</option>
			<option value="modeled_nonparticipation">Net participation · NORC estimate</option>
			<option value="entry">Modeled no House choice → D/R</option>
			<option value="other_choice">Other / unassigned choice · fitted</option>
			<optgroup label="Original survey-frame demographic scenarios · not return-fitted">
				<option value="scenario_retaining">Keep party choice · scenario</option>
				<option value="scenario_switching">Switch party choice · scenario</option>
				<option value="scenario_nonparticipation">Nonparticipation · scenario</option>
			</optgroup>
		</select></label>
		<label data-driver-secondary data-driver-group-control hidden>Source group<select data-driver-group disabled>
			<option value="">Overall source frame</option>
		</select></label>
		<label class="driver-state-control">State<select data-driver-state disabled><option value="">Loading state context…</option></select></label>
		<label data-driver-district-control hidden>District<select data-driver-district disabled>
			<option value="">Select a district…</option>
		</select></label>
		<label data-driver-secondary>House model<select data-driver-family disabled>
			<option value="accepted_ridge_multinomial">Multinomial ridge · accepted baseline</option>
		</select></label>
		<label data-driver-secondary>Temporal association<select data-driver-association disabled>
			<option value="original">Original association</option>
			<option value="attenuated">Historical association · attenuated stress</option>
			<option value="full">Historical association · stronger stress</option>
		</select></label>
		<label data-driver-secondary>Change units<select data-driver-units disabled>
			<option value="democratic_two_party_share">D share (pp)</option>
			<option value="margin">D−R margin (pp)</option>
		</select></label>
	</div>
	<details class="driver-options"><summary>Model and display options</summary>
		<div class="driver-controls" id="swing-display-controls"></div>
	</details>
	<p data-driver-association-note class="caption" hidden></p>
	<p data-driver-counts-notice class="caption" hidden>Current congressional counts could not be loaded.
		The recorded view retains an older saved model-endpoint snapshot; it is not marked as current results.</p>
	<p data-driver-model-warning class="driver-model-warning" hidden>Experimental scenario, not a validated explanation of actual switching or staying home.
		The source-model baseline differs from recorded 2024 results. <a href="#estimate-outcome-check">Read the outcome check.</a></p>
	<div class="driver-overview"><div class="driver-overview-map">
	<div class="driver-maps">
		<section class="driver-map-card" aria-labelledby="driver-map-title">
			<h3 id="driver-map-title" data-driver-map-title>Modeled staying-home contribution · all 50 states</h3>
			<div class="driver-map" data-driver-map="house_transition_home"></div>
		</section>
	</div>
	<div class="driver-map-key" aria-label="Shared signed margin-point scale">
		<div><div class="driver-map-ramp"></div><div class="driver-map-ticks">
			<span data-driver-scale-min></span><span>0</span><span data-driver-scale-max></span>
		</div><div class="driver-map-directions"><span>Republican direction</span><span>Democratic direction</span></div></div>
		<span class="driver-no-model"><i></i>No qualified comparison / model</span>
		<span class="driver-comparison-caution" data-driver-comparison-caution hidden><i></i>Not comparable · competition / scope</span>
	</div>
	<div class="driver-unit-reading" data-driver-reading role="note" aria-live="polite">
		<p><strong data-driver-reading-title>{reading.title}</strong></p>
		<p data-driver-reading-meaning>{reading.meaning}</p>
		<p data-driver-reading-example>{reading.example}</p>
	</div>
	<p class="driver-reading-note">Hatching marks an unavailable comparison, not a partisan swing.</p>
	</div><aside class="driver-overview-result" aria-label="Selected election comparison">
	<div data-driver-summary class="driver-summary" hidden aria-live="polite"></div>
	<details class="explorer-notes"><summary data-driver-detail-title>Details and model checks</summary>
		<div data-driver-detail class="driver-detail" hidden></div>
	</details>
	</aside></div>
	<details class="explorer-notes" data-house-transition-table><summary>Compare all 50 states: switching and staying home</summary>
		<p>Modeled contributions to the reported Democratic share of D+R change, in percentage points.
			Every state uses its whole-state totals; changed candidate coverage is context, not a reason to omit the state.
			Matching reported totals is a constraint, not validation of individual histories.</p>
		<div class="table-wrap"><table><caption>All 50 statewide House transition comparisons · 2024 → 2026</caption>
			<thead><tr><th>State</th><th>Reported change</th><th>Switching</th><th>No counted ballot</th></tr></thead>
			<tbody>{transitionModel.rows.map((row: any) => <tr data-house-transition-state={row.state_code}>
				<th scope="row">{names[row.state_code] || row.state_code}</th><td>{pp(row.point.recorded_change_pp)}</td>
				<td>{pp(row.point.contributions_pp.switching)}</td><td>{pp(row.point.contributions_pp.staying_home)}</td>
			</tr>)}</tbody>
		</table></div>
	</details>
	<details class="explorer-notes" data-house-transition-methods id="statewide-house-model-methods"><summary>How the all-state estimates work</summary>
		<p>These are conditional modeled transitions, not linked voter histories. Both years retain their recorded statewide
			House D/R/Other counts and UF ballot and estimated voting-eligible-population benchmarks. The six categories
			separate counted House choices, ballots with no reported House choice, no counted ballot, and eligibility/frame changes.
			Missing or unreported unopposed House choices are never automatically classified as staying home.</p>
		<p>Fixed source-model associations supply the transition prior. The model then matches statewide margins using
			entropy projection. The central setting uses the existing original multinomial-ridge prior and an explicit 2% frame-churn
			assumption. It does not measure deaths, migration or first-ever voting. Candidate-menu or round changes mean
			recorded-category switching is not proof of persuasion. State model counts are not additive unique-person counts.</p>
		<p>The complete grid compares nine existing source-prior variants, half/base/double party and nonvoting persistence,
			0%/2%/5% eligibility-frame churn, and hypothetical ±3% ballot benchmarks. Physically incompatible scenarios
			are retained as explicit rejected decisions. The ranges are assumption sensitivity, not confidence intervals
			or all sampling, source, population-transport and recording uncertainty. No estimate is allocated to districts or precincts.</p>
		<p>Turnout benchmarks: Michael McDonald, University of Florida Election Lab, 2024 v0.4 and 2026 v0.3,
			CC-BY-4.0. Some counts are estimated or source-reported rather than independently certified.</p>
		<p><a href={transitionMethodsUrl}>Complete analysis: inputs, all state queries, sensitivity matrices and replay code</a>.</p>
	</details>
	<details class="explorer-notes" id="estimate-outcome-check"><summary>Outcome check: models versus reported results</summary>
		<p>November 27, 2026 check · {outcomeAudit.states_checked} states reviewed;
			{outcomeAudit.qualified_comparisons} comparable House changes. The source-model change differs from the recorded
			Democratic-share change by {outcomeAudit.change_MAE_pp.toFixed(2)} percentage points on average.
			{outcomeAudit.change_error_above_2pp} comparisons differ by more than 2 points.
			Baseline error is material: the modeled 2024 baseline is not the recorded 2024 result.</p>
		<p>Current-share mean absolute difference: {outcomeAudit.current_share_MAE_pp.toFixed(2)} pp;
			baseline-share difference: {outcomeAudit.baseline_share_MAE_pp.toFixed(2)} pp.
			{outcomeAudit.outside_model_sensitivity} of {outcomeAudit.qualified_comparisons} recorded changes fall outside the model-sensitivity range.
			Those ranges are not confidence intervals. Matching totals does not validate individual switching,
			staying home or demographic turnout. No model was rescaled or refitted to make this check pass.</p>
		<p>Frozen audit reference: runtime {outcomeAudit.runtime_version.slice(0,12)}, checked {outcomeAudit.runtime_checked_at}.
			The recorded-results map uses the current accepted congressional snapshot, not this frozen audit.</p>
		<p><a href="https://github.com/hanshanley/voter-participation/tree/1c0b99c86ee129a08703e50c55c1ec641494c3b2/data/estimate-validation/20261127-01">Complete outcome check and source evidence on GitHub</a></p>
		<div class="table-wrap"><table><caption>All-state check · Democratic share among D+R candidate votes; changes in percentage points</caption>
			<thead><tr><th>State</th><th>Model change</th><th>Recorded change</th><th>Difference</th><th>Comparison</th></tr></thead>
			<tbody>{outcomeStates.map((row: any) => <tr data-outcome-check-state={row.state_code}>
				<th scope="row">{names[row.state_code] || row.state_code}</th><td>{pp(row.modeled_change_pp)}</td>
				<td>{row.qualified_outcome_comparison ? pp(row.recorded_change_pp) : 'Not comparable'}</td>
				<td>{row.qualified_outcome_comparison ? pp(row.change_error_pp) : 'Not scored'}</td>
				<td>{row.qualified_outcome_comparison ? 'Compatible candidate coverage' : row.comparison_holds}</td>
			</tr>)}</tbody>
		</table></div>
	</details>
	<details class="explorer-notes" data-statewide-source-table><summary>Saved source-model estimates · all 50 states</summary>
		<p class="caption">Original association and multinomial ridge; Democratic two-party-share percentage points.
			Both endpoints describe the CHEP2026 source-weighted frame, not either year's observed electorate.
			These estimates are not population calibrated or constrained by partisan returns. Sensitivity is not a confidence interval.
			Input vintages: AP2024 / CHEP2026; interview and fit dates are not supplied. D.C. has no CHEP sample.</p>
		<div class="table-wrap"><table><caption>Uniform source-model decomposition · source version {statewideSummary.metadata.version.slice(0,12)}</caption>
			<thead><tr><th>State</th><th>Total modeled change</th><th>Switching</th><th>Net participation</th><th>Other choice</th><th>Unresolved</th><th>Model sensitivity</th></tr></thead>
			<tbody>{statewideSummary.rows.map((row: any) => <tr data-statewide-source-state={row.state_code}>
				<th scope="row">{names[row.state_code] || row.state_code}</th>
				{[row.point.allocated_change_pp,row.point.contributions_pp.switching,row.point.net_participation_pp,
					row.point.contributions_pp.other_choice,row.point.contributions_pp.unresolved].map(value =>
					<td class="numeric">{pp(value / 2)}</td>)}
				<td class="numeric">{pp(row.sensitivity.total_change.minimum / 2)} to {pp(row.sensitivity.total_change.maximum / 2)}</td>
			</tr>)}</tbody>
		</table></div>
	</details>
	<details class="driver-research"><summary>Sources and model methodology</summary>
	<details class="explorer-notes driver-sources">
		<summary>How to read the map</summary>
		<p class="caption" data-driver-map-caption>Directional colour requires compatible candidate coverage. Raw totals remain in state details.</p>
		<p data-driver-status class="caption" role="status">Loading uniform source-model estimates for all 50 states…</p>
		<p class="caption">The primary House layer uses the same fitted-source method in every state, without partisan-return constraints.
			It does not mix return-conditioned estimates with unconditioned states. It is not a new population-calibrated model.
			Recorded and return-constrained views retain their candidate-coverage and round qualifications.</p>
		<p class="caption">Reported change compares <strong>same-office candidate counts</strong>, not measured voter preference.
			Known-D/R margin = 100 × (D − R) / (D + R), twice the Democratic-share change.
			Neutral hatching means a comparison is unavailable, not a partisan swing.
			Changed major-party candidate coverage, missing native counts and unqualified election stages cannot constrain a behavioral explanation.
			NORC source models are trained separately from the reported results; qualified comparisons constrain the reconstruction.</p>
		<p class="caption">For the saved snapshot, the official Hawaii and Wyoming source updates are included; the other 48 states retain their held snapshots.
			Wyoming's Other/unassigned total includes 1,031 write-in votes with unknown party, not assumed nonvoting.
			Overvotes and undervotes remain separate. Hawaii's seven-ballot accounting difference remains unresolved.
			Survey fits, weights and existing behavioral holds are unchanged.</p>
		<p class="caption driver-map-note">Colour shows <strong>signed percentage-point changes or contributions to the margin</strong>,
			not party vote shares or turnout rates. House model change =
			switching + net participation + Other/unassigned choice + unresolved responses.
			The common accounting-frame size and transitions are modeled, not measured people.
			No state estimate is spread onto counties or precincts.</p>
		<p data-automatic-runtime-status class="caption" role="status">
			Checking the optional automatic House snapshot; accepted website estimates remain available.
		</p>
		<div class="download-links">
			<a href={districtGeometry.complete_download.url}>Complete district geography evidence · ZIP</a>
			<a href={districtGeometry.complete_geography_csv_url}>All district geography decisions · CSV</a>
			<a href="https://github.com/hanshanley/margin_of_error/releases/download/house-district-offline-map-0e5766689d4a/house-district-map-complete.zip">435-district offline map, complete data and evidence · ZIP</a>
			<a href={norcSource.complete_download_url.replace('complete-analysis.zip', 'complete-recorded-counts.csv')}>Complete saved recorded counts · CSV</a>
			<a href={norcSource.complete_download_url.replace('complete-analysis.zip', 'complete-recorded-counts.json')}>Complete saved recorded counts · JSON</a>
			<a href="https://github.com/hanshanley/margin_of_error/releases/download/participation-house-recorded-counts-20261113-01/complete-analysis.zip">Earlier recorded counts, full queries, model qualifications and code · ZIP</a>
		</div>
	</details>
	<noscript><p class="caption">The interactive map requires JavaScript. Research files are available in the project repositories.</p></noscript>
	<details class="explorer-notes"><summary>How to read these estimates and their uncertainty</summary>
	<p class="caption">The House model learns from <strong>113,020 NORC CHEP 2026 responses</strong> and
		<strong>136,435 AP/NORC 2024 responses with positive state weights</strong>.
		It learns prior-choice and demographic associations jointly, rather than assigning each group the same party transitions.
		CHEP recalls 2024 President, not House: the AP2024 President/House association and recalled 2022 House choice supply an explicit baseline bridge.</p>
	<p class="caption">Source training does not use 2026 partisan return totals. Held-out NORC response tests,
		a 2022-to-2024 source-transfer test and the before-conditioning state prediction remain separate from endpoint reconstruction.
		The publisher's weight targets are not independently qualified here; source-response checks are not population validation.
		A match after conditioning on results is not independent validation.</p>
	<p class="caption">Selected-state ranges span the three existing families and three association profiles
		for the same state and demographic group. They are model sensitivity, not confidence intervals
		or all survey, transport, accounting-frame or endpoint uncertainty.
		Modeled prior D/R to no House choice does not establish prior voters staying home;
		the reverse category does not identify first-ever or returning people.</p>
	<p class="caption">Compare three fixed model families on the same respondents, holdouts, endpoints,
		demographic disclosure masks, assumption grid and simulation seeds.
		The preregistered source-only selection rule retains <strong>multinomial ridge</strong>.
		Boosting slightly improves current-response prediction, but historical transfer worsens.
		The lower return error does not override that rule. The historical test is now selection validation,
		not an independent post-selection test. Model-family spread is not a confidence interval.</p>
	<p class="caption">The temporal-association control changes dependence, not the fitted source margins.
		Two optional <strong>historical association stresses</strong> use nested CES 2022-to-2024 calibration,
		attenuated or stronger, then preserve state and demographic-group year-specific source margins.
		This postaggregation transport is not validated for the different 2026 predictors or election direction.
		Source-only feasibility checks can reduce its strength; selected-state details report the applied multiplier.
		The multiplier weights D–D and R–R cells before fixed-margin projection; it is not a retention percentage.
		The original association remains the default. Neither historical alternative measures staying home or first-ever voting.</p>
	<div class="table-wrap">
		<table data-norc-copula-validation><caption>Historical retained-panel House-pair test · fixed predicted year margins, not 2026 population validation</caption>
			<thead><tr><th>2020 predictors</th><th>Original log loss</th><th>Nested dependence log loss</th>
				<th>Original Brier</th><th>Nested dependence Brier</th></tr></thead>
			<tbody>{association.source_validation.map((row: any) => <tr>
				<th scope="row">{row.label}</th>
				{[row.baseline_logloss, row.calibrated_logloss, row.baseline_Brier, row.calibrated_Brier]
					.map(value => <td class="numeric">{Number(value).toFixed(4)}</td>)}</tr>)}</tbody>
		</table>
	</div>
	<p class="caption">Historical calibration improved the retained-panel test.
		Current before-conditioning errors now use {norcPoints.summary.return_anchored} compatible state comparisons, not the superseded 48-state set.
		A change in the comparison set is not a model improvement. Association profiles remain sensitivity views, not independently validated forecasts or replacements for the default.</p>
	<p class="caption">Calibration excludes each outer test fold, including from every inner marginal fit.
		Unknown and nonvote response categories remain separate. Earlier source-weight frames and fold stresses
		are diagnostics, not design confidence intervals. These paired-response scores have different targets
		from the marginal-source tests below and must not be ranked against them.
		<a href={association.complete_science_url}>Corrected association-profile queries, simulations, permitted inputs and code · ZIP</a> ·
		<a href={association.historical_science_url}>Archived complete historical dependence calibration · ZIP</a></p>
	<div class="table-wrap">
		<table data-norc-family-validation><caption>Original association · three model families · before conditioning on current party totals</caption>
			<thead><tr><th>Family</th><th>Current-response log loss</th><th>Historical log loss</th>
				<th>Historical Brier</th><th>State margin MAE (pp)</th><th>Democratic two-party-share MAE (pp)</th></tr></thead>
			<tbody>{families.summary.families.map((family: string) => {
				const current = families.source_validation.find((r: any) => r.family === family && r.role === 'house26_response');
				const historical = families.source_validation.find((r: any) => r.family === family && r.role === 'historical_transfer');
				return <tr data-norc-validation-family={family}><th scope="row">{families.family_labels[family]}</th>
					{[current.source_weighted_log_loss, historical.source_weighted_log_loss,
						historical.source_weighted_multiclass_brier, families.summary.margin_MAE_pp[family],
						families.summary.Democratic_two_party_share_MAE_pp[family]]
						.map(value => <td class="numeric">{value.toFixed(4)}</td>)}</tr>;
			})}</tbody>
		</table>
	</div>
	<p class="caption">A move from R+4 to D+12 is +16 margin points but +8 Democratic
		<strong>two-party-share</strong> points. The change-unit control scales signed contributions,
		assumption ranges and prediction errors consistently. Gross retention/switching percentages
		keep their own denominator and are never halved. Map scales are shared across families and association profiles.
		The family table retains original-association prediction errors; the selected-state details show the active profile's error.</p>
	<p class="caption">The 2024 baseline now uses the official House Clerk candidate totals across all 435 districts,
		including explicit same-nominee party lines but excluding blank, overvote and ranked-choice accounting.
		The 2026 counts remain the November 7 source snapshot, not newly updated or certified final totals.
		Pennsylvania now uses all 17 native district totals: its unmatched county-validation rows were not missing native votes.
		Provider district totals omit known county-source write-ins; those are kept separate, not added to Other.
		Every district is now audited for named major-party coverage, missing native counts and multiple same-party nominees.
		There are {norcPoints.summary.return_anchored} conditional comparisons; incompatible or unresolved cases remain unavailable in return-constrained views, not in the separate source-only layer.
		In Massachusetts, Republican candidates appear in 2 of 9 districts in 2024 but 5 of 9 in the held 2026 snapshot.
		The old aggregate change therefore was not a like-for-like statewide preference swing. A common-district subtotal is not a statewide correction, and matching IDs do not certify unchanged geography.
		Maine's unresolved ranked-choice-round hold remains independent. Unreported counts are never filled with zero.</p>
	<p class="caption">Three accounting-frame sizes and half/double latent-choice affinity give
		<strong>assumption sensitivity, not confidence intervals</strong>.
		Denominator effects are assigned inside each transition mechanism using exact symmetric accounting.
		Entry/return and modeled absence together make the net participation effect.
		Current demographic dimensions overlap; each dimension separately adds to its state, not to the other dimensions.</p>
	<p class="caption">Source likely-voter classes are not administratively confirmed staying home.
		Prior-contest nonvote is not proven first-ever voting or new eligibility.
		Unknown answers remain separate from nonparticipation. Age, residence, source-weight targets,
		changing candidate availability and reporting scope remain assumptions or qualifications.
		No state estimates are allocated to counties or precincts.</p>
	<p class="caption">The archived party-choice scenarios simulate gross shares within recalled major-party
		choices, not contributions to the electoral swing. Their half/double persistence envelopes are
		assumption sensitivity, not confidence intervals. Gross-switching state-held-out error is 1.39 pp;
		House-model transport to Senate/governor and demographic party associations remain unvalidated.
		Historical voting marginals do not identify individual staying-home or switching histories.</p>
	<p class="caption">Aggregate returns do not uniquely identify behavior. The archived constraint-only
		analysis permits zero D↔R switching in all 89 earlier central frames.
		NORC-informed estimates add learned associations and assumptions, not identified causes.</p>
	<div class="table-wrap">
		<table data-norc-validation><caption>Accepted ridge: demographic versus simpler source fits · lower scores are better</caption>
			<thead><tr><th>Test</th><th>Log loss: prior/state only</th><th>With demographics</th>
				<th>Brier: prior/state only</th><th>With demographics</th></tr></thead>
			<tbody>{tests.map(([label, baseline, model]) => <tr><th scope="row">{label}</th>
