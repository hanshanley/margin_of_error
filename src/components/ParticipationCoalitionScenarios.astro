---
import { readFileSync } from 'node:fs';
import { publicationAllows, publicationDecision } from '../lib/participation-publication-decision.mjs';
const { names } = Astro.props as { names: Record<string, string> };
const base = '/participation-coalition-scenarios/20261107-02/';
type Values = { returning_count: number; reported_switcher_count: number; apparent_absence_count: number;
	reported_switchers_pct_of_original_coalition: number; apparent_absence_pct_of_original_coalition: number;
	infeasible_as_closed_original_coalition: boolean };
type Scenario = { state_code: string; contest_code: string; reference: Record<string, Values>;
	official_2024_baseline: Record<string, number>;
	turnout_source: { ballots: number; source_url: string; source_update_label: string };
	turnout_input_qualification?: { all_ballot_population_scope_confirmed: boolean };
	survey_source_url: string; survey_source_timestamp: string;
	sensitivity_scenarios: { coalitions: Record<string, Values> | null }[] };
type Jurisdiction = { state_code: string; has_existing_full_election_reported_ballots: boolean;
	has_conditional_native_ballot_snapshot?: boolean; conditional_contests: string[] };
const review: { estimates: Scenario[]; jurisdictions: Jurisdiction[] } = JSON.parse(
	readFileSync(`public${base}conditional-coalition-scenarios.json`, 'utf8'));
const integer = (value: number) => value.toLocaleString('en-US');
const count = (value: number) => integer(Math.round(value / 1000) * 1000);
const pct = (value: number) => `${value.toFixed(1)}%`;
const range = (row: Scenario, prior: string) => {
	const values = row.sensitivity_scenarios.flatMap(scenario => scenario.coalitions
		? [scenario.coalitions[prior].apparent_absence_pct_of_original_coalition] : []);
	return `${pct(Math.min(...values))}–${pct(Math.max(...values))}`;
};
const office: Record<string, string> = { SG: 'Senate', GG: 'Governor' };
const codes = [...new Set(review.estimates.map(row => row.state_code))];
const hasNativeScopeAssumptions = review.estimates.some(row => row.turnout_input_qualification);
const publishOriginalCoalitionScalars = ['original_coalition_returning_counts',
	'original_coalition_switching_counts_rates', 'signed_apparent_absence_counts_rates']
	.every(metric => publicationAllows(publicationDecision, metric));
---

<section id="participation-coalition-scenarios" aria-labelledby="coalition-scenarios-title">
	<h3 id="coalition-scenarios-title">Preliminary coalition scaling scenarios</h3>
	<p><strong>{codes.length} states · {review.estimates.length} separate contests.</strong>
		The archived calculation applies the poll's recalled-2024 composition to provisional source ballot counts,
		then compares with the FEC's official 2024 presidential coalitions.
		<strong>These are conditional estimates, not measured staying home.</strong></p>
	<p>The reference assumes each contest table represents all state ballot-casters. SSRS targets the
		estimated state electorate, but exact contest-table response selection remains unverified.
		Skipped contests, retained pre-election choices and recall error can break that assumption.
		Source snapshots are frozen, not current live or certified totals; individual clocks appear below.</p>
	{hasNativeScopeAssumptions && <p><strong>Additional Georgia and Delaware scope assumption:</strong>
		their source-defined Ballots Cast snapshots are scaled as if they cover the whole ballot-caster
		population. That all-ballot scope is unverified. Native source warnings and approval flags remain
		unchanged; Delaware supplies no turnout update clock. These rows are not newly approved all-mode counts.</p>}
	{!publishOriginalCoalitionScalars && <p data-publication-decision="historical-scalars-withheld"><strong>Historical evidence decision:</strong>
		population-scaled returning, switching and apparent-absence quantities are withheld. Source-reported
		ballot observations, coverage and qualified unscaled survey shares remain available.</p>}
	{publishOriginalCoalitionScalars && <div class="table-wrap" tabindex="0" role="region" aria-label="Conditional original-coalition switching and apparent absence">
		<table>
			<caption>Official 2024 totals are exact; scenario counts are rounded to the nearest 1,000.
				Percentages below use the original 2024 coalition, not current voters.
				A rounded zero does not establish no switching. Offices share voters and must not be added.</caption>
			<thead><tr><th scope="col">State / 2026 office</th><th scope="col">2024 coalition</th>
				<th scope="col">2024 votes</th><th scope="col">Estimated returning</th>
				<th scope="col">Reported opposite-party choice</th><th scope="col">Apparent absence</th>
				<th scope="col">Absence sensitivity<br />(not a confidence interval)</th></tr></thead>
			<tbody>{review.estimates.flatMap(row => ['R', 'D'].map(prior => {
				const value = row.reference[prior];
				return <tr data-coalition-state={row.state_code} data-coalition-contest={row.contest_code} data-coalition-prior={prior}>
					<th scope="row">{names[row.state_code]} / {office[row.contest_code]}
						{row.turnout_input_qualification && <><br /><small>Unverified all-ballot scope</small></>}</th>
					<td>{prior === 'R' ? 'Trump' : 'Harris'}</td>
					<td>{integer(row.official_2024_baseline[prior])}</td>
					<td>{count(value.returning_count)}</td>
					<td>{count(value.reported_switcher_count)}<br />{pct(value.reported_switchers_pct_of_original_coalition)}</td>
					<td>{count(value.apparent_absence_count)}<br />{pct(value.apparent_absence_pct_of_original_coalition)}
						{value.infeasible_as_closed_original_coalition && <><br />Incompatible with a closed original coalition</>}</td>
					<td>{range(row, prior)}</td>
				</tr>;
			}))}</tbody>
		</table>
	</div>}
	{publishOriginalCoalitionScalars && <p class="caption">Returning = N26 × q; reported switching = N26 × q × p; apparent absence = T24 − N26 × q.
		Absence also includes mortality, migration and source/recall error. It is not a validated nonvoter count.
		No 2026 reweighting to the original Trump–Harris split is imposed.</p>}
	<details class="explorer-notes"><summary>Assumptions, sensitivity and source clocks</summary>
		<p>The archived sensitivity varies the ballot count by factors 1, 1.025 and 1.05 and transfers
			−2, 0 or +2 percentage points of recalled composition from Harris to Trump, preserving their sum.
			These are stress scenarios, not estimated missing ballots or probability intervals.
			They do not exhaust sampling, recall or population uncertainty.</p>
		<p>The complete download additionally includes half-point marginal rounding envelopes and
			response-scope envelopes assuming 0%, 2.5% or 5% of ballot-casters are unrepresented.
			Unrepresented choices are unconstrained; the coalition endpoints cannot be jointly added.
			Unshown choices are not automatically third-party votes or contest abstentions.
			There are no demographic, county or precinct allocations from these state scenarios.</p>
		<ul>{review.estimates.map(row => <li>{names[row.state_code]} {office[row.contest_code]}:
			<a href={row.turnout_source.source_url}>{integer(row.turnout_source.ballots)} reported ballots</a>,
			source update {row.turnout_source.source_update_label};
			<a href={row.survey_source_url}>joint survey</a> at {row.survey_source_timestamp}.</li>)}</ul>
	</details>
	<details class="explorer-notes"><summary>Population-scenario coverage: all 50 states and D.C.</summary>
		<p>Official 2024 coalition totals are available for every jurisdiction. Missing current inputs are not zero.</p>
		<div class="table-wrap" tabindex="0" role="region" aria-label="Nationwide coalition scenario coverage">
			<table><thead><tr><th scope="col">Jurisdiction</th><th scope="col">Frozen ballot-count input</th>
				<th scope="col">Conditional comparisons / next input</th></tr></thead>
				<tbody>{review.jurisdictions.map(row => <tr data-coalition-coverage={row.state_code}>
					<th scope="row">{names[row.state_code]}</th>
					<td>{row.has_existing_full_election_reported_ballots ? 'Reported full-election snapshot'
						: row.has_conditional_native_ballot_snapshot ? 'Native Ballots Cast; scope assumed'
						: 'Not yet in these qualified inputs'}</td>
					<td>{row.conditional_contests.length ? row.conditional_contests.map(code => office[code]).join(', ')
						: row.has_existing_full_election_reported_ballots ? 'Seek applicable joint choice evidence'
						: 'Acquire qualified full-election ballots and match applicable joint evidence'}</td>
				</tr>)}</tbody>
			</table>
		</div>
	</details>
	<div class="download-links">
		<a href={`${base}complete-analysis.zip`} download>Complete archived coalition calculations + source inputs + code (ZIP; unsupported population scalars)</a>
		<a href={`${base}conditional-coalition-scenarios.json`} download>Archived conditional arithmetic + sensitivities, not released population estimates (JSON)</a>
		<a href={`${base}download.json`} download>Scenario archive bytes and SHA-256</a>
		<a href="/participation-coalition-scenarios/20261107-01/complete-analysis.zip" download>Earlier six-state archive (version 01)</a>
		<a href="https://www.fec.gov/documents/5645/2024presgeresults.xlsx">Official FEC 2024 workbook</a>
	</div>
</section>

<style>
	#participation-coalition-scenarios { min-width: 0; margin-block: 1.5rem 2rem; }
</style>
