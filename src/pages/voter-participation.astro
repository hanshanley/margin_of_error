---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/voter-participation.css';

const dataRoot = resolve('public/voter-participation');
const national = JSON.parse(readFileSync(resolve(dataRoot, 'data/national.json'), 'utf8'));
const manifest = JSON.parse(readFileSync(resolve(dataRoot, 'publication-manifest.json'), 'utf8'));
const snapshot = national.filter((row: { year: number; denominator: string; age_group: string }) =>
	row.year === 2024 && row.denominator === 'cvap' && row.age_group === 'All ages');
const labels: Record<string, string> = {
	overall: 'Overall', race: 'Race / ethnicity', education: 'Education', sex: 'Sex',
};
const currentPointer = JSON.parse(readFileSync(resolve(dataRoot, 'data/current/latest.json'), 'utf8'));
const currentPath = `/voter-participation/data/current/${currentPointer.snapshot_id}/`;
const current = JSON.parse(readFileSync(resolve(dataRoot, `data/current/${currentPointer.snapshot_id}/snapshot.json`), 'utf8'));
const currentState = current.reporting.find((row: { county_id: string }) => row.county_id === '0');
const currentRace = current.demographics.filter((row: { county: string; request_type: string; dimension: string }) =>
	row.county === 'STATEWIDE' && row.request_type === 'All methods' && row.dimension === 'race')
	.sort((a: { ballots: number }, b: { ballots: number }) => b.ballots - a.ballots);
const currentMaximum = Math.max(1, ...currentRace.map((row: { ballots: number }) => row.ballots));
const currentSource = (name: string) => current.sources.find((row: { file: string }) => row.file === name);
const formatNumber = (value: number) => value.toLocaleString('en-US');
const formatTime = (value: string) => new Date(value).toLocaleString('en-US', {
	timeZone: 'America/New_York', month: 'long', day: 'numeric', year: 'numeric',
	hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
});
type EarlyRow = { state_code: string; mode: string; geography_level: string; ballots: number;
	source_date: string; source_url: string };
type CoverageRow = { state_code: string; state: string; status: string; demographic_dimensions: string[];
	retained_sources: number; failed_sources: number };
type GroupRow = { state_code: string; mode: string; dimension: string; group: string;
	ballots: number; demographic_source_total: number; source_date: string };
type OfficialRow = { state_code: string; ballots: number; source_url: string; denominator_basis: string;
	source_update_label: string };
const nationwidePointer = JSON.parse(readFileSync(resolve(dataRoot, 'data/nationwide/latest.json'), 'utf8'));
const nationwidePath = `/voter-participation/data/nationwide/${nationwidePointer.snapshot_id}/`;
const nationwide = JSON.parse(readFileSync(resolve(dataRoot, `data/nationwide/${nationwidePointer.snapshot_id}/snapshot.json`), 'utf8'));
const earlyFor = (state: string, mode: string): EarlyRow | undefined => nationwide.early_voting.find(
	(row: EarlyRow) => row.state_code === state && row.mode === mode && row.geography_level === 'state');
const officialFor = (state: string): OfficialRow | undefined => nationwide.reporting.find(
	(row: OfficialRow) => row.state_code === state);
const nationwideRace: GroupRow[] = nationwide.demographics.filter((row: GroupRow) =>
	row.state_code === 'GA' && row.mode === 'in_person_early' && row.dimension === 'race'
	&& row.demographic_source_total > 0).sort((a: GroupRow, b: GroupRow) => b.ballots - a.ballots);
const nationwideMaximum = Math.max(1, ...nationwideRace.map(row => row.ballots));
const groupLabels: Record<string, string> = { age_range: 'Age', gender: 'Gender', race: 'Race', ethnicity: 'Ethnicity' };
const modelValidation = JSON.parse(readFileSync(resolve(dataRoot, 'data/model/validation.json'), 'utf8'));
type ModelScore = { slice: string; value: number; tests: number; model_mae_pp: number; baseline_mae_pp: number };
const modelYears: ModelScore[] = modelValidation.scores.filter((row: ModelScore) => row.slice === 'year');
---

<BaseLayout title="Who participates? Voter turnout across time"
	description="Explore voter participation across presidential and midterm elections, demographic groups, states, and a North Carolina precinct pilot."
	image="/voter-participation/preview.png">
	<div class="participation-page">
		<header class="participation-heading">
			<p class="kicker">Voter participation · 1964–2024 · separate 2026 updates</p>
			<h1>Who participates?</h1>
			<p class="participation-deck">Turnout across elections, populations, and places.
				Not who people vote for, but whether they vote at all.</p>
			<p>Compare demographic groups in national surveys, explore state turnout,
				or look inside North Carolina’s precincts. Presidential and midterm elections
				remain separate, and each view identifies the population behind its percentage.</p>
		</header>
		<p class="participation-scope"><strong>Two different questions.</strong>{' '}
			Census estimates describe participation among adult citizens or all adult residents.
			The NC precinct pilot describes participation among registered voters—not all eligible residents.
			It is not a nationwide precinct map.</p>

		<details class="participation-current participation-model" id="participation-model"
			data-data-root="/voter-participation/data/">
			<summary>Our independent method and reliability tests</summary>
			<p>We use independently acquired public Census and administrative inputs, not NYT model
				estimates, commercial voter files or candidate preferences. The first historical
				prototype did not beat a simple baseline. <strong>No modeled 2026 demographic turnout
				rates are released.</strong></p>
			<p>The prototype transfers each group’s average log-odds turnout gap from three earlier
				same-type elections, using only earlier national turnout. Carry-forward uses the
				group’s last same-type turnout rate. Presidential and midterm elections stay separate.</p>
			<div class="nc-current-controls">
				<label>Validation category<select id="model-dimension" disabled>
					<option value="all">All categories</option><option value="age">Age</option>
					<option value="race">Race / ethnicity</option><option value="sex">Sex</option>
					<option value="education">Education</option>
				</select></label>
			</div>
			<p id="model-summary" aria-live="polite">{modelValidation.summary.tests} historical tests.
				Candidate mean absolute error: {modelValidation.summary.model_mae_pp.toFixed(2)} pp;
				carry-forward: {modelValidation.summary.baseline_mae_pp.toFixed(2)} pp. Lower is better.</p>
			<p>Historical reliability screen: {modelValidation.historical_gate_passed ? 'passed' : 'not passed'}.
				This is a research prototype, not a 2026 estimate.</p>
			<p id="model-error" role="status" hidden></p>
			<div class="table-wrap" tabindex="0" role="region" aria-label="Independent-model historical tests">
				<table><caption>Mean absolute error in percentage points, not uncertainty intervals.</caption>
					<thead><tr><th scope="col">Held-out year</th><th scope="col">Election</th>
						<th scope="col">Tests</th><th scope="col">Candidate error</th>
						<th scope="col">Carry-forward error</th></tr></thead>
					<tbody id="model-rows">{modelYears.map(row => <tr>
						<th scope="row">{row.value}</th>
						<td>{row.value % 4 === 0 ? 'presidential' : 'midterm'}</td>
						<td class="numeric">{row.tests}</td>
						<td class="numeric">{row.model_mae_pp.toFixed(2)}</td>
						<td class="numeric">{row.baseline_mae_pp.toFixed(2)}</td>
					</tr>)}</tbody>
				</table>
			</div>
			<p>These are retrospective year holdouts using current archived CPS tables, not verified historical
				release vintages. Comparison targets are self-reported, not validated turnout. Overlapping
				demographic groups are not independent samples. Current matched inputs and uncertainty
				estimates remain missing; historical patterns alone cannot identify 2026 participation shifts.</p>
			<p>The full method describes separate registered-voter administrative and citizen-population
				survey tracks. A richer public-microdata model is proposed, not already implemented.</p>
			<div class="download-links">
				<a href="/voter-participation/data/model/methodology.md" download>Independent methodology</a>
				<a href="/voter-participation/data/model/backtests.csv" download>Every prediction and error (CSV)</a>
				<a href="/voter-participation/data/model/validation.json" download>Full validation (JSON)</a>
				<a href="/voter-participation/data/model/complete-validation.zip" download>Complete validation + input tables (ZIP)</a>
			</div>
		</details>

		<section class="participation-current" id="nationwide-participation"
			data-data-root="/voter-participation/data/" aria-labelledby="nationwide-title">
			<p class="kicker">November 3, 2026 · nationwide · preliminary</p>
			<h2 id="nationwide-title">Participation updates across states</h2>
			<p id="national-current-asof">Saved nationwide capture: {formatTime(nationwide.retrieved_at)}.
				Source data dates differ and are shown separately; not a live feed.</p>
			<p id="national-current-summary">{nationwide.audit.jurisdictions_with_data} jurisdictions with data;{' '}
				{nationwide.audit.jurisdictions_with_demographic_counts} states with nonzero demographic counts;{' '}
				{nationwide.audit.jurisdictions_with_official_ballots} official administrative ballot feeds.
				All 50 states and DC assessed.</p>
			<p>Counts below describe early participation, not full-election turnout.
				No matched group population denominator is available. Race, ethnicity, gender and age
				counts are not demographic turnout rates, and no national percentage is pooled from them.
				Party affiliation is summed out; no candidate votes or preferences are used.</p>
			<p id="national-current-error" role="status" hidden></p>
			<div class="nc-current-controls">
				<label>State<select id="national-current-state"><option value="GA">Georgia</option></select></label>
				<label>Voting mode<select id="national-current-mode"><option value="in_person_early">In-person early voting</option><option value="mail_returned">Returned mail ballots</option></select></label>
				<label>Demographic counts<select id="national-current-dimension"><option value="race">Race</option></select></label>
			</div>
			<h3 id="national-current-selection">Georgia · in-person early voting</h3>
			<p id="national-current-total">Reported in-person early voting: {earlyFor('GA', 'in_person_early') ? formatNumber(earlyFor('GA', 'in_person_early')!.ballots) : 'Not reported'}.
				Source data date: {earlyFor('GA', 'in_person_early')?.source_date ?? 'Not reported'}.</p>
			<p id="national-current-mode-note">These counts do not cover the full election and are not turnout rates.</p>
			<ul class="nc-current-chart" id="national-current-chart" aria-label="Reported demographic ballot counts">
				{nationwideRace.map(row => <li><span>{row.group}</span><strong>{formatNumber(row.ballots)}</strong>
					<i aria-hidden="true" style={`width:${100 * row.ballots / nationwideMaximum}%`}></i></li>)}
			</ul>
			<p id="national-current-group-note">Demographic source date: {nationwideRace[0]?.source_date ?? 'Not reported'}.
				Counts, not group turnout rates; group definitions differ by state.</p>
			<p id="national-current-official">Official full-election ballots have not been ingested for Georgia.
				Missing is not zero turnout.</p>
			<details open class="national-current-coverage">
				<summary>All 50 states and DC: source coverage and reported counts</summary>
				<div class="table-wrap" tabindex="0" role="region" aria-label="Nationwide participation source coverage">
					<table>
						<caption>Source-specific dates, not a simultaneous national count.
							Administrative ballots overlap early voting: never add the columns.</caption>
						<thead><tr><th scope="col">State</th><th scope="col">In-person early</th>
							<th scope="col">Mail returned</th><th scope="col">Official ballots reported</th>
							<th scope="col">Nonzero demographic data</th><th scope="col">Coverage</th></tr></thead>
						<tbody>{nationwide.coverage.map((row: CoverageRow) => {
							const inperson = earlyFor(row.state_code, 'in_person_early');
							const returned = earlyFor(row.state_code, 'mail_returned');
							const official = officialFor(row.state_code);
							return <tr data-current-state={row.state_code}>
								<th scope="row">{row.state}</th>
								<td>{inperson ? <><a href={inperson.source_url}>{formatNumber(inperson.ballots)}</a><small>{inperson.source_date}</small></> : 'Not reported'}</td>
								<td>{returned ? <><a href={returned.source_url}>{formatNumber(returned.ballots)}</a><small>{returned.source_date}</small></> : 'Not reported'}</td>
								<td>{official ? <><a href={official.source_url}>{formatNumber(official.ballots)}</a>
									<small>{official.denominator_basis.replaceAll('_', ' ')}</small>
									<small>{official.source_update_label}</small></> : 'Not yet ingested'}</td>
								<td>{row.demographic_dimensions.map(value => groupLabels[value]).join(', ') || 'Not reported'}</td>
								<td>{row.status.replaceAll('_', ' ')}
									{row.retained_sources > 0 && <small>Retained after source failure</small>}
									{row.failed_sources > 0 && <small>{row.failed_sources} failed sources</small>}</td>
							</tr>;
						})}</tbody>
					</table>
				</div>
			</details>
			<p>Missing from an assessed provider does not mean unavailable everywhere.
				Undated or all-zero demographic responses are not evidence that no members of a group voted.
				Registered, active-registered and estimated-eligible voter denominators remain distinct.
				No 2026 education or national precinct turnout is inferred.</p>
			<p>Sources: <a href="https://www.civicapi.org/early-vote">civicAPI public aggregate early-vote tracker</a>{' '}
				and verified state election-office administrative reports. civicAPI is not a certified
				government turnout series. The <a href={nationwide.reference_not_ingested.url}>NYT 2026 tracker</a>{' '}
				is a methodological reference only; its estimates are not ingested, republished or used to train our work.</p>
			<div class="download-links">
				<a id="national-current-complete" href={`${nationwidePath}complete-snapshot.zip`} download>Complete nationwide snapshot + original sources (ZIP)</a>
				<a id="national-current-early" href={`${nationwidePath}early_voting.csv`} download>All early-voting observations (CSV)</a>
				<a id="national-current-demographics" href={`${nationwidePath}demographics.csv`} download>All demographic observations (CSV)</a>
				<a id="national-current-reporting" href={`${nationwidePath}reporting.csv`} download>All administrative ballots (CSV)</a>
				<a id="national-current-coverage" href={`${nationwidePath}coverage.csv`} download>All 51 jurisdictions (CSV)</a>
			</div>
		</section>

		<section class="participation-current" id="current-participation"
			data-data-root="/voter-participation/data/" aria-labelledby="current-title">
			<p class="kicker">November 3, 2026 · North Carolina · unofficial</p>
			<h2 id="current-title">Election-night participation reporting</h2>
			<p id="nc-current-asof">Saved snapshot retrieved {formatTime(current.retrieved_at)}. Not a live feed.</p>
			<p id="nc-current-reporting-time">Election-night file updated {formatTime(currentSource('reporting.json').last_modified)}.</p>
			<p id="nc-current-error" role="status" hidden></p>
			<div class="nc-current-controls">
				<label>Reporting geography<select id="nc-current-county"><option value="STATEWIDE">North Carolina statewide</option></select></label>
				<label>Demographic counts<select id="nc-current-dimension"><option value="race">Race</option><option value="ethnicity">Ethnicity</option><option value="sex">Sex</option></select></label>
				<label>Absentee request type<select id="nc-current-method"><option value="All methods">All request types</option></select></label>
			</div>
			<dl class="nc-current-stats">
				<div><dt>Ballots reported so far</dt><dd id="nc-current-ballots">{currentState.ballots_cast > 0 ? formatNumber(currentState.ballots_cast) : 'Not reported'}</dd></div>
				<div><dt>Reported ballots / registered voters</dt><dd id="nc-current-fraction">{currentState.reported_ballot_fraction_pct == null ? 'No validated fraction' : `${currentState.reported_ballot_fraction_pct.toFixed(2)}%`}</dd></div>
				<div><dt>Precincts reporting / total</dt><dd id="nc-current-precincts">{formatNumber(currentState.precincts_reporting)} / {formatNumber(currentState.precincts_total)}</dd></div>
			</dl>
			<p id="nc-current-county-note">Reporting geography: North Carolina.
				Source update label: {currentState.source_update_label}.
				Registered-voter denominator: {formatNumber(currentState.registered_voters)}.</p>
			<p>These are incomplete reporting counts, not final turnout. Precinct reporting is
				not the fraction of all ballots counted.</p>
			<h3>Earlier absentee / early-voting demographic counts</h3>
			<p id="nc-current-absentee-time">Demographic file updated {formatTime(currentSource('absentee-state.csv').last_modified)};
				it does not cover Election Day in-person voting.</p>
			<ul class="nc-current-chart" id="nc-current-chart" aria-label="Reported absentee and early-voting ballot counts">
				{currentRace.map((row: { group: string; ballots: number }) => <li>
					<span>{row.group}</span><strong>{formatNumber(row.ballots)}</strong>
					<i aria-hidden="true" style={`width:${100 * row.ballots / currentMaximum}%`}></i>
				</li>)}
			</ul>
			<p id="nc-current-group-note">{formatNumber(currentRace.reduce((sum: number, row: { ballots: number }) => sum + row.ballots, 0))}
				{' '}reported absentee/early-voting ballots in this selection. Counts, not demographic turnout rates.</p>
			<p>The feeds overlap and have different update times: never add them together.
				No matched group denominator is available here; race, ethnicity and sex counts
				are not turnout rates. No age, education, or precinct-level 2026 turnout is inferred.
				Party affiliation is summed out; no candidate votes are used.</p>
			<p>Sources:{' '}<a href="https://er.ncsbe.gov/">NC election-night reporting</a>{' '}
				and <a href="https://www.ncsbe.gov/results-data/absentee-and-provisional-data">NC aggregate absentee / early-voting files</a>.</p>
			<div class="download-links">
				<a id="nc-current-complete" href={`${currentPath}complete-snapshot.zip`} download>Complete snapshot + original aggregate sources (ZIP)</a>
				<a id="nc-current-demographics" href={`${currentPath}demographics.csv`} download>All demographic observations (CSV)</a>
				<a id="nc-current-reporting-download" href={`${currentPath}reporting.csv`} download>All reporting observations (CSV)</a>
			</div>
		</section>

		<noscript><p class="participation-scope">Interactive controls require JavaScript.
			The 2024 national snapshot, source definitions, and complete downloads below
			remain available without it.</p></noscript>
		<section class="participation-explorer" aria-label="Voter participation explorer">
			<nav aria-label="Participation analysis views">
				<button type="button" data-view="national" class="active">National trends</button>
				<button type="button" data-view="states">State turnout</button>
				<button type="button" data-view="precincts">NC precincts</button>
				<button type="button" data-view="coverage">Coverage</button>
			</nav>
			<div class="controls" aria-label="Data filters">
				<label>Election type<select id="type"><option value="all">Presidential + midterm</option><option value="presidential">Presidential</option><option value="midterm">Midterm</option></select></label>
				<label>Election year<select id="year"></select></label>
				<label id="basis-label">Population denominator<select id="basis"><option value="cvap">Adult citizens (CPS)</option><option value="vap">All adult residents (CPS)</option></select></label>
				<label id="dimension-label">Compare<select id="dimension"></select></label>
				<label id="group-label">Group<select id="group"></select></label>
				<label id="minimum-label" hidden>Minimum registrations<select id="minimum"><option value="1">1</option><option value="25" selected>25</option><option value="100">100</option></select></label>
			</div>
			<p id="measure" class="measure"></p>
			<div id="notice" class="notice" role="status" hidden></div>
			<section class="participation-panel">
				<div class="panel-heading"><div><p id="subtitle" class="eyebrow"></p><h2 id="title">Participation across elections</h2></div><div id="key"></div></div>
				<div id="visualization" aria-live="polite"><p class="empty">Loading the saved analysis. The snapshot and downloads below remain available.</p></div>
				<p id="caption" class="caption"></p>
			</section>
			<details class="participation-panel" id="table-panel">
				<summary>Explore the underlying observations</summary>
				<label class="table-search">Search <input id="search" type="search" placeholder="State, county, precinct, or group" /></label>
				<div class="table-wrap"><table><caption class="sr-only">Observations for the current selection</caption><thead id="table-head"></thead><tbody id="table-body"></tbody></table></div>
				<p id="table-note" class="caption"></p>
			</details>
			<div id="tooltip" role="tooltip" hidden></div>
		</section>

		<details class="participation-reference" id="national-snapshot">
			<summary>Read the 2024 national snapshot</summary>
			<p>Percent of civilian noninstitutionalized adult citizens who reported voting.
				These are CPS survey estimates, not validated individual voting records.
				Race-alone categories overlap Hispanic ethnicity.</p>
			<div class="table-wrap"><table>
				<caption>2024 presidential election · adult citizens</caption>
				<thead><tr><th scope="col">Comparison</th><th scope="col">Group</th><th scope="col">Reported turnout</th></tr></thead>
				<tbody>{snapshot.map((row: { dimension: string; group: string; turnout_pct: number }) => <tr>
					<td>{labels[row.dimension]}</td><td>{row.group}</td><td class="numeric">{row.turnout_pct.toFixed(1)}%</td>
				</tr>)}</tbody>
			</table></div>
		</details>
		<details class="participation-reference" id="definitions">
			<summary>What is being measured?</summary>
			<dl>
				<dt>Adult citizens (CPS)</dt><dd>Civilian noninstitutionalized adults who are citizens.
					This is not a count of the legally eligible population. Turnout is self-reported.</dd>
				<dt>All adult residents (CPS)</dt><dd>The same survey population, including noncitizens.
					Do not compare this denominator directly with citizen turnout.</dd>
				<dt>NC registered voters</dt><dd>Historical voter-history participants divided by election-time
					active and inactive registrations. Voter-history totals differ from official ballots cast;
					the reconciliation download preserves both.</dd>
			</dl>
			<p>National observations extend to 1964 and state observations to 1972, where supported.
				Citizen-based education and sex estimates cover 2000–2024; older education and sex
				series use all adult residents. Race definitions, citizenship measurement, and
				voting-age rules change across the historical series. Chart lines break at the documented transitions.</p>
			<p>NC precinct counts cover 2002–2024. The available election-year map snapshots are
				2006, 2012, 2014, 2016, 2020, 2022, and 2024. Other years do not borrow newer maps.
				Matching a precinct ID is not independent certification of election-day boundaries
				or proof that a precinct stayed unchanged. NC education is not available.</p>
			<p>Missing participation, inconsistent counts, and zero denominators have no displayed rate.
				Unmatched records stay in the downloads. Other states’ precinct sources are{' '}
				<strong>not assessed</strong>, not declared unavailable. State-level CPS estimates
				do not fill those gaps.</p>
			<div id="methods"></div>
		</details>
		<section class="participation-downloads" id="downloads" aria-labelledby="download-title">
			<h2 id="download-title">Data behind the analysis</h2>
			<p>Full observations and geometry, including flagged and unmatched records—not metadata-only exports.</p>
			<div class="download-links">
				<a href="/voter-participation/data/complete-analysis.zip" download>Complete analysis (ZIP)</a>
				<a href="/voter-participation/data/national.csv" download>National series</a>
				<a href="/voter-participation/data/states.csv" download>State series</a>
				<a id="nc-download" href="/voter-participation/data/nc/2024.csv" download>NC 2024 precinct observations</a>
				<a href="/voter-participation/data/coverage.csv" download>Coverage inventory</a>
				<a href="/voter-participation/data/nc/official-reconciliation.csv" download>NC official-total reconciliation</a>
				<a href="/voter-participation/data/sources.json" download>Sources and checksums</a>
			</div>
		</section>
		<p class="participation-sources">Sources:{' '}
			<a href="https://www.census.gov/data/tables/time-series/demo/voting-and-registration/voting-historical-time-series.html">U.S. Census Bureau</a>{' '}
			and <a href="https://www.ncsbe.gov/results-data/voter-history-data">North Carolina State Board of Elections</a>.{' '}
			Candidate vote totals are never used as demographic participation.{' '}
			<a href={`${manifest.source_repository}/tree/${manifest.source_revision}`}>Code, full data, and methods</a>.
		</p>
	</div>
	<script is:inline src="/voter-participation/app.js" defer></script>
	<script is:inline src="/voter-participation/current.js" defer></script>
	<script is:inline src="/voter-participation/nationwide.js" defer></script>
	<script is:inline src="/voter-participation/model.js" defer></script>
</BaseLayout>
