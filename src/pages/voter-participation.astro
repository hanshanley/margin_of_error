---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticipationSwing from '../components/ParticipationSwing.astro';
import ParticipationCountyScenarios from '../components/ParticipationCountyScenarios.astro';
import ParticipationSurvey from '../components/ParticipationSurvey.astro';
import ParticipationIndependentPoll from '../components/ParticipationIndependentPoll.astro';
import ParticipationHouseIntentions from '../components/ParticipationHouseIntentions.astro';
import ParticipationPanelIntentions from '../components/ParticipationPanelIntentions.astro';
import ParticipationRegistrationEntry from '../components/ParticipationRegistrationEntry.astro';
import ParticipationCESClassification from '../components/ParticipationCESClassification.astro';
import ParticipationCPSStateHistory from '../components/ParticipationCPSStateHistory.astro';
import ParticipationCPSOlderHistory from '../components/ParticipationCPSOlderHistory.astro';
import ParticipationCPSEarlyHistory from '../components/ParticipationCPSEarlyHistory.astro';
import ParticipationCPSUnifiedHistory from '../components/ParticipationCPSUnifiedHistory.astro';
import ParticipationColumbiaWisconsinHistory from '../components/ParticipationColumbiaWisconsinHistory.astro';
import ParticipationHamiltonIndianaHistory from '../components/ParticipationHamiltonIndianaHistory.astro';
import ParticipationNorthDakotaHistory from '../components/ParticipationNorthDakotaHistory.astro';
import ParticipationNorthDakotaLongHistory from '../components/ParticipationNorthDakotaLongHistory.astro';
import ParticipationClarkHistory from '../components/ParticipationClarkHistory.astro';
import ParticipationAgeScenarios from '../components/ParticipationAgeScenarios.astro';
import ParticipationStateAgeScenarios from '../components/ParticipationStateAgeScenarios.astro';
import ParticipationCandidateConditionals from '../components/ParticipationCandidateConditionals.astro';
import { participationCurrentRoot } from '../../public/scripts/participation-downloads.js';
import { loadReviewedCountyParticipation, loadReviewedStatewideParticipation } from '../../scripts/reviewed-county-participation.mjs';
import { loadAdditionalParticipation } from '../../scripts/additional-participation.mjs';
import { loadCountyContextReview } from '../../scripts/build-county-participation-context.mjs';
import '../styles/voter-participation.css';

const dataRoot = resolve('public/voter-participation');
const stateDemographics = JSON.parse(readFileSync(
	resolve('data/participation-state-demographics/20261108-01/viewer-data.json'), 'utf8')).rows;
const demographicRelease = 'https://github.com/hanshanley/margin_of_error/releases/download/participation-cps-state-demographics-20261108-01/';
const mapRepairRelease = 'https://github.com/hanshanley/margin_of_error/releases/download/voter-participation-map-repairs-20261107-01/';
const precinctResultsPointerPath = resolve('public/precinct-results.json');
const precinctResultsPointer = existsSync(precinctResultsPointerPath)
	? JSON.parse(readFileSync(precinctResultsPointerPath, 'utf8')) : null;
const precinctSourceReviews = (precinctResultsPointer?.source_reviews ?? []).map((path: string) =>
	JSON.parse(readFileSync(resolve(path), 'utf8')));
const additionalPrecinctSnapshots = precinctResultsPointer?.additional_snapshots ?? [];
const precinctSourceBatches = precinctResultsPointer?.source_batches ?? [];
const countyResultsPointerPath = resolve('public/county-results.json');
const countyResultsPointer = existsSync(countyResultsPointerPath)
	? JSON.parse(readFileSync(countyResultsPointerPath, 'utf8')) : null;
const countyResultsSnapshots = countyResultsPointer
	? [countyResultsPointer, ...(countyResultsPointer.previous_snapshots ?? [])] : [];
const countyIndex = countyResultsPointer
	? JSON.parse(readFileSync(resolve(countyResultsPointer.data_directory, 'index.json'), 'utf8')) : null;
type PartyVotes = { base_url: string; complete_download_url: string; tables: { file: string; label: string }[] };
const countyPartySnapshots: { label: string; party_votes: PartyVotes }[] = countyResultsSnapshots
	.filter((snapshot: { party_votes?: PartyVotes }) => snapshot.party_votes);
const countyPartyAudit = countyResultsPointer?.party_votes
	? JSON.parse(readFileSync(resolve(countyResultsPointer.party_votes.data_directory, 'audit.json'), 'utf8')) : null;
const historicalCountyReview = JSON.parse(readFileSync(
	resolve('data/county-source-reviews/20261105-historical-bulk-01/audit.json'), 'utf8'));
const historicalHousePath = resolve('public/historical-house-counties.json');
const historicalHouse = existsSync(historicalHousePath)
	? JSON.parse(readFileSync(historicalHousePath, 'utf8')) : null;
const historicalHouseSnapshots: (PartyVotes & { label: string })[] = historicalHouse
	? [historicalHouse, ...(historicalHouse.previous_snapshots ?? [])] : [];
const historicalHouseAudit = historicalHouse
	? JSON.parse(readFileSync(resolve(historicalHouse.data_directory, 'audit.json'), 'utf8')) : null;
type HistoricalHouseYear = { year: string; reviewed_states: number; reviewed_counties: number;
	reviewed_candidate_rows: number; withheld_counties: number };
const ufPointerPath = resolve('public/uf-turnout.json');
const ufPointer = existsSync(ufPointerPath) ? JSON.parse(readFileSync(ufPointerPath, 'utf8')) : null;
const ufSnapshots = ufPointer ? [ufPointer, ...(ufPointer.previous_snapshots ?? [])] : [];
type UfRow = { STATE: string; STATE_ABV: string; TOTAL_BALLOTS_COUNTED: number | null;
	SOURCE: string; VEP: number | null; VAP: number | null; VEP_TURNOUT_RATE: number | null;
	VAP_TURNOUT_RATE: number | null; ballots_status: string };
const ufRows: UfRow[] = ufPointer
	? JSON.parse(readFileSync(resolve(ufPointer.data_directory, 'turnout.json'), 'utf8')) : [];
const ufAudit = ufPointer ? JSON.parse(readFileSync(resolve(ufPointer.data_directory, 'audit.json'), 'utf8')) : null;
type ParticipationReview = { id: string; label: string; data_directory: string; base_url: string;
	complete_download_url: string; city_file?: string; city_label?: string; scope_note: string;
	checksums_file?: string;
	tables: { file: string; label: string }[] };
type CityParticipation = { year: number; voters: number; registered_voters: number | null;
	registered_turnout_pct: number | null };
const participationReviewsPath = resolve('public/participation-source-reviews.json');
const participationReviews = existsSync(participationReviewsPath)
	? JSON.parse(readFileSync(participationReviewsPath, 'utf8')).reviews.map((review: ParticipationReview) => ({
		...review, cities: review.city_file
			? JSON.parse(readFileSync(resolve(review.data_directory, review.city_file), 'utf8')) as CityParticipation[] : [],
	})) : [];
const reviewedCounties = loadReviewedCountyParticipation(participationReviews);
const reviewedStates = loadReviewedStatewideParticipation(participationReviews);
const reviewedMeasure = (row: typeof reviewedCounties[number]) =>
	'participation_measure_label' in row ? row.participation_measure_label
		: 'participation_measure_literal' in row ? row.participation_measure_literal : undefined;
const additionalParticipation = loadAdditionalParticipation();
const countyContextReview = loadCountyContextReview([...additionalParticipation.counties, ...reviewedCounties]);
const additionalParticipationStates = [...new Set(additionalParticipation.counties.map(row => row.state_code))]
	.map(code => ({
		code, name: ufRows.find(row => row.STATE_ABV === code)?.STATE ?? code,
		counties: additionalParticipation.counties.filter(row => row.state_code === code),
		units: additionalParticipation.precincts.filter(row => row.state_code === code).length,
		nongeographic: additionalParticipation.nongeographic.filter(row => row.state_code === code),
	}));
const national = JSON.parse(readFileSync(resolve(dataRoot, 'data/national.json'), 'utf8'));
const manifest = JSON.parse(readFileSync(resolve(dataRoot, 'publication-manifest.json'), 'utf8'));
const snapshot = national.filter((row: { year: number; denominator: string; age_group: string }) =>
	row.year === 2024 && row.denominator === 'cvap' && row.age_group === 'All ages');
const labels: Record<string, string> = {
	overall: 'Overall', race: 'Race / ethnicity', education: 'Education', sex: 'Sex',
};
const currentPointer = JSON.parse(readFileSync(resolve(dataRoot, 'data/current/latest.json'), 'utf8'));
const currentPath = `/voter-participation/data/current/${currentPointer.snapshot_id}/`;
const current = JSON.parse(readFileSync(resolve(dataRoot, `data/current/${currentPointer.snapshot_id}/snapshot.json`), 'utf8'));
const currentState = current.reporting.find((row: { county_id: string }) => row.county_id === '0');
const currentRace = current.demographics.filter((row: { county: string; request_type: string; dimension: string }) =>
	row.county === 'STATEWIDE' && row.request_type === 'All methods' && row.dimension === 'race')
	.sort((a: { ballots: number }, b: { ballots: number }) => b.ballots - a.ballots);
const currentMaximum = Math.max(1, ...currentRace.map((row: { ballots: number }) => row.ballots));
const currentSource = (name: string) => current.sources.find((row: { file: string }) => row.file === name);
const formatNumber = (value: number) => value.toLocaleString('en-US');
type EvidenceObservation = { id: string; jurisdiction: string; scope: string; measure: string;
	numerator: number; denominator: number | null; denominator_label: string;
	source_time_label: string; source_url: string; status: string; coverage_note: string;
	history_note: string; previous_numerator: number | null; numeric_change: number | null;
	comparison_note: string };
type EvidenceBatch = { as_of_label: string; observations: EvidenceObservation[];
	colorado_composition: { measure: string; frame_note: string; source_url: string; source_time_label: string;
		age: { group: string; returned_ballots: number }[]; gender: { group: string; returned_ballots: number }[] };
	butler: { current_records: number; cells: { prior_credit: boolean; current_credit: boolean; records: number }[];
		official_2024_ballots: number; current_2024_credits: number;
		official_2026_ballots: number; current_2026_credits: number; frame_note: string; source_url: string };
	complete_download_filename: string };
const latestEvidence: EvidenceBatch = JSON.parse(readFileSync(
	resolve('data/participation-2026-evidence/20261107-01/summary.json'), 'utf8'));
const evidenceDownload = 'https://github.com/hanshanley/margin_of_error/releases/download/'
	+ 'voter-participation-2026-evidence-20261107-01/' + latestEvidence.complete_download_filename;
const formatTime = (value: string) => new Date(value).toLocaleString('en-US', {
	timeZone: 'America/New_York', month: 'long', day: 'numeric', year: 'numeric',
	hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
});
type EarlyRow = { state_code: string; mode: string; geography_level: string; ballots: number;
	source_date: string; source_url: string };
type CoverageRow = { state_code: string; state: string; status: string; demographic_dimensions: string[];
	retained_sources: number; failed_sources: number };
type GroupRow = { state_code: string; mode: string; dimension: string; group: string;
	ballots: number; demographic_source_total: number; source_date: string };
type OfficialRow = { state_code: string; ballots: number; source_url: string; denominator_basis: string;
	source_update_label: string };
const contextPointerPath = resolve('public/participation-context/latest.json');
const contextPointer = existsSync(contextPointerPath) ? JSON.parse(readFileSync(contextPointerPath, 'utf8')) : null;
const nationwidePointer = JSON.parse(readFileSync(resolve(dataRoot, 'data/nationwide/latest.json'), 'utf8'));
const supplementPointerPath = resolve('public/participation-current/latest.json');
const supplementPointer = existsSync(supplementPointerPath) ? JSON.parse(readFileSync(supplementPointerPath, 'utf8')) : null;
const nationwideRoot = supplementPointer ? participationCurrentRoot
	: contextPointer ? `/participation-context/${contextPointer.snapshot_id}/` : '/voter-participation/data/';
const nationwideDirectory = supplementPointer ? `${supplementPointer.snapshot_id}/`
	: contextPointer ? 'nationwide/' : `nationwide/${nationwidePointer.snapshot_id}/`;
const nationwidePath = nationwideRoot + nationwideDirectory;
const nationwideLocalPath = supplementPointer ? `participation-current/${supplementPointer.snapshot_id}/` : nationwidePath.slice(1);
const nationwide = JSON.parse(readFileSync(resolve('public', nationwideLocalPath, 'snapshot.json'), 'utf8'));
type LocalAudit = { state_code: string; counties: number; source_rows: number; precinct_rows: number; rows_with_rate: number };
const localAudit: LocalAudit[] = nationwide.local_audit ?? [];
const earlyFor = (state: string, mode: string): EarlyRow | undefined => nationwide.early_voting.find(
	(row: EarlyRow) => row.state_code === state && row.mode === mode && row.geography_level === 'state');
const officialFor = (state: string): OfficialRow | undefined => nationwide.reporting.find(
	(row: OfficialRow) => row.state_code === state);
const nationwideRace: GroupRow[] = nationwide.demographics.filter((row: GroupRow) =>
	row.state_code === 'GA' && row.mode === 'in_person_early' && row.dimension === 'race'
	&& row.demographic_source_total > 0).sort((a: GroupRow, b: GroupRow) => b.ballots - a.ballots);
const nationwideMaximum = Math.max(1, ...nationwideRace.map(row => row.ballots));
const groupLabels: Record<string, string> = { age_range: 'Age', gender: 'Gender', race: 'Race', ethnicity: 'Ethnicity' };
const modelValidation = JSON.parse(readFileSync(resolve(dataRoot, 'data/model/validation.json'), 'utf8'));
type ModelScore = { slice: string; value: number; tests: number; model_mae_pp: number; baseline_mae_pp: number };
const modelYears: ModelScore[] = modelValidation.scores.filter((row: ModelScore) => row.slice === 'year');
const cpsInputs = JSON.parse(readFileSync(resolve(dataRoot, 'data/cps/inputs.json'), 'utf8'));
type CpsSummary = { year: number; sample_n: number; reported_voting_pct: number; unknown_pct: number };
const cpsObservations = cpsInputs.summaries.reduce((total: number, row: CpsSummary) => total + row.sample_n, 0);
const methodsPointerPath = resolve('public/participation-methods/latest.json');
const methodsPointer = existsSync(methodsPointerPath) ? JSON.parse(readFileSync(methodsPointerPath, 'utf8')) : null;
const methodsPath = methodsPointer ? `/participation-methods/${methodsPointer.snapshot_id}/` : '';
const localPointer = JSON.parse(readFileSync(resolve('public/participation-local.json'), 'utf8'));
const precinctPointer = JSON.parse(readFileSync(resolve('public/participation-precincts.json'), 'utf8'));
const resultsPointer = JSON.parse(readFileSync(resolve('public/participation-results/latest.json'), 'utf8'));
type MethodRow = { year: number; category: string; universe: string; methods: Record<string, number | null> };
const methodOverall: MethodRow[] = methodsPath ? JSON.parse(readFileSync(resolve('public', methodsPath.slice(1), 'national.json'), 'utf8'))
	.filter((row: MethodRow) => row.category === 'Overall').sort((a: MethodRow, b: MethodRow) => a.year - b.year) : [];
---

<BaseLayout title="Who participates? Voter turnout across time"
	description="Explore U.S. voter turnout across presidential and midterm elections, demographic groups and states, with provisional 2026 ballot counts and verified county and precinct result maps."
	image="/artifacts/voter-participation/voter-participation-editorial.png">
	<div class="participation-page" data-active-view="states">
		<header class="participation-heading">
			<p class="kicker">An atlas of voter participation</p>
			<h1>Who participates?</h1>
			<p class="participation-deck">Voter turnout across elections, places and demographic groups.</p>
		</header>

		<nav class="participation-nav" aria-label="Explore participation" role="tablist">
			{[['states', 'States'], ['national', 'Demographics'], ['precincts', 'Precincts'],
				['methods', 'Methods']].map(([view, label]) =>
				<button type="button" id={`tab-${view}`} role="tab" data-view={view}
					aria-selected={view === 'states' ? 'true' : 'false'}
					aria-controls={view === 'methods' ? 'methods-panel' : 'historical-explorer'}
					tabindex={view === 'states' ? 0 : -1}>{label}</button>)}
		</nav>

		<section class="participation-explorer" id="historical-explorer" aria-label="Historical turnout explorer">
			<div class="explorer-toolbar">
				<div class="controls" aria-label="Data filters">
					<label id="state-label">State<select id="state-select"><option>North Carolina</option></select></label>
					<label id="precinct-state-label" hidden>State<select id="precinct-state-select"><option>North Carolina</option></select></label>
					<label id="precinct-layer-label" hidden>Precinct layer<select id="precinct-layer">
						<option value="participation">Participation counts / rates</option>
						<option value="results">Candidate results · red / blue</option>
					</select></label>
					<label id="county-label" hidden>County<select id="precinct-county"><option value="">All counties</option></select></label>
					<label id="precinct-search-label" hidden>Find a precinct<input id="precinct-search" type="search" list="precinct-options" placeholder="ID or precinct name" autocomplete="off" /><datalist id="precinct-options"></datalist></label>
					<label>Year<select id="year"></select></label>
					<label id="map-color-label">Map color<select id="map-color"><option value="turnout" selected>Participation</option><option value="margin">Election results · red / blue</option></select></label>
					<label id="map-level-label">Detail<select id="map-level"><option value="county">Counties / equivalents</option><option value="precinct">Precincts · existing coverage</option><option value="auto">As you zoom</option><option value="district">Congressional districts</option></select></label>
					<label id="current-state-label" hidden>State<select id="current-state-select"></select></label>
					<label id="demographic-state-label" hidden>Geography<select id="demographic-state"><option value="US">United States</option></select></label>
					<label id="mode-label" hidden>2026 measure<select id="mode"></select></label>
					<label id="dimension-label" hidden>Compare<select id="dimension"></select></label>
					<label id="group-label" hidden>Group<select id="group"></select></label>
				</div>
				<details class="explorer-options"><summary>More options</summary>
					<div class="controls">
						<label id="basis-label">Population<select id="basis"><option value="cvap">Adult citizens (CPS)</option><option value="vap">All adult residents (CPS)</option></select></label>
						<label id="minimum-label" hidden>Minimum registrations<select id="minimum"><option value="1">1</option><option value="25" selected>25</option><option value="100">100</option></select></label>
					</div>
				</details>
			</div>
			<div class="explorer-heading"><div><p id="subtitle" class="eyebrow">State turnout · Census survey estimates</p>
				<h2 id="title">Participation across the United States</h2>
				<span id="provisional-status" class="provisional-badge" hidden>Provisional</span></div><div id="key"></div></div>
			<p id="measure" class="measure"></p>
			<div class="explorer-layout">
				<div class="explorer-canvas">
					<div id="map-tools" class="map-tools" hidden aria-label="Map controls">
						<button type="button" id="map-zoom-in" aria-label="Zoom in">+</button>
						<button type="button" id="map-zoom-out" aria-label="Zoom out">−</button>
						<button type="button" id="map-reset" aria-label="Reset map view">Reset</button>
					</div>
					<div id="visualization"><p class="empty">Loading the saved analysis…</p></div>
					<p id="map-help" class="map-help" hidden>Click to select · drag to pan · scroll, pinch or use + / − to zoom</p>
					<p id="geography-note" class="geography-note" role="status" hidden></p>
				</div>
				<aside id="selection-panel" class="selection-panel" aria-live="polite">
					<p class="eyebrow">Explore a state</p><h3>Across the United States</h3>
					<p>Select a state on the map to see its turnout history.</p>
				</aside>
			</div>
			<p id="caption" class="caption"></p>
			<details id="notice-panel" class="explorer-notes" hidden><summary>Data notes for this view</summary>
				<p id="notice" role="status"></p></details>
			<p class="participation-scope" id="coverage-note">Explore national and state turnout histories,
				provisional 2026 ballot counts, and verified county and precinct election-result maps.
				Coverage varies by state and election: not a nationwide precinct map for every year.
				Candidate votes are not turnout.</p>
			<section id="voting-methods" class="voting-methods" aria-labelledby="voting-methods-title" hidden>
				<div class="voting-methods-heading"><div><p class="eyebrow">How ballots were cast</p>
					<h2 id="voting-methods-title">Voting methods</h2></div>
					<div class="controls">
						<label id="method-group-label">Survey group<select id="method-group"></select></label>
					</div>
				</div>
				<p id="method-definition" class="measure"></p>
				<div class="method-layout"><div id="method-observations"></div><div>
					<label class="method-history-control">Method over time<select id="method-history-mode"></select></label>
					<div id="method-history"></div><p id="method-history-note" class="caption"></p>
				</div></div>
				<details class="explorer-notes"><summary>Reporting definitions, gaps & complete records</summary>
					<p id="method-note" class="caption"></p>
					<p id="method-source-notes"></p><div id="method-downloads" class="download-links"></div>
				</details>
			</section>
			<details class="participation-panel" id="table-panel">
				<summary>View the underlying observations</summary>
				<label class="table-search">Search <input id="search" type="search" placeholder="State, county, precinct, or group" /></label>
				<div class="table-wrap"><table><caption class="sr-only">Observations for the current selection</caption><thead id="table-head"></thead><tbody id="table-body"></tbody></table></div>
				<p id="table-note" class="caption"></p>
			</details>
			<div id="tooltip" role="tooltip" hidden></div>
		</section>
			<noscript><details class="participation-reference" id="state-demographic-snapshot">
				<summary>Every-state historical participation, 2022 and 2024</summary>
				<p>Reported voting among all source-weighted adult citizens, including unknown responses.
					Separate CPS cross-sections, not administrative turnout, fixed cohorts or 2026 estimates.
					The complete CSV also contains every age, sex, education and exclusive race/Hispanic-origin group.</p>
				<div class="table-wrap"><table>
					<caption>All 50 states plus D.C. · source-weighted CPS participation</caption>
					<thead><tr><th scope="col">State</th><th scope="col">Year</th><th scope="col">Reported voting</th>
						<th scope="col">Unknown</th><th scope="col">Source cases</th></tr></thead>
					<tbody>{stateDemographics.filter((row: { dimension: string }) => row.dimension === 'overall')
						.map((row: { state_code: string; state_name: string; year: string; reported_voting_pct: string;
							unknown_pct: string; sample_n: string }) => <tr data-demographic-state={row.state_code} data-year={row.year}
								data-rate={row.reported_voting_pct} data-unknown={row.unknown_pct} data-sample-n={row.sample_n}>
							<th scope="row">{row.state_name}</th><td>{row.year}</td>
							<td>{Number(row.reported_voting_pct).toFixed(1)}%</td>
							<td>{Number(row.unknown_pct).toFixed(1)}%</td><td>{row.sample_n}</td>
						</tr>)}</tbody>
				</table></div>
				<div class="download-links">
					<a href={`${demographicRelease}complete-analysis.zip`} download>Complete all-state inputs, code and queries (ZIP)</a>
					<a href={`${demographicRelease}complete-state-demographic-participation.csv`} download>Every state and demographic estimate (CSV)</a>
				</div>
			</details></noscript>

		<details id="participation-research" class="participation-reference">
			<summary>Research studies &amp; experimental models</summary>
			<p>Historical source studies, local case studies and assumption-dependent estimates.
				Local findings do not establish nationwide coverage, and modeled switching is not
				observed individual persuasion. Each study retains its own scope, limitations and complete data.</p>
			<ParticipationColumbiaWisconsinHistory />
			<ParticipationCPSUnifiedHistory />
			<ParticipationCPSEarlyHistory />
			<ParticipationCPSOlderHistory />
			<ParticipationCPSStateHistory />
			<ParticipationHamiltonIndianaHistory />
			<ParticipationCESClassification />
			<ParticipationRegistrationEntry />
			<ParticipationCountyScenarios version="20261107-02" />
			<ParticipationSwing />
			<ParticipationCountyScenarios />
			<ParticipationStateAgeScenarios />
			<ParticipationAgeScenarios />
			<ParticipationCandidateConditionals />
			<ParticipationIndependentPoll />
			<ParticipationPanelIntentions />
			<ParticipationHouseIntentions />
			<ParticipationClarkHistory />
			<ParticipationNorthDakotaLongHistory />
			<ParticipationNorthDakotaHistory />
			<ParticipationSurvey />
		</details>

		<section id="methods-panel" class="participation-secondary" data-section="methods" role="tabpanel"
			aria-labelledby="tab-methods" tabindex="0">
		<div class="methods-overview">
			<header class="section-intro"><p class="kicker">How we estimate participation</p><h2 id="methods-heading">Methods</h2>
				<p>We estimate participation by demographic group from weighted surveys and compare
					it with election records. Observed counts, self-reported voting and modeled
					participation stay distinct.</p></header>
			<ul>
				<li><strong>Estimate rates.</strong> Use each study's published weights and original
					participation definitions, retaining missing or unknown responses.</li>
				<li><strong>Match the population.</strong> Convert rates to counts only with a matching
					denominator and explicit assumptions. Candidate votes are not ballots.</li>
				<li><strong>Check comparisons.</strong> Keep presidential and midterm histories
					separate; test historical projections against simple baselines.</li>
				<li><strong>Respect geography.</strong> Map precinct participation only with supported
					election-year counts and boundaries. Never allocate state survey estimates to precincts.</li>
			</ul>
			<p><a id="methods-github-link" href={`${manifest.source_repository}/blob/main/METHODOLOGY.md`}>
				Estimation methods, assumptions and complete data on GitHub</a>.</p>
		</div>
		<div id="methods-archive" class="methods-archive">
