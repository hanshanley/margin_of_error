---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Interactive analysis"
	description="Interactive data and evidence on congressional language and social, economic, and political change in the United Kingdom."
>
	<section class="standard-page">
		<header class="page-heading">
			<h1>Interactive analysis</h1>
		</header>
		<ul class="analysis-list">
			<li>
				<a
					class="analysis-preview"
					href="https://www.themarginoferror.com/congressional_profanity/"
					tabindex="-1"
					aria-hidden="true"
				>
					<img
						src="/artifacts/congressional-record/profanity_per_1k_last50.png"
						alt=""
						width="1959"
						height="1093"
						loading="eager"
						decoding="async"
					/>
				</a>
				<div>
					<h2><a href="https://www.themarginoferror.com/congressional_profanity/">The language of Congress</a></h2>
					<p>
						Compare profanity, slurs, and formal courtesy in House and Senate floor
						speeches. Explore historical trends and see which members use the most profanity.
					</p>
					<div class="lead-actions">
						<a class="primary-action" href="https://www.themarginoferror.com/congressional_profanity/">Open analysis</a>
						<a href="/floor-letter-words-the-rise-of-congressional-profanity/">Read the essay</a>
					</div>
				</div>
			</li>
			<li>
				<a
					class="analysis-preview"
					href="https://www.themarginoferror.com/uk_decline/"
					tabindex="-1"
					aria-hidden="true"
				>
					<img
						src="https://www.themarginoferror.com/uk_decline/outputs/uk_decline_scorecard.png"
						alt=""
						width="3307"
						height="1803"
						loading="lazy"
						decoding="async"
					/>
				</a>
				<div>
					<h2><a href="https://www.themarginoferror.com/uk_decline/">The UK, in context</a></h2>
					<p>
						Explore economic change, public services, household pressures, and institutions
						across the United Kingdom. Browse the charts, definitions, and sources behind
						each topic.
					</p>
					<div class="lead-actions">
						<a class="primary-action" href="https://www.themarginoferror.com/uk_decline/">Open analysis</a>
					</div>
				</div>
			</li>
		</ul>
	</section>
</BaseLayout>
