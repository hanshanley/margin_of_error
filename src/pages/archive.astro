---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { comparePostsNewestFirst, getPostPath } from '../lib/posts';
import { formatFrenchRepublicanDate } from '../lib/french-republican-calendar';
import externalArticles from '../data/external-articles.json';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(comparePostsNewestFirst);
---

<BaseLayout title="Archive" description="Every dispatch published in The Margin of Error.">
	<section class="standard-page archive-page">
		<header class="page-heading">
			<p class="kicker">Complete index</p>
			<h1>The archive</h1>
		</header>
		<ol class="archive-list">
			{posts.map((post) => (
				<li>
					<p>
						{post.data.publishedAt ? (
							<time class="archive-date" datetime={post.data.publishedAt.toISOString()}>
								<span>
									{post.data.publishedAt.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
										timeZone: 'UTC',
									})}
								</span>
								<span>{formatFrenchRepublicanDate(post.data.publishedAt)}</span>
							</time>
						) : (
							'—'
						)}
					</p>
					<a
						class="archive-thumb"
						href={getPostPath(post)}
						tabindex="-1"
						aria-hidden="true"
					>
						{post.data.thumbnail || post.data.hero ? (
							<img
								src={(post.data.thumbnail ?? post.data.hero)?.src}
								alt=""
								width={post.data.thumbnail?.width}
								height={post.data.thumbnail?.height}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<span aria-hidden="true">±</span>
						)}
					</a>
					<div>
						<h2><a href={getPostPath(post)}>{post.data.title}</a></h2>
						{post.data.subtitle && <p class="archive-subtitle">{post.data.subtitle}</p>}
						<p>{post.data.description}</p>
					</div>
					<p>{post.data.tags.join(', ')}</p>
				</li>
			))}
		</ol>
		<section class="external-archive" aria-labelledby="external-title">
			<header class="section-heading">
				<p class="kicker">Fieldwork elsewhere</p>
				<h2 id="external-title">Published with DFRLab</h2>
				<p>{String(externalArticles.length).padStart(2, '0')} external pieces</p>
			</header>
			<ol class="external-list">
				{
					externalArticles.map((article) => (
						<li>
							<time datetime={article.publishedAt}>
								<span>
									{new Date(`${article.publishedAt}T12:00:00Z`).toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
										timeZone: 'UTC',
									})}
								</span>
								<span>
									{formatFrenchRepublicanDate(new Date(`${article.publishedAt}T12:00:00Z`))}
								</span>
							</time>
							<div>
								<h3><a href={`/fieldwork/${article.slug}/`}>{article.title}</a></h3>
								<p>{article.authors} · {article.outlet}</p>
								<a class="external-read" href={article.url}>Read on DFRLab ↗</a>
							</div>
						</li>
					))
				}
			</ol>
		</section>
	</section>
</BaseLayout>
