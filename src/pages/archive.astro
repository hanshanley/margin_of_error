---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { comparePostsNewestFirst } from '../lib/posts';
import externalArticles from '../data/external-articles.json';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(comparePostsNewestFirst);
---

<BaseLayout title="Archive" description="Every dispatch published in The Margin of Error.">
	<section class="standard-page archive-page">
		<header class="page-heading">
			<p class="kicker">Complete index</p>
			<h1>The archive</h1>
			<p>Writing on systems, evidence, politics, and the places where they collide.</p>
		</header>
		<ol class="archive-list">
			{posts.map((post) => (
				<li>
					<p>{post.data.publishedAt?.getFullYear() ?? '—'}</p>
					<a
						class="archive-thumb"
						href={post.data.legacyPath ?? `/${post.id}`}
						tabindex="-1"
						aria-hidden="true"
					>
						{post.data.thumbnail || post.data.hero ? (
							<img
								src={(post.data.thumbnail ?? post.data.hero)?.src}
								alt=""
								width={post.data.thumbnail?.width}
								height={post.data.thumbnail?.height}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<span aria-hidden="true">±</span>
						)}
					</a>
					<div>
						<h2><a href={post.data.legacyPath ?? `/${post.id}`}>{post.data.title}</a></h2>
						<p>{post.data.description}</p>
					</div>
					<p>{post.data.tags.join(', ')}</p>
				</li>
			))}
		</ol>
		<section class="external-archive" aria-labelledby="external-title">
			<header class="section-heading">
				<p class="kicker">Fieldwork elsewhere</p>
				<h2 id="external-title">Published with DFRLab</h2>
				<p>{String(externalArticles.length).padStart(2, '0')} external pieces</p>
			</header>
			<ol class="external-list">
				{
					externalArticles.map((article) => (
						<li>
							<time datetime={article.publishedAt}>
								{new Date(`${article.publishedAt}T12:00:00Z`).toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'short',
									day: 'numeric',
									timeZone: 'UTC',
								})}
							</time>
							<div>
								<h3><a href={`/fieldwork/${article.slug}/`}>{article.title}</a></h3>
								<p>{article.authors} · {article.outlet}</p>
								<a class="external-read" href={article.url}>Read on DFRLab ↗</a>
							</div>
						</li>
					))
				}
			</ol>
		</section>
	</section>
</BaseLayout>
