---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformFigure from '../components/PlatformFigure.astro';
import { platforms as data, organizations, platformFigure, initialIssue, platformPreview } from '../lib/platform-analysis';

const source = `https://github.com/hanshanley/dsa/tree/${data.source_revision}`;
const number = (value: number) => value.toLocaleString('en-US');
const share = (topic: typeof data.topics[number], view: string, group: string) =>
	topic.shares.find((row) => row.view === view && row.group === group);
const percent = (topic: typeof data.topics[number], view: string, group: string) => {
	const row = share(topic, view, group);
	return row?.available === 'True' ? `${(100 * Number(row.share)).toFixed(1)}%` : 'Not observed';
};
const totalDocuments = Object.values(data.summary.documents_by_group).reduce((a, b) => a + b, 0);
const archive = data.downloads.find((entry) => entry.path.endsWith('claim_documents.zip'))!;
const issueTopics = data.topics;
---

<BaseLayout title="National party platforms"
	description="Compare the topics, relative emphasis, source evidence, and historical coverage of Democratic, Republican, and DSA national documents."
	image={`/party-platforms/${platformPreview.display_path ?? platformPreview.path}`}>
	<div class="platform-page">
		{data.preview_only && <p class="qualification" role="status">Local development preview, not a
			verified publication. Charts and period discoveries are drafts; the combined archive
			still contains the previous committed snapshot. Do not publish this build.</p>}
		<header class="page-heading">
			<p class="kicker">National documents, 2000&ndash;2026</p>
			<h1>National party platforms</h1>
			<p class="intro">What do Democratic, Republican, and DSA national documents emphasize?
				Explore their subjects, how emphasis differs, and how the observed documents change over time.</p>
			<p class="scope">{number(data.summary.claims)} analyzed claims &middot; {totalDocuments} documents
				&middot; {data.topics.length} pooled topics &middot; Cutoff: October 26, 2026</p>
		</header>

		<nav class="section-nav" aria-label="Analysis sections">
			<a href="#issues">Compare an issue</a><a href="#overview">Coverage</a>
			<a href="#sensitivity">Adopted-only sensitivity</a>
			<a href="#time">Changes over time</a>
			{data.evolution && <a href="#period-topics">Period discoveries</a>}
			<a href="#topics">Claims and sources</a>
			<a href="#methods">Methods</a><a href="#downloads">Downloads</a>
		</nav>

		<p class="qualification">These are comparisons of language and attention, not policy agreement,
			ideological distance, causal change, or fact-checks. The expanded view includes explicitly
			labeled DSA national resolutions and statements; the adopted-only view excludes them.
			The separate Libertarian expansion is not included in this completed release.</p>

		<section id="issues" aria-labelledby="issues-title">
			<h2 id="issues-title">Compare an issue</h2>
			<p>One subject at a time, with the three organizations in the same chart. Choose overall
				emphasis or changes over observed document periods. These learned topics include
				political narratives as well as policy subjects; shared language does not mean shared positions.</p>
			<div id="issue-picker" class="issue-picker" hidden>
				<label>Subject
					<select id="issue-topic">
						{issueTopics.map(topic => (
							<option value={topic.topic_id} selected={topic.topic_id === initialIssue.topic_id}>{topic.title}</option>
						))}
					</select>
				</label>
				<label>Comparison
					<select id="issue-kind"><option value="overall">Overall emphasis</option>
						<option value="time">Over time</option></select>
				</label>
				<label>Source scope
					<select id="issue-view"><option value="expanded">Expanded corpus</option>
						<option value="strict">Adopted platforms/programs only</option></select>
				</label>
			</div>
			{issueTopics.map(topic => (
				<details class="issue-panel" data-topic={topic.topic_id}
					id={`issue-${topic.topic_id}`} open={topic.topic_id === initialIssue.topic_id}>
					<summary>{topic.title}</summary>
					<p>{topic.summary}</p>
					<p class="caveat">{topic.caveat}</p>
					{['expanded', 'strict'].map(view => ['overall', 'time'].map(kind => (
						<details class="issue-chart" data-view={view} data-kind={kind}
							open={view === 'expanded' && kind === 'overall'}>
							<summary>{view === 'expanded' ? 'Expanded corpus' : 'Adopted platforms/programs only'}:
								{kind === 'overall' ? ' overall emphasis' : ' over time'}</summary>
							<PlatformFigure figure={platformFigure(`${view}/issues`, `${topic.topic_id}_${kind}`)}
								caption={`${topic.title}: ${kind === 'overall' ? 'overall document-weighted shares' : 'observed-period shares with missing evidence left as gaps'}, ${view} view.`} />
						</details>
					)))}
					<p><a href={`#${topic.topic_id}`}>Read this topic's representative claims and exact source evidence</a></p>
				</details>
			))}
			<noscript><p>Without JavaScript, expand any subject above to open its four comparison charts.</p></noscript>
		</section>

		<section id="overview" aria-labelledby="overview-title">
			<h2 id="overview-title">Coverage and overall emphasis</h2>
			<p>Each organization receives its own normalized distribution. Documents and predefined DSA
				fallback-period bundles receive equal weight within an organization; the number of extracted
				claims does not determine an organization's weight.</p>
			<div class="party-summaries">
				{organizations.map((group) => (
					<div>
						<h3>{group.name}</h3>
						<p class="coverage">{number(data.summary.claims_by_group[group.id])} claims;
							{data.summary.documents_by_group[group.id]} documents;
							{data.summary.bundles_by_group[group.id]} weighting bundles</p>
						<ol>
							{[...data.topics].sort((a, b) =>
								Number(share(b, 'expanded', group.id)?.share) -
								Number(share(a, 'expanded', group.id)?.share)
							).slice(0, 3).map((topic) => (
								<li><a href={`#${topic.topic_id}`}>{topic.title}</a>
									<span class="topic-percent">{percent(topic, 'expanded', group.id)}</span></li>
							))}
						</ol>
					</div>
				))}
			</div>
			<p>Relative emphasis compares each organization's share with the equally weighted average
				of the other two. A value of +1 indicates twice the smoothed share; &minus;1 indicates half.
				Pairwise comparisons use the same topic taxonomy. Neither comparison establishes agreement.</p>
			<details>
				<summary>Supporting all-topic comparisons, in readable pages</summary>
				{data.figures.filter(figure => figure.view === 'expanded').map(figure => (
					<PlatformFigure figure={figure}
						caption={`Expanded corpus: ${figure.name.replaceAll('_', ' ')}. These are exploratory language-emphasis comparisons.`} />
				))}
			</details>
		</section>

		<section id="sensitivity" aria-labelledby="sensitivity-title">
			<h2 id="sensitivity-title">Adopted-platform-only sensitivity</h2>
			<p>This view retains adopted platforms and programs only. It uses the same learned topic
				assignments as the expanded comparison, so changes reflect source composition rather than
				a newly fitted taxonomy. DSA coverage falls from 122 documents to three platforms/programs;
				the Democratic and Republican sources are unchanged.</p>
			<p>The strict view contains {number(Object.values(data.summary.views.strict.group_passages)
				.reduce((a, b) => a + b, 0))} claims. It is not a matched historical panel or a correction
				for all genre and period differences.</p>
			<details>
				<summary>Show adopted-only shares and relative-emphasis charts</summary>
				{data.figures.filter(figure => figure.view === 'strict').map(figure => (
					<PlatformFigure figure={figure}
						caption={`Adopted platforms/programs only: ${figure.name.replaceAll('_', ' ')}.`} />
				))}
			</details>
		</section>

		<section id="time" aria-labelledby="time-title">
			<h2 id="time-title">Changes over time</h2>
			<p>Seven four-year bins describe documents actually observed in each period; 2024&ndash;2026
				is partial through October 26. Adoption dates are used when recorded, otherwise publication
				dates, retaining source precision. Missing periods remain gaps. Reused platforms, including
				the Republican Party's 2020 reuse of its 2016 platform, are not new independent observations.</p>
			<p>Shares describe within-organization attention. Relative emphasis requires observations for
				both other organizations in that period; missing comparators remain unavailable, rather than
				changing the baseline. DSA's earlier fallback documents are not equivalent to a continuous
				series of adopted platforms.</p>
			<p><a href="#issues" data-show-timeline>Choose an issue above and view its timeline</a>.
				The same pooled topic definitions are used across periods. Independent period-specific
				topic discovery is a separate analysis below, not the same timeline.</p>
		</section>

		{data.evolution && (
			<section id="period-topics" aria-labelledby="period-topics-title">
				<h2 id="period-topics-title">Discovering themes within each period</h2>
				<p>The timelines above hold one taxonomy fixed. This complementary analysis fits PCA,
					clustering, and keywords independently within each period, allowing the themes and
					cluster counts to differ. It finds {data.evolution.summary.topics} period-qualified
					topics; numeric topic IDs do not identify the same issue across different fits.</p>
				<p>{data.evolution.summary.reviewed_labels} of these {data.evolution.summary.topics}
					period-specific labels are marked evidence-reviewed in the source release.
					Unreviewed labels remain explicitly identified as unreviewed model outputs;
					their representative claims and source excerpts are available below.</p>
				<p>Adjacent-period centroid matches are candidate thematic similarities, not proof of
					emergence, disappearance, splits, merges, stance change, or causal change.
					Unclustered claims remain visible. In 2004&ndash;2007 and 2008&ndash;2011, only two
					substantive density clusters are retained and about 44% of claims are unclustered.</p>
				{data.evolution.periods.map((period) => (
					<details class="period">
						<summary>{period.period}: {period.topics} independently discovered topics</summary>
						<p>{number(period.claims)} claims from {period.documents} documents.
							Observed organizations: {period.groups_present.map((id) =>
								organizations.find((group) => group.id === id)?.name ?? id).join(', ')}.
							Fit: {period.fit.selected_parameters.method};
							{(100 * period.fit.selected_parameters.coverage).toFixed(1)}% assigned to substantive clusters;
							cosine silhouette {period.fit.selected_parameters.cosine_silhouette.toFixed(3)}.</p>
						<PlatformFigure figure={platformFigure('evolution/expanded', `period_${period.period}`)}
							caption={`${period.period}: independently fitted topic shares, expanded corpus; unclustered claims retained.`} />
						<details>
							<summary>Adopted-only sensitivity within this period</summary>
							<PlatformFigure figure={platformFigure('evolution/strict', `period_${period.period}`)}
								caption={`${period.period}: adopted-only shares using this period's expanded-corpus taxonomy.`} />
						</details>
						{data.evolution!.topics.filter((topic) =>
							topic.topic_id.startsWith(`period-${period.period_start}-`)
						).map((topic) => (
							<details class="period-topic" id={topic.topic_id}>
								<summary>{topic.title}</summary>
								<p>{topic.summary}</p><p class="caveat">{topic.caveat}</p>
								<p class="label-origin">Label provenance:
									{topic.label_origin === 'assistant_source_bound_revision'
										? ' assistant source-bound revision.' : ' original local Gemma wording.'}
									{topic.review_status === 'evidence_reviewed'
										? ' Evidence-reviewed against its packet.' : ' Unreviewed model label.'}
									Not independent human gold.</p>
								{topic.representatives.map((claim) => (
									<div class="claim">
										<p class="claim-source"><a href={claim.source_url}>{claim.title}</a></p>
										<p>{claim.claim_text}</p>
										<details><summary>Source excerpt and identifier</summary>
											<blockquote>{claim.evidence}</blockquote>
											<p class="locator">{claim.locator}<br /><code>{claim.claim_id}</code></p>
										</details>
									</div>
								))}
							</details>
						))}
					</details>
				))}
				<p><a href="/party-platforms/downloads/topics/evolution/shares.csv">Period-specific shares</a>
					&middot; <a href="/party-platforms/downloads/topics/evolution/coverage.csv">Source coverage</a>
					&middot; <a href="/party-platforms/downloads/topics/evolution/period_fits.json">Fit diagnostics</a>
					&middot; <a href="/party-platforms/downloads/topics/evolution/adjacent_matches.csv">Qualified adjacent-period matches</a></p>
			</section>
		)}

		<section id="topics" aria-labelledby="topics-title">
			<h2 id="topics-title">Claims and sources</h2>
			<p>Expand a topic to inspect its summary, qualifications, shares, and representative claims.
				These bounded representative packets are not the complete corpus. Claims are normalized
				model or source-repair text; source excerpts are shown separately and do not independently
				verify an organization's assertions.</p>
			<div id="topic-filter" hidden>
				<label for="topic-query">Search these topic summaries and representative claims</label>
				<input id="topic-query" type="search" placeholder="For example: housing or collective bargaining" />
				<p id="topic-results" role="status" aria-live="polite"></p>
			</div>
			<div id="topic-list">
				{data.topics.map((topic) => (
					<details class="topic" id={topic.topic_id}>
						<summary>{topic.title}</summary>
						<p>{topic.summary}</p>
						<p class="caveat">{topic.caveat}</p>
						<p class="label-origin">Label provenance:
							{topic.label_origin === 'assistant_source_bound_revision'
								? 'Assistant source-bound revision of the model label.'
								: 'Unedited local Gemma label.'}
							Reviewed against this bounded evidence packet, not independent human gold.</p>
						<div class="table-wrap">
							<table>
								<caption>Document-weighted shares; claim counts are unweighted</caption>
								<thead><tr><th>Organization</th><th>Expanded</th><th>Adopted only</th><th>Expanded claims</th></tr></thead>
								<tbody>{organizations.map((group) => (
									<tr><th scope="row">{group.name}</th>
										<td>{percent(topic, 'expanded', group.id)}</td>
										<td>{percent(topic, 'strict', group.id)}</td>
										<td>{number(Number(share(topic, 'expanded', group.id)?.claims ?? 0))}</td>
									</tr>
								))}</tbody>
							</table>
						</div>
						{topic.representatives.map((claim) => (
							<div class="claim">
								<p class="claim-source"><a href={claim.source_url}>{claim.title}</a>
									&middot; {claim.publication_date}</p>
								<p>{claim.claim_text}</p>
								<details>
									<summary>Source excerpt and claim identifier</summary>
									<blockquote>{claim.evidence}</blockquote>
									<p class="locator">{claim.locator}<br /><code>{claim.claim_id}</code></p>
								</details>
							</div>
						))}
					</details>
				))}
			</div>
		</section>

		<section id="methods" aria-labelledby="methods-title">
			<h2 id="methods-title">Methods and limits</h2>
			<p>National documents only, January 1, 2000 through October 26, 2026. Candidate, state, and
				local material is excluded. Historical reproductions and DSA fallback evidence retain their
				source classifications in the complete-source download. Uncertain adoption is not silently
				treated as an adopted platform.</p>
			<p>The completed corpus contains 26,483 eligible claims. All 2,623 extraction chunks were
				attempted; the original 27 model-validation failures and all model replies remain preserved.
				Targeted source repairs cover {data.summary.corpus.assistant_source_repaired_blocks} chunks.
				Screening and source repairs are not a representative error estimate or independent fact-check.</p>
			<p>Weighted K-means selected 24 topics after low HDBSCAN coverage, using pinned MiniLM
				claim embeddings and 50-component PCA. Retained variance is 59.9%; cosine silhouette is
				0.058. Balanced-refit adjusted Rand indices are 0.628 and 0.606. This is an exploratory,
				imperfect partition, not evidence that these are the only or definitive policy categories.</p>
			<p>All 24 labels were reviewed against representative packets;
				{data.topic_summary.assistant_revised_labels} were revised by the assistant with explicit
				source-bound attribution. The remaining labels preserve the original Gemma wording.
				Review is not a claim-by-claim certification. Original replies and label failures remain auditable.</p>
			<p>Relative emphasis is log2((share + 0.0001) / (baseline share + 0.0001)).
				The one-versus-rest baseline gives equal weight to the other organizations, not to pooled
				claim counts. Small shares can produce large ratios. Topic similarity does not imply the
				same stance, and differences can reflect document genre, date, and coverage.</p>
			<p>The full report also retains the separate GTE/UMAP/KDE semantic-density analysis as
				supporting evidence. Its strict and expanded spaces are fitted separately and their
				coordinates are not directly comparable. Offline replay verifies artifact reproduction,
				not semantic truth.</p>
			<p><a href="/party-platforms/downloads/methods-and-results.md">Full methods and results (Markdown)</a>
				&middot; <a href={source}>Pinned source code and provenance</a>
				&middot; <a href="/party-platforms/downloads/topics/replay_audit.json">Offline replay audit</a></p>
		</section>

		<section id="downloads" aria-labelledby="downloads-title">
			<h2 id="downloads-title">Complete downloads</h2>
			<p><a class="primary-action" href="/party-platforms/downloads/claim_documents.zip">
				Complete combined archive ({(archive.bytes / 1024 / 1024).toFixed(1)} MB)</a></p>
			<p>The archive includes actual analyzed claims, complete extracted sources, original
				candidates and inference history, topic tables, figures, and provenance. The individual
				claim files below contain text and evidence, not metadata-only records.</p>
			<ul class="download-list">
				<li><a href="/party-platforms/downloads/analysis_claims.csv">All analyzed claims, wording, evidence, and provenance (CSV)</a></li>
				<li><a href="/party-platforms/downloads/complete_sources.csv">Complete source text and source classifications (CSV)</a></li>
				<li><a href="/party-platforms/downloads/claims.csv">All preserved candidates, including superseded and excluded records (CSV)</a></li>
				<li><a href="/party-platforms/downloads/claims.jsonl">All preserved candidates (JSONL)</a></li>
				<li><a href="/party-platforms/downloads/topics/shares.csv">Expanded and strict topic shares (CSV)</a></li>
				<li><a href="/party-platforms/downloads/topics/contrasts.csv">Pairwise and one-versus-rest contrasts (CSV)</a></li>
				<li><a href="/party-platforms/downloads/topics/temporal_shares.csv">Observed-period topic shares (CSV)</a></li>
				<li><a href="/party-platforms/downloads/topics/temporal_contrasts.csv">Observed-period relative emphasis (CSV)</a></li>
				<li><a href="/party-platforms/downloads/topics/temporal_coverage.csv">Temporal coverage and gaps (CSV)</a></li>
				<li><a href="/party-platforms/downloads/topics/topic_labels.json">Reviewed topic labels and provenance (JSON)</a></li>
				<li><a href="/party-platforms/downloads/topics/representatives.csv">Representative claims and exact source locators (CSV)</a></li>
			</ul>
			<p class="revision">Source checkpoint <a href={source}><code>{data.source_revision}</code></a>.
				<a href="/party-platforms/publication-manifest.json">Publication manifest and original-file SHA-256 checksums</a>.</p>
		</section>
	</div>
</BaseLayout>

<script>
	const issuePicker = document.querySelector<HTMLElement>('#issue-picker')!;
	const issueTopic = document.querySelector<HTMLSelectElement>('#issue-topic')!;
	const issueKind = document.querySelector<HTMLSelectElement>('#issue-kind')!;
	const issueView = document.querySelector<HTMLSelectElement>('#issue-view')!;
	const issuePanels = [...document.querySelectorAll<HTMLDetailsElement>('.issue-panel')];
	const updateIssue = () => {
		for (const panel of issuePanels) {
			panel.hidden = panel.dataset.topic !== issueTopic.value;
			if (!panel.hidden) panel.open = true;
			for (const chart of panel.querySelectorAll<HTMLDetailsElement>('.issue-chart')) {
				chart.hidden = chart.dataset.view !== issueView.value || chart.dataset.kind !== issueKind.value;
				if (!chart.hidden) chart.open = true;
			}
		}
	};
	if (issuePanels.length) {
		issuePicker.hidden = false;
		for (const control of [issueTopic, issueKind, issueView]) control.addEventListener('change', updateIssue);
		updateIssue();
		document.querySelector('[data-show-timeline]')?.addEventListener('click', () => {
			issueKind.value = 'time';
			updateIssue();
		});
	}
	const filter = document.querySelector<HTMLElement>('#topic-filter')!;
	const input = document.querySelector<HTMLInputElement>('#topic-query')!;
	const results = document.querySelector<HTMLElement>('#topic-results')!;
	const topics = [...document.querySelectorAll<HTMLDetailsElement>('#topic-list > .topic')];
	filter.hidden = false;
	const update = () => {
		const query = input.value.trim().toLocaleLowerCase();
		let count = 0;
		for (const topic of topics) {
			topic.hidden = !topic.textContent?.toLocaleLowerCase().includes(query);
			if (!topic.hidden) count += 1;
		}
		results.textContent = `${count} of ${topics.length} topics shown. Search covers representative packets only.`;
	};
	input.addEventListener('input', update);
	const revealAnchor = () => {
		const issue = issuePanels.find((entry) => `#${entry.id}` === window.location.hash);
		if (issue) {
			issueTopic.value = issue.dataset.topic!;
			updateIssue();
			requestAnimationFrame(() => issue.scrollIntoView());
		}
		const topic = topics.find((entry) => `#${entry.id}` === window.location.hash);
		if (topic) {
			input.value = '';
			update();
			topic.open = true;
		}
	};
	window.addEventListener('hashchange', revealAnchor);
	update();
	revealAnchor();
</script>

<style>
	.platform-page { width: var(--page); margin: 0 auto; padding-bottom: 4rem; overflow-wrap: anywhere; }
	.page-heading { max-width: 900px; padding-top: 2rem; }
	.page-heading h1 { font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1.1; margin: 0.6rem 0 1.2rem; }
	.page-heading .scope { font-size: 0.88rem; }
	.intro { font-size: 1.25rem; }
	.scope, .coverage, .label-origin, .locator, .revision { color: var(--muted); font-size: 0.88rem; }
	.section-nav { display: flex; flex-wrap: wrap; gap: 0.7rem 1.5rem; padding: 1rem 0; border-block: 1px solid var(--rule); font-family: var(--sans); }
	.qualification { max-width: 900px; margin-block: 1.6rem 2.5rem; }
	section { padding-top: 1.5rem; margin-top: 1.5rem; border-top: 1px solid var(--rule); scroll-margin-top: 1rem; }
	section > p { max-width: 900px; }
	h2 { font-size: 2rem; line-height: 1.2; }
	h3 { font-size: 1.15rem; }
	.party-summaries { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
	.party-summaries ol { padding-left: 1.4rem; font-size: 0.95rem; }
	.party-summaries li { margin-bottom: 0.7rem; }
	.topic-percent { color: var(--muted); white-space: nowrap; margin-left: 0.5rem; }
	details { margin: 1rem 0; }
	summary { cursor: pointer; font-family: var(--sans); font-weight: 600; }
	details[open] > summary { margin-bottom: 1rem; }
	.topic { border-top: 1px solid var(--rule); padding: 1rem 0; margin: 0; scroll-margin-top: 1rem; }
	.topic > summary { font-size: 1.15rem; }
	.topic > p { max-width: 900px; }
	.caveat { color: var(--muted); }
	.claim { max-width: 900px; padding-block: 0.8rem; border-top: 1px solid var(--rule); }
	.claim-source { font-size: 0.9rem; margin-bottom: 0.4rem; }
	.claim > p { margin-top: 0.4rem; }
	.claim details { font-size: 0.9rem; }
	blockquote { margin-inline: 0; padding-left: 1rem; border-left: 2px solid var(--rule); }
	.table-wrap { margin-block: 1.5rem; }
	table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
	th, td { padding: 0.6rem; text-align: left; border-bottom: 1px solid var(--rule); }
	caption { text-align: left; color: var(--muted); margin-bottom: 0.5rem; }
	#topic-filter { margin-block: 1.5rem; max-width: 720px; }
	#topic-filter label { display: block; font-family: var(--sans); }
	input { width: 100%; background: var(--paper); color: var(--ink); border: 1px solid var(--rule); padding: 0.7rem; margin-top: 0.5rem; border-radius: 0; }
	#topic-results { color: var(--muted); font-size: 0.85rem; }
