---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import PlatformFigure from '../components/PlatformFigure.astro';
import DensityExplorer from '../components/DensityExplorer.astro';
import { platforms as data, organizations, platformFigure, timelineShares } from '../lib/platform-analysis';
import { partyPositionSummary } from '../lib/platform-position-copy.mjs';

const number = (value: number) => value.toLocaleString('en-US');
const share = (topic: typeof data.topics[number], group: string) =>
	topic.shares.find(row => row.view === 'expanded' && row.group === group);
const percent = (topic: typeof data.topics[number], group: string) => {
	const row = share(topic, group);
	return row?.available === 'True' ? `${(100 * Number(row.share)).toFixed(1)}%` : 'Not observed';
};
const evidence = (id: string) => `/party-platforms/sources/#${id}`;
const overviewViews = [
	{ id: 'topic_distribution', title: 'Share of attention',
		summary: 'See how each organization divides its attention among the same subjects. The bars use equal document or fallback-bundle weights, not raw claim counts.' },
];
const shortNames: Record<string, string> = { democratic: 'Democratic', republican: 'Republican', dsa: 'DSA' };
const colors: Record<string, string> = { democratic: '#3d7699', republican: '#c65a3b', dsa: '#c39a36' };
const overviewTopics = [...data.topics].sort((a, b) =>
	organizations.reduce((sum, group) => sum + Number(share(b, group.id)?.share) -
		Number(share(a, group.id)?.share), 0));
const groupPosition = (topic: string, group: string) => {
	const summary = data.positions.find(position => position.topic_id === topic)?.groups[group]?.summary;
	if (!summary) throw new Error(`Missing reviewed group position: ${topic}/${group}`);
	return partyPositionSummary(group, summary);
};
const topicTimeline = (topic: string) => {
	const rows = timelineShares.filter(row => row.topic === topic);
	return [...new Set(rows.map(row => row.start))].sort((a, b) => a - b).map(start => {
		const period = rows.filter(row => row.start === start);
		const first = period[0];
		if (period.length !== organizations.length) throw new Error(`Incomplete timeline: ${topic}/${start}`);
		return {
			label: `${start}\u2013${String(first.partial ? 2026 : first.end).slice(2)}${first.partial ? '*' : ''}`,
			values: organizations.map(group => period.find(row => row.group === group.id)!.value),
		};
	});
};
const mobileColumns = (kind: string) => kind === 'pairwise_emphasis' ? [
	{ group: 'democratic', baseline: ['republican'] },
	{ group: 'democratic', baseline: ['dsa'] },
	{ group: 'republican', baseline: ['dsa'] },
] : organizations.map(group => ({
	group: group.id,
	baseline: kind === 'topic_distribution' ? []
		: organizations.filter(other => other.id !== group.id).map(other => other.id),
}));
const mobileValue = (topic: typeof data.topics[number], column: ReturnType<typeof mobileColumns>[number], view = 'expanded') => {
	const value = (group: string) => Number(topic.shares.find(row => row.view === view && row.group === group)?.share);
	return value(column.group) - (column.baseline.length
		? column.baseline.reduce((sum, group) => sum + value(group), 0) / column.baseline.length : 0);
};
const mobileBounds = Object.fromEntries(overviewViews.map(view => {
	const maximum = Math.max(...data.topics.flatMap(topic => ['expanded', 'strict'].flatMap(source =>
		mobileColumns(view.id).map(column => Math.abs(mobileValue(topic, column, source))))));
	return [view.id, view.id === 'topic_distribution' ? Math.max(0.05, Math.ceil(maximum * 20) / 20)
		: Math.max(0.01, Math.ceil(maximum * 100) / 100)];
}));
const densityPairs = [
	{ id: 'democratic_vs_republican', title: 'Democratic and Republican' },
	{ id: 'democratic_vs_dsa', title: 'Democratic and DSA' },
	{ id: 'republican_vs_dsa', title: 'Republican and DSA' },
];
const partyOverviews = [
	{ id: 'democratic', summary: "The Democratic Party's largest subjects include support for vulnerable communities, international cooperation, and energy and infrastructure investment. Presidential records and partisan critiques also feature prominently: attention is not simply a list of policy promises.",
		topic: 'topic-002', claim: 'democratic-2024-normalized-51d7cbe64123-005' },
	{ id: 'republican', summary: "The Republican Party's platforms repeatedly address governing authority, national leadership, and support for communities. Rights and freedom are distinctive themes, mixing concrete proposals with statements about legitimate government.",
		topic: 'topic-005', claim: 'republican-2008-normalized-92a9f5c7906a-006' },
	{ id: 'dsa', summary: "DSA's largest subjects include critiques of capitalism, democratic representation, and material insecurity. Labor organizing and the Israeli-Palestinian conflict also receive more relative attention than in the other organizations.",
		topic: 'topic-020', claim: 'dsa-2003-mission-normalized-20f699d8e4de-002' },
].map(overview => {
	const topic = data.topics.find(topic => topic.topic_id === overview.topic)!;
	const example = topic.representatives.find(claim => claim.claim_id === overview.claim);
	if (!example) throw new Error(`Missing party overview evidence: ${overview.claim}`);
	return { ...overview, example };
});
---

<PlatformLayout title="Party Priorities and Positions" active="issues"
	description="Compare national party documents through subject charts and language maps.">
	<nav class="section-links" aria-label="Explore the analysis">
		<a href="#overview">Compare issues</a>
		<a href="#organization-patterns">Overall patterns by organization</a>
		<a href="#density">Language maps</a>
	</nav>

	<section id="overview" class="reader-section" aria-labelledby="overview-title">
		<h2 id="overview-title">Compare the issues</h2>
		<div class="overview-toolbar">
		<details id="overview-subject-index" class="subject-index">
			<summary>Choose an issue</summary>
			<ul>{overviewTopics.map(topic => (
				<li><a href={`#issue-${topic.topic_id}`} data-overview-subject={topic.topic_id}>{topic.title}</a></li>
			))}</ul>
		</details>
		<div id="overview-picker" hidden>
			<div id="overview-subject-controls">
				<nav class="overview-pages" aria-label="Browse issues">
					<button type="button" id="overview-subject-previous" data-overview-step="-1" aria-label="Previous issue" disabled>Previous</button>
					<span id="overview-subject-range" class="subject-count" role="status" aria-live="polite">1 of {data.topics.length}</span>
					<button type="button" id="overview-subject-next" data-overview-step="1" aria-label="Next issue">Next</button>
				</nav>
			</div>
		</div>
		</div>
		{overviewViews.map(view => [1, 2, 3].map(page => (
			<details class="overview-chart" data-kind={view.id} data-page={page}
				open={view.id === 'topic_distribution' && page === 1}>
				<summary>{view.title}: page {page}</summary>
				<div class:list={['mobile-overview', { 'position-overview': view.id === 'topic_distribution' }]}
					aria-label={`${view.title}, page ${page}`}>
					{overviewTopics.slice((page - 1) * 8, page * 8).map(topic => (
						<div class="mobile-topic" data-topic={topic.topic_id}
							id={view.id === 'topic_distribution' ? `issue-${topic.topic_id}` : undefined}>
							<h3 tabindex="-1">{topic.title}</h3>
							<div class:list={['issue-comparison', { 'with-history': view.id === 'topic_distribution' }]}>
							<div data-issue-positions={view.id === 'topic_distribution' ? '' : undefined}>
							{mobileColumns(view.id).map(column => {
								const value = mobileValue(topic, column);
								const difference = view.id !== 'topic_distribution';
								const proportion = Math.abs(value) / mobileBounds[view.id];
								const label = `${shortNames[column.group]}${column.baseline.length
									? ` minus ${column.baseline.length === 2 ? 'others' : shortNames[column.baseline[0]]}` : ''}`;
								return <div class="mobile-value" data-group={column.group}
									data-baseline={column.baseline.join(',')} data-value={value}>
									<span class="mobile-party">{label}</span>
									<span class:list={['mobile-track', { difference }]} aria-hidden={difference ? 'true' : undefined}>
										<span class="mobile-fill" style={`background:${value < 0 ? column.baseline.length === 2 ? '#77736d' : colors[column.baseline[0]] : colors[column.group]};width:${proportion * (difference ? 50 : 100)}%;left:${difference ? value < 0 ? 50 - proportion * 50 : 50 : 0}%`}></span>
										{!difference && <span class="mobile-number" style={`left:${proportion * 100}%;color:${colors[column.group]}`}>{(100 * value).toFixed(1)}%</span>}
									</span>
									{difference
										? <span class="mobile-number">{value > 0 ? '+' : ''}{(100 * value).toFixed(1)} pp</span>
										: <p class="group-position">{groupPosition(topic.topic_id, column.group)}</p>}
								</div>;
							})}
							</div>
							{view.id === 'topic_distribution' && <figure class="issue-timeline"
								data-png={`/party-platforms/${platformFigure('expanded/issues', `${topic.topic_id}_time`).path}?source=${data.source_revision}`}>
								<figcaption>Over time</figcaption>
								<canvas class="issue-time-chart" data-timeline={JSON.stringify(topicTimeline(topic.topic_id))}
									role="img" aria-label={`Document-weighted share of attention over time: ${topic.title}. Exact values are available below.`}></canvas>
								<p class="timeline-caption">Weighted attention &middot; gaps mean no documents &middot; *partial period</p>
								<details class="timeline-values">
									<summary>Period values and source qualifications</summary>
									<div class="table-wrap"><table>
										<caption>{topic.title}: share of attention in observed periods</caption>
										<thead><tr><th>Period</th>{organizations.map(group => <th>{shortNames[group.id]}</th>)}</tr></thead>
										<tbody>{topicTimeline(topic.topic_id).map(period => <tr>
											<th scope="row">{period.label}</th>{period.values.map(value =>
												<td>{value === null ? 'Not observed' : `${(100 * value).toFixed(1)}%`}</td>)}
										</tr>)}</tbody>
									</table></div>
									<p>{topic.caveat}</p>
								</details>
								<noscript><PlatformFigure figure={platformFigure('expanded/issues', `${topic.topic_id}_time`)}
									caption="Share of attention in observed four-year periods. Missing periods remain gaps." /></noscript>
							</figure>}
							</div>
						</div>
					))}
				</div>
				<div class="wide-chart" tabindex="0" role="region" aria-label={`${view.title}, page ${page}`}>
					<PlatformFigure figure={platformFigure('expanded', `${view.id}${page === 1 ? '' : `_${page}`}`)}
						caption={`${view.title}, page ${page} of 3. All organizations use the same subjects and chart scales.`} />
				</div>
				<div class="comparison-footer">
					<details class="comparison-notes">
						<summary>About this comparison</summary>
						<p class="view-summary">{view.summary}</p>
						{view.id === 'topic_distribution' && <>
							<p class="timeline-methods">Timelines use the same subjects across seven four-year periods.
								Missing periods remain gaps. The final period is partial through October 26, 2026.
								Reused platforms are not new observations, and DSA fallback documents are not
								a continuous series of adopted platforms. Each document or predefined DSA period
								bundle receives equal weight within its organization.</p>
							<p class="caveat">Overall bars use the same scale across subjects; each timeline shares one scale across groups.
								Summaries describe sampled documents
								across years, not every member's views or a current consensus.</p>
						</>}
						{view.id !== 'topic_distribution' && <p class="caveat">pp = percentage points.
							The same scale is used across subjects; full charts retain sensitivity markers.</p>}
					</details>
					<div class="comparison-links">
						{view.id === 'topic_distribution' && <a data-overview-evidence
							href={evidence(overviewTopics[(page - 1) * 8].topic_id)}>Read source evidence</a>}
						{view.id === 'topic_distribution' && <a data-overview-timeline-download
							href={`/party-platforms/${platformFigure('expanded/issues', `${overviewTopics[(page - 1) * 8].topic_id}_time`).path}?source=${data.source_revision}`}>Timeline PNG</a>}
						<a data-overview-download
							data-share-chart={`/party-platforms/${platformFigure('expanded', `${view.id}${page === 1 ? '' : `_${page}`}`).path}?source=${data.source_revision}`}
							href={`/party-platforms/${platformFigure('expanded', `${view.id}${page === 1 ? '' : `_${page}`}`).path}?source=${data.source_revision}`}>
							Overall PNG
						</a>
					</div>
				</div>
			</details>
		)))}
		<section id="organization-patterns" class="party-overview" aria-labelledby="organization-patterns-title">
		<h2 id="organization-patterns-title">Overall patterns by organization</h2>
		<div class="party-summaries">
			{organizations.map(group => {
				const overview = partyOverviews.find(overview => overview.id === group.id)!;
				return <article class="party-summary" data-party={group.id}>
					<h3>{group.name}</h3>
					<p>{overview.summary}</p>
					<p class="summary-label">Largest subjects</p>
					<ol>
						{[...data.topics].sort((a, b) =>
							Number(share(b, group.id)?.share) - Number(share(a, group.id)?.share)
						).slice(0, 3).map(topic => (
							<li><a href={`#issue-${topic.topic_id}`} data-overall-issue={topic.topic_id}>{topic.title}</a>
								<span class="topic-percent">{percent(topic, group.id)}</span></li>
						))}
					</ol>
					<p class="summary-label">A stated position</p>
					<blockquote><p>{overview.example.claim_text}</p></blockquote>
					<p class="claim-source"><a href={overview.example.source_url}>{overview.example.title}</a>
						{' '}&middot; <a href={evidence(overview.topic)}>Read the source evidence</a></p>
					<p class="coverage">{data.summary.documents_by_group[group.id]} documents &middot;
						{number(data.summary.claims_by_group[group.id])} analyzed claims</p>
				</article>;
			})}
		</div>
		<p class="qualification">These are summaries of observed documents across 2000&ndash;2026,
			not exhaustive descriptions of current beliefs. DSA coverage includes national
			resolutions and statements alongside platforms/programs; periods and genres differ.</p>
		</section>
	</section>

	<section id="density" class="reader-section" aria-labelledby="density-title">
		<h2 id="density-title">Where the language differs</h2>
		<p>These maps compare the concentration of each organization's language in a shared
			semantic space. Explore the issues and source statements behind the points.
			Similar language does not imply the same policy position.</p>
		<div id="density-picker" class="issue-picker" hidden>
			<label>Organizations
				<select id="density-pair">{densityPairs.map(pair =>
					<option value={pair.id} selected={pair.id === 'democratic_vs_dsa'}>{pair.title}</option>)}</select>
			</label>
		</div>
		<DensityExplorer />
	</section>

</PlatformLayout>

<script>
	const drawTimeline = (canvas: HTMLCanvasElement) => {
		const width = canvas.getBoundingClientRect().width;
		if (!width) return;
		const height = 320;
		const ratio = window.devicePixelRatio || 1;
		canvas.width = Math.round(width * ratio);
		canvas.height = height * ratio;
		const context = canvas.getContext('2d')!;
		context.scale(ratio, ratio);
		const periods: { label: string; values: (number | null)[] }[] = JSON.parse(canvas.dataset.timeline!);
		const names = ['Democratic', 'Republican', 'DSA'];
		const colors = ['#3d7699', '#c65a3b', '#c39a36'];
		const style = getComputedStyle(canvas);
		const maximum = Math.max(0.01, ...periods.flatMap(period => period.values.filter(value => value !== null) as number[]));
		const tick = [0.005, 0.01, 0.02, 0.025, 0.05, 0.1, 0.2, 0.25].find(value => value >= maximum / 4) ?? 0.25;
		const upper = Math.ceil(maximum / tick) * tick;
		const left = 40, right = width - 116, top = 24, bottom = height - 46;
		const x = (index: number) => left + (right - left) * index / (periods.length - 1);
		const y = (value: number) => bottom - (bottom - top) * value / upper;
		context.font = `12px ${style.fontFamily}`;
		context.textBaseline = 'middle';
		context.textAlign = 'right';
		for (let value = 0; value <= upper + tick / 2; value += tick) {
			context.fillStyle = style.getPropertyValue('--muted');
			context.fillText(`${+(100 * value).toFixed(1)}%`, left - 8, y(value));
			context.strokeStyle = style.getPropertyValue('--rule');
			context.globalAlpha = value === 0 ? 0.8 : 0.45;
			context.lineWidth = value === 0 ? 0.8 : 0.6;
			context.beginPath();
			context.moveTo(left, y(value));
			context.lineTo(right, y(value));
			context.stroke();
			context.globalAlpha = 1;
		}
		context.textAlign = 'center';
		periods.forEach((period, index) => {
			if (width < 400 && index % 2 !== 0) return;
			context.fillText(width < 400 ? period.label.slice(2) : period.label, x(index), bottom + 22);
		});
		const labels: { group: number; index: number; value: number; target: number; labelY: number }[] = [];
		for (let group = 0; group < names.length; group++) {
			context.strokeStyle = colors[group];
			context.fillStyle = colors[group];
			context.lineWidth = 2;
			context.lineCap = 'round';
			context.lineJoin = 'round';
			context.beginPath();
			let connected = false;
			const last = periods.findLastIndex(period => period.values[group] !== null);
			periods.forEach((period, index) => {
				const value = period.values[group];
				if (value === null) { connected = false; return; }
				if (connected) context.lineTo(x(index), y(value));
				else context.moveTo(x(index), y(value));
				connected = true;
			});
			context.stroke();
			periods.forEach((period, index) => {
				const value = period.values[group];
				if (value === null) return;
				context.beginPath();
				if (group === 0) context.arc(x(index), y(value), 3, 0, 2 * Math.PI);
				else if (group === 1) context.rect(x(index) - 2.7, y(value) - 2.7, 5.4, 5.4);
				else {
					context.moveTo(x(index), y(value) - 3.5);
					context.lineTo(x(index) + 3.5, y(value));
					context.lineTo(x(index), y(value) + 3.5);
					context.lineTo(x(index) - 3.5, y(value));
					context.closePath();
				}
				context.fillStyle = index === last ? colors[group] : style.getPropertyValue('--paper');
				context.fill();
				context.lineWidth = 1.4;
				context.stroke();
			});
			const index = periods.findLastIndex(period => period.values[group] !== null);
			if (index !== -1) {
				const value = periods[index].values[group]!;
				labels.push({ group, index, value, target: y(value), labelY: y(value) });
			}
		}
		labels.sort((a, b) => a.target - b.target);
		for (let index = 1; index < labels.length; index++) labels[index].labelY = Math.max(labels[index].target, labels[index - 1].labelY + 38);
		if (labels.length) {
			labels[labels.length - 1].labelY = Math.min(bottom - 10, labels[labels.length - 1].labelY);
			for (let index = labels.length - 2; index >= 0; index--) labels[index].labelY = Math.min(labels[index].labelY, labels[index + 1].labelY - 38);
		}
		context.textAlign = 'left';
		for (const label of labels) {
			context.strokeStyle = style.getPropertyValue('--rule');
			context.lineWidth = 0.8;
			context.setLineDash(label.index < periods.length - 1 ? [2, 3] : []);
			context.beginPath();
			context.moveTo(x(label.index) + 5, label.target);
			context.lineTo(right + 10, label.labelY);
			context.stroke();
			context.setLineDash([]);
			context.fillStyle = style.getPropertyValue('--ink');
			context.font = `500 13px ${style.fontFamily}`;
			context.fillText(names[label.group], right + 14, label.labelY - 8);
			context.font = `12px ${style.fontFamily}`;
			context.fillStyle = colors[label.group];
			context.fillText(`${(100 * label.value).toFixed(1)}%${label.index < periods.length - 1 ? ` (${periods[label.index].label.slice(2)})` : ''}`, right + 14, label.labelY + 7);
		}
	};
	const timelineObserver = new ResizeObserver(entries => {
		for (const entry of entries) drawTimeline(entry.target as HTMLCanvasElement);
	});
	for (const canvas of document.querySelectorAll<HTMLCanvasElement>('.issue-time-chart')) timelineObserver.observe(canvas);
	document.fonts.ready.then(() => {
		for (const canvas of document.querySelectorAll<HTMLCanvasElement>('.issue-time-chart')) drawTimeline(canvas);
	});
	const subjectIndex = document.querySelector<HTMLDetailsElement>('#overview-subject-index')!;
	const overviewSubjects = [...subjectIndex.querySelectorAll<HTMLAnchorElement>('[data-overview-subject]')];
	const subjectSteps = [...document.querySelectorAll<HTMLButtonElement>('[data-overview-step]')];
	const subjectRange = document.querySelector<HTMLElement>('#overview-subject-range')!;
	let overviewSubject = 0;
	const updateComparisons = () => {
		const page = Math.floor(overviewSubject / 8) + 1;
		for (const chart of document.querySelectorAll<HTMLDetailsElement>('.overview-chart')) {
			chart.hidden = chart.dataset.page !== String(page);
			if (!chart.hidden) chart.open = true;
		}
		for (const topic of document.querySelectorAll<HTMLElement>('.position-overview .mobile-topic')) {
			topic.hidden = topic.dataset.topic !== overviewSubjects[overviewSubject].dataset.overviewSubject;
		}
		for (const chart of document.querySelectorAll<HTMLElement>('.overview-chart[data-kind="topic_distribution"]')) {
			const topic = chart.querySelector<HTMLElement>(`[data-topic="${overviewSubjects[overviewSubject].dataset.overviewSubject}"]`);
			if (topic) {
				chart.querySelector<HTMLAnchorElement>('[data-overview-evidence]')!.href =
					`/party-platforms/sources/#${topic.dataset.topic}`;
				const timelineDownload = chart.querySelector<HTMLAnchorElement>('[data-overview-timeline-download]')!;
				timelineDownload.href = topic.querySelector<HTMLElement>('.issue-timeline')!.dataset.png!;
			}
		}
		for (const [index, link] of overviewSubjects.entries()) {
			if (index === overviewSubject) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
		for (const button of subjectSteps) {
			button.disabled = Number(button.dataset.overviewStep) < 0
				? overviewSubject === 0 : overviewSubject === overviewSubjects.length - 1;
		}
		subjectRange.textContent = `${overviewSubject + 1} of ${overviewSubjects.length}`;
	};
	for (const button of subjectSteps) {
		button.addEventListener('click', () => {
			overviewSubject = Math.max(0, Math.min(overviewSubjects.length - 1, overviewSubject + Number(button.dataset.overviewStep)));
			updateComparisons();
		});
	}
	for (const [index, link] of overviewSubjects.entries()) {
		link.addEventListener('click', event => {
			event.preventDefault();
			overviewSubject = index;
			subjectIndex.open = false;
			updateComparisons();
			document.querySelector<HTMLElement>('.overview-chart:not([hidden]) .mobile-topic:not([hidden]) h3')?.focus();
		});
	}
	document.addEventListener('click', event => {
		if (event.target instanceof Node && !subjectIndex.contains(event.target)) subjectIndex.open = false;
	});
	subjectIndex.addEventListener('keydown', event => {
		if (event.key === 'Escape') {
			subjectIndex.open = false;
			subjectIndex.querySelector<HTMLElement>('summary')!.focus();
		}
	});
	document.querySelector<HTMLElement>('#overview-picker')!.hidden = false;
	document.querySelector<HTMLElement>('#density-picker')!.hidden = false;
	updateComparisons();
	const reveal = () => {
		const hash = window.location.hash;
		const index = overviewSubjects.findIndex(link => `#issue-${link.dataset.overviewSubject}` === hash);
		if (index !== -1) {
			overviewSubject = index;
			updateComparisons();
			requestAnimationFrame(() => document.querySelector<HTMLElement>(hash)?.scrollIntoView({ behavior: 'instant' }));
			return;
		}
		const oldTopic = overviewSubjects.find(link => `#${link.dataset.overviewSubject}` === hash);
		if (oldTopic || hash === '#topics') {
			window.location.replace(`/party-platforms/sources/${hash}`);
		} else if (['#methods', '#downloads', '#sensitivity'].includes(hash) || hash.startsWith('#period-')) {
			window.location.replace(document.querySelector<HTMLAnchorElement>('#platform-repository')!.href);
		} else if (hash === '#time') {
			updateComparisons();
		} else if (hash === '#issues') {
			document.querySelector<HTMLElement>('#overview')!.scrollIntoView();
		}
	};
	for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-overall-issue]')) {
		link.addEventListener('click', () => {
			overviewSubject = overviewSubjects.findIndex(subject => subject.dataset.overviewSubject === link.dataset.overallIssue);
			updateComparisons();
		});
	}
	window.addEventListener('hashchange', reveal);
	reveal();
</script>
