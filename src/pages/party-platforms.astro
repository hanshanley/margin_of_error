---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import PlatformFigure from '../components/PlatformFigure.astro';
import DensityExplorer from '../components/DensityExplorer.astro';
import { platforms as data, organizations, platformFigure, initialIssue } from '../lib/platform-analysis';

const number = (value: number) => value.toLocaleString('en-US');
const share = (topic: typeof data.topics[number], group: string) =>
	topic.shares.find(row => row.view === 'expanded' && row.group === group);
const percent = (topic: typeof data.topics[number], group: string) => {
	const row = share(topic, group);
	return row?.available === 'True' ? `${(100 * Number(row.share)).toFixed(1)}%` : 'Not observed';
};
const evidence = (id: string) => `/party-platforms/sources/#${id}`;
const overviewViews = [
	{ id: 'topic_distribution', title: 'Share of attention',
		summary: 'See how each organization divides its attention among the same subjects. The bars use equal document or fallback-bundle weights, not raw claim counts.' },
	{ id: 'vs_rest_emphasis', title: 'Distinctive emphasis',
		summary: 'Compare each organization with the equally weighted average of the other two. Positive percentage-point differences indicate greater attention; they do not measure agreement or ideological distance.' },
	{ id: 'pairwise_emphasis', title: 'Party-to-party differences',
		summary: 'Compare subject emphasis for each pair of organizations. Percentage-point differences describe attention to a subject, not whether the organizations take the same position.' },
];
const shortNames: Record<string, string> = { democratic: 'Democratic', republican: 'Republican', dsa: 'DSA' };
const colors: Record<string, string> = { democratic: '#3d7699', republican: '#c65a3b', dsa: '#c39a36' };
const overviewTopics = [...data.topics].sort((a, b) =>
	organizations.reduce((sum, group) => sum + Number(share(b, group.id)?.share) -
		Number(share(a, group.id)?.share), 0));
const groupPosition = (topic: string, group: string) => {
	const summary = data.positions.find(position => position.topic_id === topic)?.groups[group]?.summary;
	if (!summary) throw new Error(`Missing reviewed group position: ${topic}/${group}`);
	return summary;
};
const mobileColumns = (kind: string) => kind === 'pairwise_emphasis' ? [
	{ group: 'democratic', baseline: ['republican'] },
	{ group: 'democratic', baseline: ['dsa'] },
	{ group: 'republican', baseline: ['dsa'] },
] : organizations.map(group => ({
	group: group.id,
	baseline: kind === 'topic_distribution' ? []
		: organizations.filter(other => other.id !== group.id).map(other => other.id),
}));
const mobileValue = (topic: typeof data.topics[number], column: ReturnType<typeof mobileColumns>[number], view = 'expanded') => {
	const value = (group: string) => Number(topic.shares.find(row => row.view === view && row.group === group)?.share);
	return value(column.group) - (column.baseline.length
		? column.baseline.reduce((sum, group) => sum + value(group), 0) / column.baseline.length : 0);
};
const mobileBounds = Object.fromEntries(overviewViews.map(view => {
	const maximum = Math.max(...data.topics.flatMap(topic => ['expanded', 'strict'].flatMap(source =>
		mobileColumns(view.id).map(column => Math.abs(mobileValue(topic, column, source))))));
	return [view.id, view.id === 'topic_distribution' ? Math.max(0.05, Math.ceil(maximum * 20) / 20)
		: Math.max(0.01, Math.ceil(maximum * 100) / 100)];
}));
const densityPairs = [
	{ id: 'democratic_vs_republican', title: 'Democratic and Republican' },
	{ id: 'democratic_vs_dsa', title: 'Democratic and DSA' },
	{ id: 'republican_vs_dsa', title: 'Republican and DSA' },
];
const partyOverviews = [
	{ id: 'democratic', summary: 'Support for vulnerable communities, international cooperation, and energy and infrastructure investment lead the largest subjects. Presidential records and partisan critiques also feature prominently: attention is not simply a list of policy promises.',
		topic: 'topic-002', claim: 'democratic-2024-normalized-51d7cbe64123-005' },
	{ id: 'republican', summary: 'Governing authority, national leadership, and support for communities recur throughout these platforms. Rights and freedom are distinctive themes, mixing concrete proposals with statements about legitimate government.',
		topic: 'topic-005', claim: 'republican-2008-normalized-92a9f5c7906a-006' },
	{ id: 'dsa', summary: 'Critiques of capitalism, democratic representation, and material insecurity lead its largest subjects. Labor organizing and the Israeli-Palestinian conflict also receive more relative attention than in the other organizations.',
		topic: 'topic-020', claim: 'dsa-2003-mission-normalized-20f699d8e4de-002' },
].map(overview => {
	const topic = data.topics.find(topic => topic.topic_id === overview.topic)!;
	const example = topic.representatives.find(claim => claim.claim_id === overview.claim);
	if (!example) throw new Error(`Missing party overview evidence: ${overview.claim}`);
	return { ...overview, example };
});
---

<PlatformLayout title="National party platforms" active="issues"
	description="Compare national party documents through subject charts and language maps.">
	<nav class="section-links" aria-label="Explore the analysis">
		<a href="#overview">The big picture</a>
		<a href="#density">Language maps</a>
		<a href="#issues">Explore a subject</a>
	</nav>

	<section id="overview" class="reader-section" aria-labelledby="overview-title">
		<h2 id="overview-title">The big picture</h2>
		<div id="overview-picker" class="issue-picker" hidden>
			<label>View
				<select id="overview-kind">{overviewViews.map(view =>
					<option value={view.id}>{view.title}</option>)}</select>
			</label>
			<div>
			<div id="overview-subject-controls">
				<span class="pagination-label">Issue</span>
				<nav class="overview-pages" aria-label="Browse issues">
					<button type="button" id="overview-subject-previous" data-overview-step="-1" disabled>Previous issue</button>
					<span id="overview-subject-range" class="subject-count" role="status" aria-live="polite">1 of {data.topics.length}</span>
					<button type="button" id="overview-subject-next" data-overview-step="1">Next issue</button>
				</nav>
			</div>
			<div id="overview-pagination" class="overview-pagination" hidden>
				<span class="pagination-label">Subjects</span>
				<nav class="overview-pages" aria-label="Browse subject pages">
					<button type="button" id="overview-previous" disabled>Previous</button>
					{[1, 2, 3].map(page => (
						<button type="button" data-overview-page={page}
							aria-label={`Subjects ${(page - 1) * 8 + 1}–${Math.min(page * 8, data.topics.length)}`}
							aria-current={page === 1 ? 'page' : undefined}>
							{(page - 1) * 8 + 1}–{Math.min(page * 8, data.topics.length)}
						</button>
					))}
					<button type="button" id="overview-next">Next</button>
				</nav>
				<p id="overview-range" class="overview-range" role="status" aria-live="polite"
					data-total={data.topics.length}>Subjects 1–8 of {data.topics.length}</p>
			</div>
			</div>
		</div>
		<details id="overview-subject-index" class="subject-index">
			<summary>Browse all {data.topics.length} subjects by name</summary>
			<ul>{overviewTopics.map(topic => (
				<li><a href={`#issue-${topic.topic_id}`} data-overview-subject={topic.topic_id}>{topic.title}</a></li>
			))}</ul>
		</details>
		{overviewViews.map(view => [1, 2, 3].map(page => (
			<details class="overview-chart" data-kind={view.id} data-page={page}
				open={view.id === 'topic_distribution' && page === 1}>
				<summary>{view.title}: page {page}</summary>
				<p class="view-summary">{view.summary}</p>
				<div class:list={['mobile-overview', { 'position-overview': view.id === 'topic_distribution' }]}
					aria-label={`${view.title}, page ${page}`}>
					{overviewTopics.slice((page - 1) * 8, page * 8).map(topic => (
						<div class="mobile-topic" data-topic={topic.topic_id}>
							<h3><a href={`#issue-${topic.topic_id}`} data-overall-issue={topic.topic_id}>{topic.title}</a></h3>
							{mobileColumns(view.id).map(column => {
								const value = mobileValue(topic, column);
								const difference = view.id !== 'topic_distribution';
								const proportion = Math.abs(value) / mobileBounds[view.id];
								const label = `${shortNames[column.group]}${column.baseline.length
									? ` minus ${column.baseline.length === 2 ? 'others' : shortNames[column.baseline[0]]}` : ''}`;
								return <div class="mobile-value" data-group={column.group}
									data-baseline={column.baseline.join(',')} data-value={value}>
									<span class="mobile-party">{label}</span>
									<span class:list={['mobile-track', { difference }]} aria-hidden={difference ? 'true' : undefined}>
										<span class="mobile-fill" style={`background:${value < 0 ? column.baseline.length === 2 ? '#77736d' : colors[column.baseline[0]] : colors[column.group]};width:${proportion * (difference ? 50 : 100)}%;left:${difference ? value < 0 ? 50 - proportion * 50 : 50 : 0}%`}></span>
										{!difference && <span class="mobile-number" style={`left:${proportion * 100}%;color:${colors[column.group]}`}>{(100 * value).toFixed(1)}%</span>}
									</span>
									{difference
										? <span class="mobile-number">{value > 0 ? '+' : ''}{(100 * value).toFixed(1)} pp</span>
										: <p class="group-position">{groupPosition(topic.topic_id, column.group)}</p>}
								</div>;
							})}
						</div>
					))}
					<p class="caveat">Same scale across subjects. {view.id !== 'topic_distribution'
						? 'pp = percentage points. '
						: "Summaries describe sampled documents across years, not every member's views or a current consensus. "}
						<a href={`/party-platforms/${platformFigure('expanded', `${view.id}${page === 1 ? '' : `_${page}`}`).path}?source=${data.source_revision}`}>
							{view.id === 'topic_distribution' ? 'Full-size PNG comparison' : 'Full chart and sensitivity markers'}
						</a>.</p>
					{view.id === 'topic_distribution' && <nav class="overview-pages" data-overview-footer hidden aria-label="Continue through issues">
						<button type="button" data-overview-step="-1">Previous issue</button>
						<button type="button" data-overview-step="1">Next issue</button>
					</nav>}
				</div>
				<div class="wide-chart" tabindex="0" role="region" aria-label={`${view.title}, page ${page}`}>
					<PlatformFigure figure={platformFigure('expanded', `${view.id}${page === 1 ? '' : `_${page}`}`)}
						caption={`${view.title}, page ${page} of 3. All organizations use the same subjects and chart scales.`} />
				</div>
			</details>
		)))}
		<p class="qualification">The updated analysis shows {data.topics.length} substantive subjects.
			Three party-identity clusters are omitted from these rankings, but their claims remain
			in the denominators. Shared subjects do not necessarily mean shared positions.</p>
		<h3 class="overview-subheading">What the documents say</h3>
		<div class="party-summaries">
			{organizations.map(group => {
				const overview = partyOverviews.find(overview => overview.id === group.id)!;
				return <article class="party-summary" data-party={group.id}>
					<h3>{group.name}</h3>
					<p>{overview.summary}</p>
					<p class="summary-label">Largest subjects</p>
					<ol>
						{[...data.topics].sort((a, b) =>
							Number(share(b, group.id)?.share) - Number(share(a, group.id)?.share)
						).slice(0, 3).map(topic => (
							<li><a href={`#issue-${topic.topic_id}`} data-overall-issue={topic.topic_id}>{topic.title}</a>
								<span class="topic-percent">{percent(topic, group.id)}</span></li>
						))}
					</ol>
					<p class="summary-label">A stated position</p>
					<blockquote><p>{overview.example.claim_text}</p></blockquote>
					<p class="claim-source"><a href={overview.example.source_url}>{overview.example.title}</a>
						{' '}&middot; <a href={evidence(overview.topic)}>Read the source evidence</a></p>
					<p class="coverage">{data.summary.documents_by_group[group.id]} documents &middot;
						{number(data.summary.claims_by_group[group.id])} analyzed claims</p>
				</article>;
			})}
		</div>
		<p class="qualification">These are summaries of observed documents across 2000&ndash;2026,
			not exhaustive descriptions of current beliefs. DSA coverage includes national
			resolutions and statements alongside platforms/programs; periods and genres differ.</p>
	</section>

	<section id="density" class="reader-section" aria-labelledby="density-title">
		<h2 id="density-title">Where the language differs</h2>
		<p>These KDE maps compare the concentration of each organization's language in a shared
			semantic space. Explore the issues and source statements behind the points.
			Similar language does not imply the same policy position.</p>
		<div id="density-picker" class="issue-picker" hidden>
			<label>Organizations
				<select id="density-pair">{densityPairs.map(pair =>
					<option value={pair.id}>{pair.title}</option>)}</select>
			</label>
			<label>Original examples
				<select id="density-page"><option value="1">First set</option>
					<option value="2">Second set</option></select>
			</label>
		</div>
		<DensityExplorer />
		{densityPairs.map(pair => [1, 2].map(page => (
			<details class="density-chart" data-pair={pair.id} data-page={page}
				open={pair.id === densityPairs[0].id && page === 1}>
				<summary>{pair.title}: example set {page}</summary>
				<h3 class="chart-heading">{pair.title}</h3>
				<details class="density-original" open>
				<summary>Original annotated map and numbered source examples</summary>
				<PlatformFigure figure={platformFigure('expanded/density_details', `${pair.id}_${page}`)}
					caption={`${pair.title}: expanded language density, example set ${page}. Colors show natural-log density ratios; markers locate examples, not region boundaries.`} />
				<details class="mapped-evidence">
					<summary>Mapped claims and their sources</summary>
					<ol>{data.density_regions.filter(region => region.view === 'expanded' &&
						region.figure === `density_details/${pair.id}_${page}.png`).map(region => (
						<li value={Number(region.marker)}>
							<p>{region.example_text}</p>
							<p class="claim-source"><a href={region.source_url}>{region.example_title}</a>
								{' '}&middot; {region.example_publication_date}</p>
							<p class="locator">{region.locator} &middot; {region.passages} claims / {region.bundles} bundles.
								Example ln density ratio: {Number(region.example_log_density_ratio).toFixed(2)}.</p>
						</li>
					))}</ol>
				</details>
				</details>
			</details>
		)))}
		<p class="qualification">Density is estimated in the shared {data.summary.views.expanded.dimensions}-dimensional
			space; the two-dimensional map is a display only. Hover labels come from the
			reviewed pooled issue clusters; the original numbered examples identify local KDE regions.
			This is an exploratory comparison, not a measure of agreement.</p>
	</section>

	<section id="issues" class="reader-section" aria-labelledby="issues-title">
		<h2 id="issues-title">Explore a subject</h2>
		<p>Read the subject summary, compare attention across organizations, and follow it over time.</p>
		<div id="issue-picker" class="issue-picker" hidden>
			<div>
				<span class="pagination-label">Issue</span>
				<nav class="overview-pages" aria-label="Browse individual issue charts">
					<button type="button" id="issue-previous">Previous issue</button>
					<span id="issue-range" class="subject-count" role="status" aria-live="polite">
						{overviewTopics.findIndex(topic => topic.topic_id === initialIssue.topic_id) + 1} of {data.topics.length}
					</span>
					<button type="button" id="issue-next">Next issue</button>
				</nav>
				<select id="issue-topic" hidden aria-label="Selected issue">
					{overviewTopics.map(topic => (
						<option value={topic.topic_id} selected={topic.topic_id === initialIssue.topic_id}>{topic.title}</option>
					))}
				</select>
			</div>
			<label>Comparison
				<select id="issue-kind"><option value="overall">Overall emphasis</option>
					<option value="time">Over time</option></select>
			</label>
		</div>
		{data.topics.map(topic => (
			<details class="issue-panel" data-topic={topic.topic_id}
				id={`issue-${topic.topic_id}`} open={topic.topic_id === initialIssue.topic_id}>
				<summary>{topic.title}</summary>
				<h2 class="issue-title">{topic.title}</h2>
				<p class="subject-summary">{topic.summary}</p>
				{['overall', 'time'].map(kind => (
					<details class="issue-chart" data-view="expanded" data-kind={kind}
						open={kind === 'overall'}>
						<summary>{kind === 'overall' ? 'Overall emphasis' : 'Over time'}</summary>
						<PlatformFigure figure={platformFigure('expanded/issues', `${topic.topic_id}_${kind}`)}
							caption={kind === 'overall'
								? 'Share of document-weighted attention devoted to this subject.'
								: 'Share of attention in observed four-year periods. Missing periods remain gaps.'} />
					</details>
				))}
				<p><a href={evidence(topic.topic_id)}>Read representative claims and source excerpts &rarr;</a></p>
				<details class="chart-notes">
					<summary>Sources and how to read this chart</summary>
					<p>{topic.caveat}</p>
					<p>These charts compare attention, not agreement or ideological distance.
						Each document or predefined DSA period bundle receives equal weight within its organization.
						Claim counts do not determine an organization's weight.</p>
					<p>The analysis includes Democratic and Republican platforms, and DSA national
						platforms/programs, resolutions and statements.</p>
					<p>Timelines use the same subjects across seven four-year periods. The final period is
						partial through October 26, 2026. Reused platforms are not new observations, and
						DSA fallback documents are not a continuous series of adopted platforms.</p>
					<div class="table-wrap">
						<table>
							<caption>Overall document-weighted shares</caption>
							<thead><tr><th>Organization</th><th>Share of attention</th></tr></thead>
							<tbody>{organizations.map(group => (
								<tr><th scope="row">{group.name}</th>
									<td>{percent(topic, group.id)}</td></tr>
							))}</tbody>
						</table>
					</div>
				</details>
			</details>
		))}
		<noscript><p>Expand a subject to see its overall and over-time charts.</p></noscript>
	</section>

</PlatformLayout>

<script>
	const overviewKind = document.querySelector<HTMLSelectElement>('#overview-kind')!;
	const overviewPages = [...document.querySelectorAll<HTMLButtonElement>('[data-overview-page]')];
	const overviewPrevious = document.querySelector<HTMLButtonElement>('#overview-previous')!;
	const overviewNext = document.querySelector<HTMLButtonElement>('#overview-next')!;
	const overviewRange = document.querySelector<HTMLElement>('#overview-range')!;
	const subjectIndex = document.querySelector<HTMLDetailsElement>('#overview-subject-index')!;
	const overviewSubjects = [...subjectIndex.querySelectorAll<HTMLAnchorElement>('[data-overview-subject]')];
	const subjectSteps = [...document.querySelectorAll<HTMLButtonElement>('[data-overview-step]')];
	const subjectRange = document.querySelector<HTMLElement>('#overview-subject-range')!;
	let overviewSubject = 0;
	let overviewPage = 1;
	const densityPair = document.querySelector<HTMLSelectElement>('#density-pair')!;
	const densityPage = document.querySelector<HTMLSelectElement>('#density-page')!;
	const updateComparisons = () => {
		const positions = overviewKind.value === 'topic_distribution';
		const page = positions ? Math.floor(overviewSubject / 8) + 1 : overviewPage;
		for (const chart of document.querySelectorAll<HTMLDetailsElement>('.overview-chart')) {
			chart.hidden = chart.dataset.kind !== overviewKind.value || chart.dataset.page !== String(page);
			if (!chart.hidden) chart.open = true;
		}
		document.querySelector<HTMLElement>('#overview-subject-controls')!.hidden = !positions;
		document.querySelector<HTMLElement>('#overview-pagination')!.hidden = positions;
		for (const topic of document.querySelectorAll<HTMLElement>('.position-overview .mobile-topic')) {
			topic.hidden = topic.dataset.topic !== overviewSubjects[overviewSubject].dataset.overviewSubject;
		}
		for (const [index, link] of overviewSubjects.entries()) {
			if (index === overviewSubject) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
		for (const button of subjectSteps) {
			button.disabled = Number(button.dataset.overviewStep) < 0
				? overviewSubject === 0 : overviewSubject === overviewSubjects.length - 1;
		}
		subjectRange.textContent = `${overviewSubject + 1} of ${overviewSubjects.length}`;
		for (const button of overviewPages) {
			if (Number(button.dataset.overviewPage) === overviewPage) {
				button.setAttribute('aria-current', 'page');
				overviewRange.textContent = `${button.getAttribute('aria-label')} of ${overviewRange.dataset.total}`;
			} else {
				button.removeAttribute('aria-current');
			}
		}
		overviewPrevious.disabled = overviewPage === 1;
		overviewNext.disabled = overviewPage === overviewPages.length;
		for (const chart of document.querySelectorAll<HTMLDetailsElement>('.density-chart')) {
			chart.hidden = chart.dataset.pair !== densityPair.value || chart.dataset.page !== densityPage.value;
			if (!chart.hidden) chart.open = true;
		}
	};
	for (const control of [overviewKind, densityPair, densityPage]) {
		control.addEventListener('change', updateComparisons);
	}
	for (const button of overviewPages) {
		button.addEventListener('click', () => {
			overviewPage = Number(button.dataset.overviewPage);
			updateComparisons();
		});
	}
	overviewPrevious.addEventListener('click', () => {
		overviewPage = Math.max(1, overviewPage - 1);
		updateComparisons();
	});
	overviewNext.addEventListener('click', () => {
		overviewPage = Math.min(overviewPages.length, overviewPage + 1);
		updateComparisons();
	});
	for (const button of subjectSteps) {
		button.addEventListener('click', () => {
			overviewSubject = Math.max(0, Math.min(overviewSubjects.length - 1, overviewSubject + Number(button.dataset.overviewStep)));
			updateComparisons();
		});
	}
	for (const [index, link] of overviewSubjects.entries()) {
		link.addEventListener('click', event => {
			event.preventDefault();
			overviewSubject = index;
			overviewKind.value = 'topic_distribution';
			subjectIndex.open = false;
			updateComparisons();
			document.querySelector<HTMLElement>('.overview-chart:not([hidden]) .mobile-topic:not([hidden]) h3 a')?.focus();
		});
	}
	document.querySelector<HTMLElement>('#overview-picker')!.hidden = false;
	for (const footer of document.querySelectorAll<HTMLElement>('[data-overview-footer]')) footer.hidden = false;
	document.querySelector<HTMLElement>('#density-picker')!.hidden = false;
	if (window.matchMedia('(max-width: 700px)').matches) {
		for (const evidence of document.querySelectorAll<HTMLDetailsElement>('.mapped-evidence')) evidence.open = true;
	}
	updateComparisons();
	const picker = document.querySelector<HTMLElement>('#issue-picker')!;
	const subject = document.querySelector<HTMLSelectElement>('#issue-topic')!;
	const kind = document.querySelector<HTMLSelectElement>('#issue-kind')!;
	const panels = [...document.querySelectorAll<HTMLDetailsElement>('.issue-panel')];
	const issuePrevious = document.querySelector<HTMLButtonElement>('#issue-previous')!;
	const issueNext = document.querySelector<HTMLButtonElement>('#issue-next')!;
	const issueRange = document.querySelector<HTMLElement>('#issue-range')!;
	const update = () => {
		issuePrevious.disabled = subject.selectedIndex === 0;
		issueNext.disabled = subject.selectedIndex === subject.options.length - 1;
		issueRange.textContent = `${subject.selectedIndex + 1} of ${subject.options.length}`;
		for (const panel of panels) {
			panel.hidden = panel.dataset.topic !== subject.value;
			if (!panel.hidden) panel.open = true;
			for (const chart of panel.querySelectorAll<HTMLDetailsElement>('.issue-chart')) {
				chart.hidden = chart.dataset.kind !== kind.value;
				if (!chart.hidden) chart.open = true;
			}
		}
	};
	const reveal = () => {
		const hash = window.location.hash;
		const issue = panels.find(panel => `#${panel.id}` === hash);
		if (issue) {
			subject.value = issue.dataset.topic!;
			update();
			requestAnimationFrame(() => issue.scrollIntoView({ behavior: 'instant' }));
			return;
		}
		const oldTopic = panels.find(panel => `#${panel.dataset.topic}` === hash);
		if (oldTopic || hash === '#topics') {
			window.location.replace(`/party-platforms/sources/${hash}`);
		} else if (['#methods', '#downloads', '#sensitivity'].includes(hash) || hash.startsWith('#period-')) {
			window.location.replace(document.querySelector<HTMLAnchorElement>('#platform-repository')!.href);
		} else if (hash === '#time') {
			kind.value = 'time';
			update();
		}
	};
	picker.hidden = false;
	for (const control of [subject, kind]) control.addEventListener('change', update);
	issuePrevious.addEventListener('click', () => {
		subject.selectedIndex = Math.max(0, subject.selectedIndex - 1);
		update();
	});
	issueNext.addEventListener('click', () => {
		subject.selectedIndex = Math.min(subject.options.length - 1, subject.selectedIndex + 1);
		update();
	});
	for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-overall-issue]')) {
		link.addEventListener('click', () => {
			subject.value = link.dataset.overallIssue!;
			kind.value = 'overall';
			update();
		});
	}
	window.addEventListener('hashchange', reveal);
	update();
	reveal();
</script>
