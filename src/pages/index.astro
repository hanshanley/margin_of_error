---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalPostCard from '../components/ExternalPostCard.astro';
import PostCard from '../components/PostCard.astro';
import externalArticles from '../data/external-articles.json';
import { comparePostsNewestFirst } from '../lib/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(comparePostsNewestFirst);
const recentItems = [
	...posts.map((post) => ({ kind: 'post' as const, sortOrder: post.data.sortOrder, post })),
	...externalArticles.map((article) => ({
		kind: 'external' as const,
		sortOrder: article.sortOrder,
		article,
	})),
].sort((a, b) => b.sortOrder - a.sortOrder);
const latestItems = recentItems.slice(0, 5);
---

<BaseLayout>
	<section class="home-lede">
		<div class="home-deck">
			<h1>
				Essays on computer science, disinformation, statistics, and world events by Hans W. A.
				Hanley.
			</h1>
		</div>
	</section>

	<section class="dispatches" aria-labelledby="dispatches-title">
		<header class="section-heading">
			<p class="kicker">Recent dispatches</p>
			<h2 id="dispatches-title">From the notebook</h2>
			<p>{String(latestItems.length).padStart(2, '0')} latest pieces</p>
		</header>
		<div class="post-list">
			{
				latestItems.map((item, index) =>
					item.kind === 'post'
						? <PostCard post={item.post} index={index} />
						: <ExternalPostCard article={item.article} index={index} />
				)
			}
		</div>
	</section>
</BaseLayout>
