---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page is outside the observed range.">
	<section class="not-found">
		<p class="margin-symbol">±</p>
		<p class="kicker">Observation unavailable</p>
		<h1>Outside the sample.</h1>
		<p>The page may have moved, or the estimate was overly confident.</p>
		<a href="/">Return to the latest dispatches</a>
	</section>
</BaseLayout>
